<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BannerlordEnvironmentManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:install="using:BannerlordEnvironmentManager.Core.Install"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />
    </Page.Resources>

    <Grid Padding="20,14,20,16">
        <Grid RowSpacing="12">
            <!-- Five rows, none of them transient. Everything this page raises while it is working
                 lives in the region at the bottom of the file, outside these rows entirely, so no
                 press and no arriving download changes what any row is worth. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader TitleKey="Install.Title" BlurbKey="Install.Blurb" />

            <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="4">
                <TextBlock loc:Loc.Text="Install.GameFolderLabel" Style="{StaticResource LabelText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.GameInstallPath, Mode=OneWay}" Style="{StaticResource MonoText}"
                               MaxWidth="640" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    <Button loc:Loc.Content="Install.GameFolderChangeButton" Click="OnOpenSettings" Style="{StaticResource Quiet}"
                            loc:Loc.Tooltip="Install.GameFolderChangeButton.Tooltip" />
                </StackPanel>

                <!-- One archive can go into several versions in one press. The active version is the
                     only one ticked, so a page nobody touches installs where it always installed.
                     Collapsed when no version is registered, which leaves the folder above as the one
                     destination a plain machine install has. -->
                <StackPanel Spacing="4" Margin="0,10,0,0"
                            Visibility="{x:Bind ViewModel.HasInstallDestinations, Mode=OneWay}">
                    <TextBlock loc:Loc.Text="Install.DestinationsLabel" Style="{StaticResource LabelText}" />
                    <!-- Full width, because a Stretch element carrying a MaxWidth is centered by the
                         framework inside whatever space is left over: the cap read as a narrow box
                         adrift in the middle of a wide page rather than as a list belonging to it.
                         Height is what this list has to be careful with, and that is the scroller's
                         cap below, which a long instance list scrolls inside. -->
                    <Border HorizontalAlignment="Stretch" Background="{StaticResource AlkSurfaceBrush}" Padding="10"
                            CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                        <ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.InstallDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstallDestinationRow">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Style="{StaticResource AlkCheckBox}"
                                                  Content="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
                <TextBlock loc:Loc.Text="Install.ArchivesFolderLabel" Style="{StaticResource LabelText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.ArchivesFolderPath, Mode=OneWay}" Style="{StaticResource MonoText}"
                               MaxWidth="640" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    <Button loc:Loc.Content="Install.ArchivesFolderChangeButton" Click="OnOpenSettings" Style="{StaticResource Quiet}"
                            loc:Loc.Tooltip="Install.ArchivesFolderChangeButton.Tooltip" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,20,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Five buttons stating 760 px of their own width plus the reason the stack button is off
                     come to about 840, none of it compressible, and this page scrolls vertically only: below
                     that width Install the BUTR Stack and the reason beside it sat past the right edge. The
                     row scrolls sideways inside its own container instead, on that axis only, so it never
                     shares a direction with the page around it. -->
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button loc:Loc.Content="Install.InstallModsButton" Command="{x:Bind ViewModel.InstallModsCommand}" Style="{StaticResource PrimaryAction}" Width="160"
                                loc:Loc.Tooltip="Install.InstallModsButton.Tooltip" />
                        <Button loc:Loc.Content="Install.CheckAllButton" Command="{x:Bind ViewModel.CheckAllArchivesCommand}" Style="{StaticResource Action}" Width="120"
                                loc:Loc.Tooltip="Install.CheckAllButton.Tooltip" />
                        <Button loc:Loc.Content="Install.UncheckAllButton" Command="{x:Bind ViewModel.UncheckAllArchivesCommand}" Style="{StaticResource Action}" Width="120"
                                loc:Loc.Tooltip="Install.UncheckAllButton.Tooltip" />
                        <Button loc:Loc.Content="Install.CheckMatchingSearchButton" Command="{x:Bind ViewModel.CheckMatchingSearchCommand}" Style="{StaticResource Action}" MinWidth="180"
                                loc:Loc.Tooltip="Install.CheckMatchingSearchButton.Tooltip" />
                        <Button loc:Loc.Content="Install.ButrStackButton" Command="{x:Bind ViewModel.InstallButrStackCommand}" Style="{StaticResource Action}" MinWidth="180"
                                loc:Loc.Tooltip="Install.ButrStackButton.Tooltip" />
                        <!-- A disabled button that never says why is a dead control, so the reason stands
                             beside it and is empty whenever the button can run. -->
                        <TextBlock Text="{x:Bind ViewModel.ButrStackBlocker, Mode=OneWay}" Style="{StaticResource MetaText}"
                                   Visibility="{x:Bind ViewModel.ButrStackBlocker, Mode=OneWay, Converter={StaticResource TextToVisibility}}"
                                   VerticalAlignment="Center" MaxWidth="320" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" MinHeight="280" Background="{StaticResource AlkSurfaceBrush}" Padding="10" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Progress Bar -->
                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10"
                                    Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}">
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                       Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressCaption, Mode=OneWay}" Style="{StaticResource MetaText}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind ViewModel.ProgressCaption, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>

                        <TextBox Grid.Row="1" Text="{x:Bind ViewModel.ArchiveSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" loc:Loc.Placeholder="Install.ArchiveSearchBox.Placeholder" Margin="0,0,0,10"
                                 loc:Loc.Tooltip="Install.ArchiveSearchBox.Tooltip" />

                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredArchives}" SelectionMode="None" Background="{StaticResource AlkSurfaceBrush}" BorderThickness="0"
                                  ContextRequested="OnArchiveContextRequested">
                            <!-- The flyout lives on the list so its items can x:Bind the page view model.
                                 Which archive it applies to is recorded by the handler on the archive's
                                 own card, which is first in the chain and cannot be skipped. -->
                            <ListView.ContextFlyout>
                                <MenuFlyout Opening="OnArchiveContextMenuOpening">
                                    <MenuFlyoutItem loc:Loc.Text="Install.InstallArchiveMenuItem" Command="{x:Bind ViewModel.InstallContextArchiveCommand}"
                                                    loc:Loc.Tooltip="Install.InstallArchiveMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Install.ShowArchiveContentsMenuItem" Command="{x:Bind ViewModel.ShowContextArchiveContentsCommand}"
                                                    loc:Loc.Tooltip="Install.ShowArchiveContentsMenuItem.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Install.ShowArchiveInExplorerMenuItem" Command="{x:Bind ViewModel.ShowContextArchiveInExplorerCommand}"
                                                    loc:Loc.Tooltip="Install.ShowArchiveInExplorerMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Install.CopyArchiveNameMenuItem" Command="{x:Bind ViewModel.CopyContextArchiveNameCommand}"
                                                    loc:Loc.Tooltip="Install.CopyArchiveNameMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Install.CopyArchivePathMenuItem" Command="{x:Bind ViewModel.CopyContextArchivePathCommand}"
                                                    loc:Loc.Tooltip="Install.CopyArchivePathMenuItem.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Install.OpenArchiveModPageMenuItem" Command="{x:Bind ViewModel.OpenContextArchivePageCommand}"
                                                    loc:Loc.Tooltip="Install.OpenArchiveModPageMenuItem.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Install.RecycleArchiveMenuItem" Command="{x:Bind ViewModel.RecycleContextArchiveCommand}"
                                                    loc:Loc.Tooltip="Install.RecycleArchiveMenuItem.Tooltip" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModArchiveEntry">
                                <Border Background="{StaticResource AlkSurfaceBrush}" Padding="10" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Margin="0,0,0,10"
                                        ContextRequested="OnArchiveRowContextRequested">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Style="{StaticResource AlkCheckBox}" VerticalAlignment="Top" Margin="0,4,0,0"
                                                  loc:Loc.Tooltip="Install.ArchiveSelectedCheckBox.Tooltip" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SubHeadingText}" />
                                                <TextBlock Text="{x:Bind FileSizeDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Foreground="{StaticResource AlkMutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{x:Bind Modules}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DetectedModule">
                                                        <TextBlock Text="{x:Bind DisplayLabel}" Style="{StaticResource BodyText}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

                <!-- The whole tools band - update coverage, mod-id identification, shader and binary
                     quarantines, the replaced-file restore panels - is Advanced. Everything behind it
                     keeps working in Basic: quarantines still fill on install, coverage still counts;
                     only the panels that read and reverse them are power-user surfaces. -->
                <!-- Installing what was just downloaded is what this page is for, so the archive list
                     above owns the page's height. This band is secondary and scrolls inside a share of
                     the page rather than inside a fixed number of pixels: a cap written as a constant
                     is a third of a tall window and the whole of a short one, so the list it is meant
                     to leave alone still lost its contents on the window the page was not measured on.
                     The share is applied in OnPageSizeChanged. -->
                <Border x:Name="ToolsBand" Background="{StaticResource AlkSurfaceBrush}" BorderBrush="{StaticResource AlkHairlineBrush}"
                        BorderThickness="1" CornerRadius="0" Padding="12"
                        Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
                    <!-- ONE SCROLLING ANCESTOR. This is the only scroller in the band, and every list
                         inside it lays out at its full height with its own scrolling switched off. A
                         list that scrolls inside a panel that also scrolls looks like a section that
                         will not grow: the wheel moves the inner list, the section stays the size it
                         was, and the two scrollbars slide into one another as they pass. Which of the
                         two a reader is moving has to be obvious, and with one of them it is. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                    <StackPanel Spacing="10">
                    <SelectorBar x:Name="ToolPicker" SelectionChanged="OnInstallToolSelected">
                        <SelectorBarItem loc:Loc.Text="Install.UpdateCoverageTab" Tag="ToolCoverage" IsSelected="True"
                                         loc:Loc.Tooltip="Install.UpdateCoverageTab.Tooltip" />
                        <SelectorBarItem loc:Loc.Text="Install.ShaderFoldersTab" Tag="ToolShaders"
                                         loc:Loc.Tooltip="Install.ShaderFoldersTab.Tooltip" />
                        <SelectorBarItem loc:Loc.Text="Install.OtherPlatformBinariesTab" Tag="ToolPlatform"
                                         loc:Loc.Tooltip="Install.OtherPlatformBinariesTab.Tooltip" />
                        <SelectorBarItem loc:Loc.Text="Install.ReplacedModuleFilesTab" Tag="ToolModuleFiles"
                                         loc:Loc.Tooltip="Install.ReplacedModuleFilesTab.Tooltip" />
                        <SelectorBarItem loc:Loc.Text="Install.ReplacedBinFilesTab" Tag="ToolBinFiles"
                                         loc:Loc.Tooltip="Install.ReplacedBinFilesTab.Tooltip" />
                        <SelectorBarItem loc:Loc.Text="Install.ReplacedModuleFoldersTab" Tag="ToolModuleFolders"
                                         loc:Loc.Tooltip="Install.ReplacedModuleFoldersTab.Tooltip" />
                    </SelectorBar>

                    <StackPanel x:Name="ToolCoverage" Spacing="8">
                            <StackPanel x:Name="CoverageBand" x:FieldModifier="internal" Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="{x:Bind ViewModel.NexusCoverageSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />

                                <!-- The band around the row rather than the row itself, because the
                                     outer ring inserts its own line directly after this element and
                                     finds it by position among its parent's children. -->
                                <ScrollViewer x:Name="CoverageActionsBand" x:FieldModifier="internal"
                                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CoverageActions" x:FieldModifier="internal" Orientation="Horizontal" Spacing="8">
                                        <Button loc:Loc.Content="Install.RecheckButton" Command="{x:Bind ViewModel.RefreshNexusCoverageCommand}" Style="{StaticResource Action}" MinWidth="110"
                                                loc:Loc.Tooltip="Install.RecheckButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.IdentifyByFileHashButton" Command="{x:Bind ViewModel.IdentifyArchivesOnNexusCommand}" Style="{StaticResource Action}" MinWidth="170"
                                                loc:Loc.Tooltip="Install.IdentifyByFileHashButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.IdentifyUnlinkedArchivesButton" Command="{x:Bind ViewModel.IdentifyUnlinkedArchivesCommand}" Style="{StaticResource Action}" MinWidth="250"
                                                loc:Loc.Tooltip="Install.IdentifyUnlinkedArchivesButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.SearchButrIndexButton" Command="{x:Bind ViewModel.LearnNexusIdsFromButrCommand}" Style="{StaticResource Action}" MinWidth="170"
                                                loc:Loc.Tooltip="Install.SearchButrIndexButton.Tooltip" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Read Deleted Archive Names was the fifth button in the row above
                                     and Ask About Unrecognized Again the sixth, on a line of its own
                                     because the row already runs past 900 px and this band scrolls
                                     vertically only. Both are in the outer ring now
                                     (DevRing\DeveloperSurfaces.cs), which puts them back in those
                                     two places along with the sentence the first of them writes. -->

                                <TextBlock Text="{x:Bind ViewModel.FileIdentificationSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Visibility="{x:Bind ViewModel.FileIdentificationSummary, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                                <TextBlock x:Name="ButrIndexSummaryText" x:FieldModifier="internal" Text="{x:Bind ViewModel.ButrModuleIndexSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Visibility="{x:Bind ViewModel.ButrModuleIndexSummary, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          loc:Loc.AutomationName="Install.CoverageDetailExpander.Header">
                                    <Expander.Header>
                                        <TextBlock loc:Loc.Text="Install.CoverageDetailExpander.Header" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                                   loc:Loc.Tooltip="Install.CoverageDetailExpander.Header.Tooltip" />
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.NexusCoverageDetail, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   loc:Loc.Text="Install.CoverageDetailExpander.SourceNote" />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   loc:Loc.Text="Install.CoverageDetailExpander.HashNote" />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   loc:Loc.Text="Install.CoverageDetailExpander.ButrNote" />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   loc:Loc.Text="Install.CoverageDetailExpander.DeletedArchiveNote" />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   loc:Loc.Text="Install.CoverageDetailExpander.InstallLogNote" />
                                    </StackPanel>
                                </Expander>

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasNexusIdMatches, Mode=OneWay}">
                                    <!-- Every action row in this band states its own widths and none of them shrinks: they come to
                                         between about 420 and 620 px, more where the outer ring adds a button, and the band scrolls
                                         vertically only, so on a narrow window the last button in a row sat past the right edge with
                                         nothing able to reach it. Each row scrolls sideways inside its own container instead, on that
                                         axis only, so the band still has one bar per direction. -->
                                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button loc:Loc.Content="Install.TickCertainMatchesButton" Command="{x:Bind ViewModel.TickSuggestedNexusIdsCommand}" Style="{StaticResource Action}" MinWidth="200"
                                                    loc:Loc.Tooltip="Install.TickCertainMatchesButton.Tooltip" />
                                            <Button loc:Loc.Content="Install.RecordConfirmedMatchesButton" Command="{x:Bind ViewModel.RecordConfirmedNexusIdsCommand}" Style="{StaticResource Action}" MinWidth="200"
                                                    loc:Loc.Tooltip="Install.RecordConfirmedMatchesButton.Tooltip" />
                                            <Button loc:Loc.Content="Install.DiscardMatchesButton" Command="{x:Bind ViewModel.DiscardNexusIdMatchesCommand}" Style="{StaticResource Action}" MinWidth="190"
                                                    loc:Loc.Tooltip="Install.DiscardMatchesButton.Tooltip" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ListView ItemsSource="{x:Bind ViewModel.NexusIdMatches}" SelectionMode="None"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NexusIdMatchRow">
                                                <StackPanel Spacing="2" Margin="0,4,0,4">
                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Content="{x:Bind Headline}"
                                                              loc:Loc.Tooltip="Install.NexusIdMatchCheckBox.Tooltip" />
                                                    <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="30,0,0,0"
                                                               IsTextSelectionEnabled="True" />
                                                    <HyperlinkButton Content="{x:Bind ModPageUrl}" NavigateUri="{x:Bind ModPageUrl}" Margin="26,0,0,0"
                                                                     loc:Loc.Tooltip="Install.NexusIdMatchLink.Tooltip" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ConfirmedNexusIdSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Visibility="{x:Bind ViewModel.ConfirmedNexusIdSummary, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

                                <!-- Recording a mod id was reachable and taking one back was not, and nothing
                                     listed the ids at all, so a wrong one could not be seen let alone undone.
                                     BUTR's index has named the wrong page twice on this install. -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasConfirmedNexusIds, Mode=OneWay}">
                                    <TextBlock loc:Loc.Text="Install.ConfirmedNexusIdsHeading" Style="{StaticResource LabelText}"
                                               loc:Loc.Tooltip="Install.ConfirmedNexusIdsHeading.Tooltip" />
                                    <ListView ItemsSource="{x:Bind ViewModel.ConfirmedNexusIds}"
                                              SelectedItem="{x:Bind ViewModel.SelectedConfirmedNexusId, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ContextRequested="OnConfirmedNexusIdContextRequested">
                                        <ListView.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem loc:Loc.Text="Install.CopyConfirmedRowMenuItem" Command="{x:Bind ViewModel.CopyConfirmedNexusIdRowCommand}"
                                                                loc:Loc.Tooltip="Install.CopyConfirmedRowMenuItem.Tooltip" />
                                                <MenuFlyoutItem loc:Loc.Text="Install.CopyConfirmedPageUrlMenuItem" Command="{x:Bind ViewModel.CopyConfirmedNexusIdPageUrlCommand}"
                                                                loc:Loc.Tooltip="Install.CopyConfirmedPageUrlMenuItem.Tooltip" />
                                            </MenuFlyout>
                                        </ListView.ContextFlyout>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ConfirmedNexusIdRow">
                                                <StackPanel Spacing="2" Margin="0,2,0,2" Background="Transparent"
                                                            ContextRequested="OnConfirmedNexusIdRowContextRequested">
                                                    <!-- The row is the selection, so its text opts out; what is worth
                                                         reading off it is repeated by the buttons below. -->
                                                    <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="False" />
                                                    <TextBlock Text="{x:Bind Basis}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <!-- Forget the Confirmed ID used to sit between these two and is in
                                         the outer ring now (DevRing\DeveloperSurfaces.cs), which puts
                                         it back there. Play's module row keeps its own Forget in every
                                         build: correcting a wrong id on a mod the user can see is a
                                         player's move, and surgery on the ledger from here is not. -->
                                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="ConfirmedIdActions" x:FieldModifier="internal" Orientation="Horizontal" Spacing="12">
                                            <Button x:Name="OpenConfirmedPageButton" x:FieldModifier="internal"
                                                    loc:Loc.Content="Install.OpenConfirmedPageButton" Command="{x:Bind ViewModel.OpenConfirmedNexusIdPageCommand}" Style="{StaticResource Action}" MinWidth="180"
                                                    loc:Loc.Tooltip="Install.OpenConfirmedPageButton.Tooltip" />
                                            <Button loc:Loc.Content="Install.RefreshConfirmedListButton" Command="{x:Bind ViewModel.ListConfirmedNexusIdsCommand}" Style="{StaticResource Action}" MinWidth="150"
                                                    loc:Loc.Tooltip="Install.RefreshConfirmedListButton.Tooltip" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Both directions. Turning a page down is a decision BEM keeps and acts
                                     on, so it is listed here and it can be taken back; without this, a page
                                     rejected by mistake is unproposable forever with nothing saying why. -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasRejectedNexusIds, Mode=OneWay}">
                                    <TextBlock loc:Loc.Text="Install.RejectedNexusIdsHeading" Style="{StaticResource LabelText}"
                                               loc:Loc.Tooltip="Install.RejectedNexusIdsHeading.Tooltip" />
                                    <ListView ItemsSource="{x:Bind ViewModel.RejectedNexusIds}"
                                              SelectedItem="{x:Bind ViewModel.SelectedRejectedNexusId, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              Background="Transparent"
                                              BorderThickness="0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RejectedNexusIdRow">
                                                <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                           Margin="0,2,0,2" IsTextSelectionEnabled="False" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <!-- Propose It Again stays in every build: a rejection BEM keeps and
                                         acts on has to open both ways, or a page turned down by mistake
                                         is unproposable forever and this list can only say so. Refresh
                                         Rejected List is in the outer ring (DevRing\DeveloperSurfaces.cs),
                                         which puts it back on the end of this row: the list already
                                         refreshes itself on the way in and after every write. -->
                                    <StackPanel x:Name="RejectedIdActions" x:FieldModifier="internal" Orientation="Horizontal" Spacing="12">
                                        <Button loc:Loc.Content="Install.ProposeAgainButton" Command="{x:Bind ViewModel.RestoreRejectedNexusIdCommand}" Style="{StaticResource Action}" MinWidth="210"
                                                loc:Loc.Tooltip="Install.ProposeAgainButton.Tooltip" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ToolShaders" Spacing="8" Visibility="Collapsed">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.ShaderFoldersBlurb" />
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button loc:Loc.Content="Install.ScanShaderFoldersButton" Command="{x:Bind ViewModel.ScanShaderFoldersCommand}" Style="{StaticResource Action}" MinWidth="200"
                                                loc:Loc.Tooltip="Install.ScanShaderFoldersButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.QuarantineShaderFoldersButton" Command="{x:Bind ViewModel.QuarantineShaderFoldersCommand}" Style="{StaticResource Action}" MinWidth="170"
                                                loc:Loc.Tooltip="Install.QuarantineShaderFoldersButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.RestoreQuarantinedShaderFoldersButton" Command="{x:Bind ViewModel.RestoreQuarantinedShaderFoldersCommand}" Style="{StaticResource Action}" MinWidth="190"
                                                loc:Loc.Tooltip="Install.RestoreQuarantinedShaderFoldersButton.Tooltip" />
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock Text="{x:Bind ViewModel.ShaderStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ShaderFolderLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ToolPlatform" Spacing="8" Visibility="Collapsed">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.PlatformDetectionBlurb" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.PlatformSpareBlurb" />
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button loc:Loc.Content="Install.ScanPlatformBinariesButton" Command="{x:Bind ViewModel.ScanPlatformBinariesCommand}" Style="{StaticResource Action}" MinWidth="240"
                                                loc:Loc.Tooltip="Install.ScanPlatformBinariesButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.QuarantinePlatformBinariesButton" Command="{x:Bind ViewModel.QuarantinePlatformBinariesCommand}" Style="{StaticResource Action}" MinWidth="170"
                                                loc:Loc.Tooltip="Install.QuarantinePlatformBinariesButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.RestoreQuarantinedPlatformBinariesButton" Command="{x:Bind ViewModel.RestoreQuarantinedPlatformBinariesCommand}" Style="{StaticResource Action}" MinWidth="190"
                                                loc:Loc.Tooltip="Install.RestoreQuarantinedPlatformBinariesButton.Tooltip" />
                                    </StackPanel>
                                </ScrollViewer>
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button loc:Loc.Content="Install.AdoptPlatformBinariesButton" Command="{x:Bind ViewModel.AdoptPlatformBinariesCommand}" Style="{StaticResource Action}" MinWidth="240"
                                                loc:Loc.Tooltip="Install.AdoptPlatformBinariesButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.UndoAdoptedPlatformBinariesButton" Command="{x:Bind ViewModel.UndoAdoptedPlatformBinariesCommand}" Style="{StaticResource Action}" MinWidth="170"
                                                loc:Loc.Tooltip="Install.UndoAdoptedPlatformBinariesButton.Tooltip" />
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock Text="{x:Bind ViewModel.PlatformStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PlatformFolderLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ToolModuleFiles" Spacing="8" Visibility="Collapsed">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.ModuleFilesBlurb" />
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button loc:Loc.Content="Install.ListReplacedFilesButton" Command="{x:Bind ViewModel.ListReplacedFilesCommand}" Style="{StaticResource Action}" MinWidth="180"
                                                loc:Loc.Tooltip="Install.ListReplacedFilesButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.RestoreSelectedFileButton" Command="{x:Bind ViewModel.RestoreSelectedReplacedFileCommand}" Style="{StaticResource Action}" MinWidth="180"
                                                loc:Loc.Tooltip="Install.RestoreSelectedFileButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.RestoreAllFilesButton" Command="{x:Bind ViewModel.RestoreReplacedFilesCommand}" Style="{StaticResource Action}" MinWidth="200"
                                                loc:Loc.Tooltip="Install.RestoreAllFilesButton.Tooltip" />
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock Text="{x:Bind ViewModel.ReplacedFileStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <ListView ItemsSource="{x:Bind ViewModel.ReplacedFiles}"
                                          SelectedItem="{x:Bind ViewModel.SelectedReplacedFile, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ContextRequested="OnReplacedFileContextRequested">
                                    <ListView.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyReplacedFileRowMenuItem" Command="{x:Bind ViewModel.CopySelectedReplacedFileLineCommand}"
                                                            loc:Loc.Tooltip="Install.CopyReplacedFileRowMenuItem.Tooltip" />
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyReplacedFilePathMenuItem" Command="{x:Bind ViewModel.CopySelectedReplacedFilePathCommand}"
                                                            loc:Loc.Tooltip="Install.CopyReplacedFilePathMenuItem.Tooltip" />
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyReplacedFileBackupPathMenuItem" Command="{x:Bind ViewModel.CopySelectedReplacedFileBackupPathCommand}"
                                                            loc:Loc.Tooltip="Install.CopyReplacedFileBackupPathMenuItem.Tooltip" />
                                        </MenuFlyout>
                                    </ListView.ContextFlyout>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="install:ReplacedFile">
                                            <!-- The row is the selection, so its text opts out; Restore selected needs the click.
                                                 The handler here is the half that cannot be skipped, because ContextRequested
                                                 bubbles and the framework shows the flyout whether or not the list ever hears it. -->
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                                                       ContextRequested="OnReplacedFileRowContextRequested" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ToolBinFiles" Spacing="8" Visibility="Collapsed">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.BinFilesBlurb" />
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button loc:Loc.Content="Install.ListBinBackupsButton" Command="{x:Bind ViewModel.ListBinBackupsCommand}" Style="{StaticResource Action}" MinWidth="180"
                                                loc:Loc.Tooltip="Install.ListBinBackupsButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.RestoreSelectedBinBackupButton" Command="{x:Bind ViewModel.RestoreSelectedBinBackupCommand}" Style="{StaticResource Action}" MinWidth="180"
                                                loc:Loc.Tooltip="Install.RestoreSelectedBinBackupButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.RestoreAllBinBackupsButton" Command="{x:Bind ViewModel.RestoreAllBinBackupsCommand}" Style="{StaticResource Action}" MinWidth="200"
                                                loc:Loc.Tooltip="Install.RestoreAllBinBackupsButton.Tooltip" />
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock Text="{x:Bind ViewModel.BinBackupStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <ListView ItemsSource="{x:Bind ViewModel.BinBackups}"
                                          SelectedItem="{x:Bind ViewModel.SelectedBinBackup, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ContextRequested="OnBinBackupContextRequested">
                                    <ListView.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyBinBackupRowMenuItem" Command="{x:Bind ViewModel.CopySelectedBinBackupLineCommand}"
                                                            loc:Loc.Tooltip="Install.CopyBinBackupRowMenuItem.Tooltip" />
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyBinBackupPathMenuItem" Command="{x:Bind ViewModel.CopySelectedBinBackupPathCommand}"
                                                            loc:Loc.Tooltip="Install.CopyBinBackupPathMenuItem.Tooltip" />
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyBinBackupDestinationMenuItem" Command="{x:Bind ViewModel.CopySelectedBinBackupDestinationCommand}"
                                                            loc:Loc.Tooltip="Install.CopyBinBackupDestinationMenuItem.Tooltip" />
                                        </MenuFlyout>
                                    </ListView.ContextFlyout>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="install:BinBackup">
                                            <!-- The row is the selection, so its text opts out; Restore selected needs the click.
                                                 The handler here is the half that cannot be skipped, because ContextRequested
                                                 bubbles and the framework shows the flyout whether or not the list ever hears it. -->
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                                                       ContextRequested="OnBinBackupRowContextRequested" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ToolModuleFolders" Spacing="8" Visibility="Collapsed">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.ModuleFoldersBlurb" />
                                <CheckBox loc:Loc.Content="Install.KeepModuleFolderCopyCheckBox"
                                          IsChecked="{x:Bind ViewModel.KeepReplacedModuleFolders, Mode=TwoWay}"
                                          Style="{StaticResource AlkCheckBox}"
                                          loc:Loc.Tooltip="Install.KeepModuleFolderCopyCheckBox.Tooltip" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.ModuleFoldersOffNote" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock loc:Loc.Text="Install.KeepMostRecentLabel" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <NumberBox Value="{x:Bind ViewModel.ReplacedModuleKeepCount, Mode=TwoWay}"
                                               Minimum="1" Maximum="50" SmallChange="1" LargeChange="5"
                                               SpinButtonPlacementMode="Compact" Width="130"
                                               loc:Loc.Tooltip="Install.KeepMostRecentCount.Tooltip" />
                                    <TextBlock loc:Loc.Text="Install.OlderDeletedNote" Style="{StaticResource BodyText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button loc:Loc.Content="Install.ListKeptFoldersButton" Command="{x:Bind ViewModel.ListReplacedModuleFoldersCommand}" Style="{StaticResource Action}" MinWidth="180"
                                                loc:Loc.Tooltip="Install.ListKeptFoldersButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.RestoreSelectedFolderButton" Command="{x:Bind ViewModel.RestoreSelectedReplacedModuleFolderCommand}" Style="{StaticResource Action}" MinWidth="180"
                                                loc:Loc.Tooltip="Install.RestoreSelectedFolderButton.Tooltip" />
                                        <Button loc:Loc.Content="Install.DiscardAllFoldersButton" Command="{x:Bind ViewModel.DiscardReplacedModuleFoldersCommand}" Style="{StaticResource DangerAction}" MinWidth="210"
                                                loc:Loc.Tooltip="Install.DiscardAllFoldersButton.Tooltip" />
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock Text="{x:Bind ViewModel.ReplacedModuleStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <ListView ItemsSource="{x:Bind ViewModel.ReplacedModuleFolders}"
                                          SelectedItem="{x:Bind ViewModel.SelectedReplacedModuleFolder, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ContextRequested="OnReplacedModuleFolderContextRequested">
                                    <ListView.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyModuleFolderRowMenuItem" Command="{x:Bind ViewModel.CopySelectedReplacedModuleFolderLineCommand}"
                                                            loc:Loc.Tooltip="Install.CopyModuleFolderRowMenuItem.Tooltip" />
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyModuleFolderStoredPathMenuItem" Command="{x:Bind ViewModel.CopySelectedReplacedModuleFolderStoredPathCommand}"
                                                            loc:Loc.Tooltip="Install.CopyModuleFolderStoredPathMenuItem.Tooltip" />
                                            <MenuFlyoutItem loc:Loc.Text="Install.CopyModuleFolderOriginPathMenuItem" Command="{x:Bind ViewModel.CopySelectedReplacedModuleFolderOriginPathCommand}"
                                                            loc:Loc.Tooltip="Install.CopyModuleFolderOriginPathMenuItem.Tooltip" />
                                        </MenuFlyout>
                                    </ListView.ContextFlyout>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="install:ReplacedModuleFolder">
                                            <StackPanel Spacing="2" Background="Transparent"
                                                        ContextRequested="OnReplacedModuleFolderRowContextRequested">
                                                <!-- The row is the selection, so its text opts out; Restore selected needs the click. -->
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                                <TextBlock Text="{x:Bind DisplayPath}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <!-- THE TRANSIENT REGION, and the pattern to copy. Everything this page raises while it is
             working or when it has finished lives here and nowhere else: the download bar, the stack
             bar, and the per-instance results. The region is a sibling of the grid above, so it
             contributes nothing to any row and every region of the page keeps the size it had before
             the press, at every window size. It lays over the bottom of the page instead, which is
             the secondary band, and everything in it clears itself when its work is done.

             As rows these three took their height out of the star row, which on this page is the
             archive list the page exists for. They took it at the moment the reader was watching that
             list to see what was landing in it, and gave it back when the run ended, so the page
             moved under them twice per press. An nxm:// link opens BEM straight onto this page with
             the download bar already open, which meant arriving at a list that looked broken.

             The three are bounded together, not only one at a time: during a guided stack walk all
             three are open at once. The two bars report work in flight and are read while it runs, so
             they take the region's share first, and the results panel is a report that keeps, so it
             takes what is left and scrolls inside it. ApplyTransientShare does that arithmetic.

             NO SCROLLER HERE CONTAINS ANOTHER. The region is a plain stack, so the stack bar's result
             list and the results panel's list are siblings with a border between them, never a bar
             sliding into the bar of something that contains it, and neither sits inside the tools
             band's scroller, which is underneath this region rather than around it. -->
        <StackPanel x:Name="TransientRegion" VerticalAlignment="Bottom" Spacing="8">
            <StackPanel x:Name="TransientBars" Spacing="8" SizeChanged="OnTransientBarsSizeChanged">
                <!-- A Nexus download can run for minutes. Before this existed, clicking Mod Manager
                     Download opened BEM and showed nothing at all. -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsNexusDownloadVisible, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.NexusDownloadSeverity, Mode=OneWay}"
                         Title="{x:Bind ViewModel.NexusDownloadTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.NexusDownloadMessage, Mode=OneWay}">
                    <InfoBar.Content>
                        <StackPanel Spacing="8" Margin="0,8,0,8">
                            <ProgressBar Visibility="{x:Bind ViewModel.IsNexusDownloadRunning, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind ViewModel.IsNexusDownloadIndeterminate, Mode=OneWay}"
                                         Value="{x:Bind ViewModel.NexusDownloadPercent, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button loc:Loc.Content="Install.CancelDownloadButton"
                                        Visibility="{x:Bind ViewModel.IsNexusDownloadRunning, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.CancelNexusDownloadCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CancelDownloadButton.Tooltip" />
                                <Button loc:Loc.Content="Install.OpenNexusKeySettingsButton"
                                        Visibility="{x:Bind ViewModel.IsNexusKeyNeeded, Mode=OneWay}"
                                        Click="OnOpenNexusKeySettings"
                                        Style="{StaticResource Action}" MinWidth="220"
                                        loc:Loc.Tooltip="Install.OpenNexusKeySettingsButton.Tooltip" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- The stack walk reports one line per mod, and five mods is already more than a
                     message line holds. The list is a fixed height, which is this bar's whole share
                     of the region and the reason the bar cannot grow with the run. -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsButrStackVisible, Mode=TwoWay}"
                         IsClosable="{x:Bind ViewModel.IsButrStackClosable, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.ButrStackSeverity, Mode=OneWay}"
                         Title="{x:Bind ViewModel.ButrStackTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.ButrStackMessage, Mode=OneWay}">
                    <InfoBar.Content>
                        <StackPanel Spacing="8" Margin="0,8,0,8">
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{x:Bind ViewModel.IsButrStackRunning, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" />
                            <ListView Height="96" ItemsSource="{x:Bind ViewModel.ButrStackResults}" SelectionMode="None"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button loc:Loc.Content="Install.ButrStackSkipButton"
                                        Visibility="{x:Bind ViewModel.IsButrStackGuided, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SkipButrStackModCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.ButrStackSkipButton.Tooltip" />
                                <Button loc:Loc.Content="Install.ButrStackCancelButton"
                                        Visibility="{x:Bind ViewModel.IsButrStackRunning, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.CancelButrStackCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.ButrStackCancelButton.Tooltip" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
            </StackPanel>

            <!-- What each version did with the archives. The status line counts archives, which
                 cannot say that the second version took the mod and the third was skipped; it stays
                 empty while one version installs cleanly, which is what it has always reported on
                 its own. -->
            <Border x:Name="InstallResultsSheet" HorizontalAlignment="Stretch"
                    Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}"
                    BorderThickness="1" CornerRadius="0" Padding="12"
                    Visibility="{x:Bind ViewModel.HasInstallResults, Mode=OneWay}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock loc:Loc.Text="Install.InstallResultsLabel" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" loc:Loc.Content="Install.DismissResultsButton"
                                Command="{x:Bind ViewModel.DismissInstallResultsCommand}" Style="{StaticResource Quiet}"
                                loc:Loc.Tooltip="Install.DismissResultsButton.Tooltip" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.InstallResults}" SelectionMode="None"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
