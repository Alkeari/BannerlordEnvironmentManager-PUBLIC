<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BannerlordEnvironmentManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:install="using:BannerlordEnvironmentManager.Core.Install"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />

        <Style x:Key="InstalledHeader" TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="IsTextSelectionEnabled" Value="False" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <!-- Library (redesign step 7): the archives waiting to install are the primary card, with search and
         progress above the list and Install Mods in its footer; beside it, where an install goes and the
         BUTR stack, and in Advanced Mode the tools card (update coverage, the undo list, quarantines).
         The page never scrolls; each card scrolls inside its share. The transient region still lays
         over the bottom of the page, so nothing a press raises moves a card. -->
    <Grid Padding="8">
        <Grid x:Name="PageRows" SizeChanged="OnPageRowsSizeChanged" RowSpacing="16" ColumnSpacing="{StaticResource AlkCardGap}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <controls:PageHeader Grid.ColumnSpan="2" TitleKey="Install.Title" BlurbKey="Install.Blurb"
                                 Status="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                <!-- Basic's Notifications card: what BEM finished, behind one press in the header. -->
                <DropDownButton Content="{x:Bind NotificationsLabel(ViewModel.NotificationRows.Count), Mode=OneWay}"
                                Style="{StaticResource Action}" Visibility="{x:Bind views:PageDensity.Basic(Navigation.IsAdvancedMode), Mode=OneWay}"
                                loc:Loc.Tooltip="Install.Simple.NotificationsDropDown.Tooltip">
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="8" MinWidth="320" MaxWidth="480">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" loc:Loc.Text="Install.Notifications.Empty"
                                           Visibility="{x:Bind ViewModel.HasNoNotifications, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <controls:WrapPanel Spacing="12" Visibility="{x:Bind ViewModel.HasNotifications, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Button loc:Loc.Content="Install.Notifications.MarkRead" Command="{x:Bind ViewModel.MarkNotificationsReadCommand}" Style="{StaticResource Action}"
                                            loc:Loc.Tooltip="Install.Notifications.MarkRead.Tooltip" />
                                    <Button loc:Loc.Content="Install.Notifications.Clear" Command="{x:Bind ViewModel.ClearNotificationsCommand}" Style="{StaticResource Action}"
                                            loc:Loc.Tooltip="Install.Notifications.Clear.Tooltip" />
                                </controls:WrapPanel>
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.NotificationRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NotificationRowViewModel">
                                                <StackPanel Spacing="2" Margin="0,4,0,4">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                                                               Foreground="{StaticResource AlkMutedTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </controls:PageHeader>

            <!-- Installed mods (proposal 2.2): every community module in the version being managed, its
                 version and whether Nexus has a newer one, with Update on the row that has one. The
                 base game's own modules are the game, not mods, and are left out. -->
            <controls:CardShell Grid.Row="1" TitleKey="Install.Card.Installed" IsPrimary="True" BodyScrolls="False" BodyPadded="False"
                                Meta="{x:Bind InstalledMeta, Mode=OneWay}">
                <controls:CardShell.Toolbar>
                    <StackPanel Spacing="8">
                        <TextBox x:Name="InstalledSearch" TextChanged="OnInstalledSearchChanged"
                                 loc:Loc.Placeholder="Install.InstalledSearch.Placeholder" loc:Loc.Tooltip="Install.InstalledSearch.Tooltip" />
                        <!-- The category tree is a power-user filter: Advanced only. -->
                        <ComboBox x:Name="CategoryFilter" HorizontalAlignment="Stretch" SelectionChanged="OnCategoryFilterChanged"
                                  loc:Loc.Tooltip="Install.Category.Tooltip"
                                  Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}" />
                        <Grid ColumnSpacing="12" Padding="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="2*" MinWidth="120" />
                                <ColumnDefinition Width="*" MinWidth="88" />
                                <ColumnDefinition Width="*" MinWidth="124" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" loc:Loc.Text="Install.Column.Name" Style="{StaticResource InstalledHeader}" />
                            <TextBlock Grid.Column="2" loc:Loc.Text="Install.Column.Version" Style="{StaticResource InstalledHeader}" />
                            <TextBlock Grid.Column="3" loc:Loc.Text="Install.Column.Status" Style="{StaticResource InstalledHeader}" />
                        </Grid>
                    </StackPanel>
                </controls:CardShell.Toolbar>

                <ListView ItemsSource="{x:Bind InstalledRows}" SelectionMode="None" Background="Transparent" BorderThickness="0" Padding="8,0,8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="36" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleRowViewModel">
                            <Grid ColumnSpacing="12" Padding="4,6" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                    <ColumnDefinition Width="*" MinWidth="88" />
                                    <ColumnDefinition Width="*" MinWidth="124" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}" Style="{StaticResource AlkCheckBox}"
                                          VerticalAlignment="Center" MinWidth="0" loc:Loc.Tooltip="Environment.ModuleEnabledCheckBox.Tooltip" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Text="{x:Bind DisplayName}" Style="{StaticResource LabelText}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind DisplayName}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Bind UserNoteLine, Mode=OneWay}" Style="{StaticResource MetaText}" VerticalAlignment="Center"
                                               IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}"
                                               Visibility="{x:Bind HasUserNoteLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Bind NotOnNexusSourceLine, Mode=OneWay}" Style="{StaticResource MetaText}" VerticalAlignment="Center"
                                               IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}"
                                               Visibility="{x:Bind HasNotOnNexusSourceLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:Pill VerticalAlignment="Center" TextKey="Environment.Manager.Bem.Pill" Kind="Identity" Visibility="{x:Bind IsManagedByBem, Mode=OneWay}" />
                                    <controls:Pill VerticalAlignment="Center" TextKey="Environment.Manager.Vortex.Pill" Kind="Identity" Visibility="{x:Bind IsManagedByVortex, Mode=OneWay}" />
                                    <controls:Pill VerticalAlignment="Center" TextKey="Environment.Manager.Mo2.Pill" Kind="Identity" Visibility="{x:Bind IsManagedByMo2, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Grid.Column="2" Text="{x:Bind DisplayVersion, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="3" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                           Text="{x:Bind views:InstallPage.StatusOf(IsOutOfDate, IsProbablyOutOfDate, IsUpdateUnknown, IsNotOnNexus, HasNexusId, IsWorkshop, IsUpdateHeld, NexusHasNoMatchingFile), Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind HeldReason, Mode=OneWay}"
                                           Foreground="{x:Bind views:InstallPage.StatusBrush(IsOutOfDate, IsProbablyOutOfDate), Mode=OneWay}" />
                                <Button Grid.Column="4" loc:Loc.Content="Install.Row.UpdateButton" Style="{StaticResource RowAction}"
                                        Click="OnUpdateModuleClicked" Tag="{x:Bind}"
                                        Visibility="{x:Bind IsOutOfDate, Mode=OneWay}"
                                        loc:Loc.Tooltip="Environment.UpdateModMenuItem.Tooltip" />
                                <Button Grid.Column="5" loc:Loc.Content="ModSettings.Row.Button" Style="{StaticResource RowAction}"
                                        Click="OnModSettingsClicked" Tag="{x:Bind}"
                                        Visibility="{x:Bind HasSettingsFile, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanToggle}"
                                        loc:Loc.Tooltip="ModSettings.Row.Tooltip" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </controls:CardShell>

            <!-- Archives, Install and Tools hold more than a short window has room for, so the column
                 scrolls as a whole and every card keeps its full height; the archive list scrolls inside
                 its own bounds so a long folder never pushes the cards below out of reach. -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid RowSpacing="{StaticResource AlkCardGap}" Padding="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- The game folder and the archives folder are Settings' to own; this is the one link to them. -->
            <controls:CardShell TitleKey="Install.Card.Archives"
                                BodyScrolls="False" BodyPadded="False">
                <controls:CardShell.HeaderActions>
                    <Button loc:Loc.Content="Install.FoldersInSettingsButton" Click="OnOpenSettings" Style="{StaticResource QuietAction}"
                            loc:Loc.Tooltip="Install.FoldersInSettingsButton.Tooltip" />
                </controls:CardShell.HeaderActions>
                <controls:CardShell.Toolbar>
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}">
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                         Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressCaption, Mode=OneWay}" Style="{StaticResource MetaText}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ProgressCaption, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                        <TextBox Text="{x:Bind ViewModel.ArchiveSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" loc:Loc.Placeholder="Install.ArchiveSearchBox.Placeholder"
                                 loc:Loc.Tooltip="Install.ArchiveSearchBox.Tooltip" />
                    </StackPanel>
                </controls:CardShell.Toolbar>

                <ListView ItemsSource="{x:Bind ViewModel.FilteredArchives}" SelectionMode="None" MinHeight="140" MaxHeight="360" Background="Transparent" BorderThickness="0" Padding="12,0,12,8"
                          ContextRequested="OnArchiveContextRequested">
                    <!-- The flyout lives on the list so its items can x:Bind the page view model.
                         Which archive it applies to is recorded by the handler on the archive's
                         own card, which is first in the chain and cannot be skipped. -->
                    <ListView.ContextFlyout>
                        <MenuFlyout Opening="OnArchiveContextMenuOpening">
                            <MenuFlyoutItem loc:Loc.Text="Install.InstallArchiveMenuItem" Command="{x:Bind ViewModel.InstallContextArchiveCommand}"
                                            loc:Loc.Tooltip="Install.InstallArchiveMenuItem.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Install.ShowArchiveContentsMenuItem" Command="{x:Bind ViewModel.ShowContextArchiveContentsCommand}"
                                            loc:Loc.Tooltip="Install.ShowArchiveContentsMenuItem.Tooltip" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Install.ShowArchiveInExplorerMenuItem" Command="{x:Bind ViewModel.ShowContextArchiveInExplorerCommand}"
                                            loc:Loc.Tooltip="Install.ShowArchiveInExplorerMenuItem.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Install.CopyArchiveNameMenuItem" Command="{x:Bind ViewModel.CopyContextArchiveNameCommand}"
                                            loc:Loc.Tooltip="Install.CopyArchiveNameMenuItem.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Install.CopyArchivePathMenuItem" Command="{x:Bind ViewModel.CopyContextArchivePathCommand}"
                                            loc:Loc.Tooltip="Install.CopyArchivePathMenuItem.Tooltip" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Install.OpenArchiveModPageMenuItem" Command="{x:Bind ViewModel.OpenContextArchivePageCommand}"
                                            loc:Loc.Tooltip="Install.OpenArchiveModPageMenuItem.Tooltip" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Install.ArchiveArchiveMenuItem" Command="{x:Bind ViewModel.ArchiveContextArchiveCommand}"
                                            loc:Loc.Tooltip="Install.ArchiveArchiveMenuItem.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Install.RecycleArchiveMenuItem" Command="{x:Bind ViewModel.RecycleContextArchiveCommand}"
                                            loc:Loc.Tooltip="Install.RecycleArchiveMenuItem.Tooltip" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModArchiveEntry">
                        <Border Background="Transparent" Padding="4,10" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="0,0,0,1"
                                ContextRequested="OnArchiveRowContextRequested">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Style="{StaticResource AlkCheckBox}" VerticalAlignment="Top" Margin="0,4,0,0"
                                          loc:Loc.Tooltip="Install.ArchiveSelectedCheckBox.Tooltip" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind FileSizeDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Foreground="{StaticResource AlkMutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{x:Bind Modules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DetectedModule">
                                                <TextBlock Text="{x:Bind DisplayLabel}" Style="{StaticResource BodyText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

                <controls:CardShell.Footer>
                    <StackPanel Spacing="8">
                    <!-- Basic: Install Mods, the BUTR stack (the Install card's one everyday action), and
                         the rest behind one more button. -->
                    <controls:WrapPanel Spacing="8" Visibility="{x:Bind views:PageDensity.Basic(Navigation.IsAdvancedMode), Mode=OneWay}">
                        <Button loc:Loc.Content="Install.InstallModsButton" Command="{x:Bind ViewModel.InstallModsCommand}" Style="{StaticResource RowPrimaryAction}"
                                loc:Loc.Tooltip="Install.InstallModsButton.Tooltip" />
                        <Button loc:Loc.Content="Install.ButrStackButton" Command="{x:Bind ViewModel.InstallButrStackCommand}" Style="{StaticResource RowAction}"
                                loc:Loc.Tooltip="Install.ButrStackButton.Tooltip" />
                        <DropDownButton loc:Loc.Content="Install.Simple.MoreDropDown" Style="{StaticResource RowAction}"
                                        loc:Loc.Tooltip="Install.Simple.MoreDropDown.Tooltip">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem loc:Loc.Text="Install.CheckAllButton" Command="{x:Bind ViewModel.CheckAllArchivesCommand}"
                                                    loc:Loc.Tooltip="Install.CheckAllButton.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Install.UncheckAllButton" Command="{x:Bind ViewModel.UncheckAllArchivesCommand}"
                                                    loc:Loc.Tooltip="Install.UncheckAllButton.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Install.CheckMatchingSearchButton" Command="{x:Bind ViewModel.CheckMatchingSearchCommand}"
                                                    loc:Loc.Tooltip="Install.CheckMatchingSearchButton.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Install.CollectionButton" Command="{x:Bind ViewModel.ShowCollectionCommand}"
                                                    loc:Loc.Tooltip="Install.CollectionButton.Tooltip" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </controls:WrapPanel>
                    <TextBlock Text="{x:Bind ViewModel.ButrStackBlocker, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Visibility="{x:Bind BasicText(Navigation.IsAdvancedMode, ViewModel.ButrStackBlocker), Mode=OneWay}" />
                    <controls:WrapPanel Spacing="8" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
                        <Button loc:Loc.Content="Install.InstallModsButton" Command="{x:Bind ViewModel.InstallModsCommand}" Style="{StaticResource RowPrimaryAction}"
                                loc:Loc.Tooltip="Install.InstallModsButton.Tooltip" />
                        <DropDownButton loc:Loc.Content="Install.Simple.MoreDropDown" Style="{StaticResource RowAction}"
                                        loc:Loc.Tooltip="Install.Simple.MoreDropDown.Tooltip">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem loc:Loc.Text="Install.CheckAllButton" Command="{x:Bind ViewModel.CheckAllArchivesCommand}"
                                                    loc:Loc.Tooltip="Install.CheckAllButton.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Install.UncheckAllButton" Command="{x:Bind ViewModel.UncheckAllArchivesCommand}"
                                                    loc:Loc.Tooltip="Install.UncheckAllButton.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Install.CheckMatchingSearchButton" Command="{x:Bind ViewModel.CheckMatchingSearchCommand}"
                                                    loc:Loc.Tooltip="Install.CheckMatchingSearchButton.Tooltip" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </controls:WrapPanel>
                    </StackPanel>
                </controls:CardShell.Footer>
            </controls:CardShell>

                <!-- Where an install goes: the game folder, and the versions one archive can go into in
                     one press (the active version alone is ticked, so an untouched page installs where it
                     always did). Then the BUTR stack in one press, and a Nexus collection. -->
                <controls:CardShell Grid.Row="1" TitleKey="Install.Card.Install" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasInstallDestinations, Mode=OneWay}">
                            <TextBlock loc:Loc.Text="Install.DestinationsLabel" Style="{StaticResource CardGroupText}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.InstallDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstallDestinationRow">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Style="{StaticResource AlkCheckBox}"
                                                  Content="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock loc:Loc.Text="Install.Card.Stack" Style="{StaticResource CardGroupText}" />
                        <!-- A disabled button that never says why is a dead control, so the reason stands
                             under it and is empty whenever the button can run. -->
                        <TextBlock Text="{x:Bind ViewModel.ButrStackBlocker, Mode=OneWay}" Style="{StaticResource BodyText}"
                                   Visibility="{x:Bind ViewModel.ButrStackBlocker, Mode=OneWay, Converter={StaticResource TextToVisibility}}"
                                   TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.ButrStackBlocker, Mode=OneWay}" />

                        <!-- Steam Workshop mods kept as local copies in Modules. The list is a fixed height and
                             scrolls, so a long subscription list cannot push the card's buttons off the page. -->
                        <TextBlock loc:Loc.Text="Install.WorkshopCopies.Title" Style="{StaticResource CardGroupText}" />
                        <TextBlock loc:Loc.Text="Install.WorkshopCopies.Explain" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.WorkshopCopyStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.WorkshopCopyStatus, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                        <ListView ItemsSource="{x:Bind ViewModel.WorkshopCopies}" SelectionMode="None" MaxHeight="200"
                                  Background="Transparent" BorderThickness="0"
                                  Visibility="{x:Bind ViewModel.HasWorkshopCopies, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkshopCopyRowViewModel">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                                            <TextBlock Text="{x:Bind StateText}" Style="{StaticResource BodyText}"
                                                       Foreground="{StaticResource AlkMutedTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{x:Bind ButtonText}" Command="{x:Bind CopyCommand}"
                                                Visibility="{x:Bind CanCopy}" Style="{StaticResource RowAction}"
                                                ToolTipService.ToolTip="{x:Bind ButtonTooltip}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <controls:CardShell.Footer>
                        <controls:WrapPanel Spacing="8">
                            <Button loc:Loc.Content="Install.ButrStackButton" Command="{x:Bind ViewModel.InstallButrStackCommand}" Style="{StaticResource RowAction}"
                                    loc:Loc.Tooltip="Install.ButrStackButton.Tooltip" />
                            <Button loc:Loc.Content="Install.CollectionButton" Command="{x:Bind ViewModel.ShowCollectionCommand}" Style="{StaticResource RowAction}"
                                    loc:Loc.Tooltip="Install.CollectionButton.Tooltip" />
                            <Button loc:Loc.Content="Install.WorkshopCopies.CheckButton" Command="{x:Bind ViewModel.CheckWorkshopCopiesCommand}" Style="{StaticResource RowAction}"
                                    loc:Loc.Tooltip="Install.WorkshopCopies.CheckButton.Tooltip" />
                            <Button loc:Loc.Content="Install.WorkshopCopies.CopyAllButton" Command="{x:Bind ViewModel.CopyAllWorkshopCommand}" Style="{StaticResource RowAction}"
                                    loc:Loc.Tooltip="Install.WorkshopCopies.CopyAllButton.Tooltip" />
                        </controls:WrapPanel>
                    </controls:CardShell.Footer>
                </controls:CardShell>

                <!-- Notifications: every download and update BEM finished, newest first. -->
                <controls:CardShell Grid.Row="3" TitleKey="Install.Card.Notifications" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" loc:Loc.Text="Install.Notifications.Empty"
                                   Visibility="{x:Bind ViewModel.HasNoNotifications, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Bind ViewModel.NotificationSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.NotificationSummary, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                        <controls:WrapPanel Spacing="12" Visibility="{x:Bind ViewModel.HasNotifications, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Button loc:Loc.Content="Install.Notifications.MarkRead" Command="{x:Bind ViewModel.MarkNotificationsReadCommand}" Style="{StaticResource Action}"
                                    loc:Loc.Tooltip="Install.Notifications.MarkRead.Tooltip" />
                            <Button loc:Loc.Content="Install.Notifications.Clear" Command="{x:Bind ViewModel.ClearNotificationsCommand}" Style="{StaticResource Action}"
                                    loc:Loc.Tooltip="Install.Notifications.Clear.Tooltip" />
                        </controls:WrapPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NotificationRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NotificationRowViewModel">
                                    <StackPanel Spacing="2" Margin="0,4,0,4">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                                                   Foreground="{StaticResource AlkMutedTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:CardShell>


                <!-- The tools band is Advanced. Everything behind it keeps working in Basic: quarantines
                     still fill on install and coverage still counts; only the panels that read and
                     reverse them are power-user surfaces. Its card is the one scroller over them. -->
                <controls:CardShell x:Name="ToolsBand" Grid.Row="2" TitleKey="Install.Card.Tools"
                                    Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
                    <StackPanel Spacing="10">
                    <!-- The undo list is the one tool left: the other-platform binaries and the replaced
                         module folders are handled at launch and install, and each is listed here. -->
                    <StackPanel x:Name="ToolUndo" Spacing="8">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock loc:Loc.Text="Install.Undo.Title" Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           loc:Loc.Text="Install.UndoBlurb" />
                                <TextBlock Text="{x:Bind ViewModel.UndoStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.UndoEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="install:UndoEntry">
                                            <Grid ColumnSpacing="12" Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" loc:Loc.Content="Install.UndoRestoreButton" Style="{StaticResource RowAction}" VerticalAlignment="Center"
                                                        Click="OnUndoRestoreClick" loc:Loc.Tooltip="Install.UndoRestoreButton.Tooltip" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                    </StackPanel>

                    <!-- Tracked on Nexus: the account's tracked list beside the installed mod pages. -->
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock loc:Loc.Text="Install.Tracked.Title" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" loc:Loc.Text="Install.Tracked.Blurb" />
                        <controls:WrapPanel Spacing="8">
                            <Button loc:Loc.Content="Install.Tracked.CompareButton" Command="{x:Bind ViewModel.CompareTrackedCommand}" Style="{StaticResource RowAction}"
                                    loc:Loc.Tooltip="Install.Tracked.CompareButton.Tooltip" />
                            <Button loc:Loc.Content="Install.Tracked.TrackButton" Command="{x:Bind ViewModel.TrackMissingCommand}" Style="{StaticResource RowAction}"
                                    loc:Loc.Tooltip="Install.Tracked.TrackButton.Tooltip" />
                        </controls:WrapPanel>
                        <TextBlock Text="{x:Bind ViewModel.TrackedSyncStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.TrackedSyncStatus, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>

                    <!-- Install history: every install, update and removal BEM made, newest first, with
                         Rollback on a line whose archive is still on disk. -->
                    <StackPanel x:Name="HistoryPanel" Spacing="8" Margin="0,8,0,0">
                        <TextBlock loc:Loc.Text="Install.History.Title" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" loc:Loc.Text="Install.History.Blurb" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" loc:Loc.Text="Install.History.Empty"
                                   Visibility="{x:Bind ViewModel.HasNoHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Bind ViewModel.HistoryStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HistoryStatus, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HistoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstallHistoryRowViewModel">
                                    <Grid ColumnSpacing="12" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                                                       Foreground="{StaticResource AlkMutedTextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" loc:Loc.Content="Install.History.Rollback" Style="{StaticResource RowAction}" VerticalAlignment="Center"
                                                Visibility="{x:Bind CanRollback}" Click="OnHistoryRollbackClick" loc:Loc.Tooltip="Install.History.Rollback.Tooltip" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                </controls:CardShell>
            </Grid>
            </ScrollViewer>

            <controls:PanelSplitter x:Name="SideSplitter" Grid.Row="1" Grid.Column="1" SectionKey="LibrarySideWidth" />
        </Grid>

        <!-- THE TRANSIENT REGION, and the pattern to copy. Everything this page raises while it is
             working or when it has finished lives here and nowhere else: the download bar, the stack
             bar, and the per-instance results. The region is a sibling of the grid above, so it
             contributes nothing to any row and every region of the page keeps the size it had before
             the press, at every window size. It lays over the bottom of the page instead, which is
             the secondary band, and everything in it clears itself when its work is done.

             As rows these three took their height out of the star row, which on this page is the
             archive list the page exists for. They took it at the moment the reader was watching that
             list to see what was landing in it, and gave it back when the run ended, so the page
             moved under them twice per press. An nxm:// link opens BEM straight onto this page with
             the download bar already open, which meant arriving at a list that looked broken.

             The three are bounded together, not only one at a time: during a guided stack walk all
             three are open at once. The two bars report work in flight and are read while it runs, so
             they take the region's share first, and the results panel is a report that keeps, so it
             takes what is left and scrolls inside it. ApplyTransientShare does that arithmetic.

             NO SCROLLER HERE CONTAINS ANOTHER. The region is a plain stack, so the stack bar's result
             list and the results panel's list are siblings with a border between them, never a bar
             sliding into the bar of something that contains it, and neither sits inside the tools
             band's scroller, which is underneath this region rather than around it. -->
        <StackPanel x:Name="TransientRegion" VerticalAlignment="Bottom" Spacing="8" Background="{StaticResource AlkSurfaceBrush}">
            <StackPanel x:Name="TransientBars" Spacing="8" SizeChanged="OnTransientBarsSizeChanged">
                <!-- THE DOWNLOADS PANEL. A Nexus download can run for minutes, and before this existed one
                     InfoBar showed only the latest of them and lost the rest. Every download is a row here,
                     running or finished, until dismissed, in the order the queue runs them. Pause, Resume,
                     Retry and the move buttons act on the queue; a running download that is paused starts
                     again from the beginning, since the downloader keeps no partial file. -->
                <Border Visibility="{x:Bind ViewModel.HasDownloads, Mode=OneWay}"
                        Background="{StaticResource AlkSurfaceBrush}" BorderBrush="{StaticResource AlkHairlineBrush}"
                        BorderThickness="1" Padding="12,8">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock loc:Loc.Text="Install.Downloads.Title" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" loc:Loc.Content="Install.Downloads.ClearFinished"
                                    Command="{x:Bind ViewModel.ClearFinishedDownloadsCommand}"
                                    Visibility="{x:Bind ViewModel.HasFinishedDownloads, Mode=OneWay}"
                                    Style="{StaticResource Action}"
                                    loc:Loc.Tooltip="Install.Downloads.ClearFinished.Tooltip" />
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Downloads}" SelectionMode="None" MaxHeight="220"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource AlkMutedTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                            </StackPanel>
                                            <ProgressBar Visibility="{x:Bind IsTransferring, Mode=OneWay}"
                                                         IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                         Value="{x:Bind Percent, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="{x:Bind Message, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                        </StackPanel>
                                        <controls:WrapPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource RowAction}" loc:Loc.Content="Install.Downloads.MoveUp"
                                                    Visibility="{x:Bind CanMove, Mode=OneWay}" Command="{x:Bind MoveUpCommand}"
                                                    loc:Loc.Tooltip="Install.Downloads.MoveUp.Tooltip" />
                                            <Button Style="{StaticResource RowAction}" loc:Loc.Content="Install.Downloads.MoveDown"
                                                    Visibility="{x:Bind CanMove, Mode=OneWay}" Command="{x:Bind MoveDownCommand}"
                                                    loc:Loc.Tooltip="Install.Downloads.MoveDown.Tooltip" />
                                            <Button Style="{StaticResource RowAction}" loc:Loc.Content="Install.Downloads.Pause"
                                                    Visibility="{x:Bind CanPause, Mode=OneWay}" Command="{x:Bind PauseCommand}"
                                                    loc:Loc.Tooltip="Install.Downloads.Pause.Tooltip" />
                                            <Button Style="{StaticResource RowAction}" loc:Loc.Content="Install.Downloads.Resume"
                                                    Visibility="{x:Bind CanResume, Mode=OneWay}" Command="{x:Bind ResumeCommand}"
                                                    loc:Loc.Tooltip="Install.Downloads.Resume.Tooltip" />
                                            <Button Style="{StaticResource RowAction}" loc:Loc.Content="Install.Downloads.Retry"
                                                    Visibility="{x:Bind CanRetry, Mode=OneWay}" Command="{x:Bind RetryCommand}"
                                                    loc:Loc.Tooltip="Install.Downloads.Retry.Tooltip" />
                                            <Button Style="{StaticResource Action}" loc:Loc.Content="Install.CancelDownloadButton"
                                                    Visibility="{x:Bind IsRunning, Mode=OneWay}" Command="{x:Bind CancelCommand}"
                                                    loc:Loc.Tooltip="Install.CancelDownloadButton.Tooltip" />
                                        </controls:WrapPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Action}"
                                                loc:Loc.Content="Install.Downloads.Dismiss"
                                                Visibility="{x:Bind IsFinished, Mode=OneWay}"
                                                Command="{x:Bind DismissCommand}"
                                                loc:Loc.Tooltip="Install.Downloads.Dismiss.Tooltip" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button loc:Loc.Content="Install.OpenNexusKeySettingsButton"
                                Visibility="{x:Bind ViewModel.IsNexusKeyNeeded, Mode=OneWay}"
                                Click="OnOpenNexusKeySettings"
                                Style="{StaticResource Action}" MinWidth="220"
                                loc:Loc.Tooltip="Install.OpenNexusKeySettingsButton.Tooltip" />
                    </StackPanel>
                </Border>

                <!-- The stack walk reports one line per mod, and five mods is already more than a
                     message line holds. The list is a fixed height, which is this bar's whole share
                     of the region and the reason the bar cannot grow with the run. -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsButrStackVisible, Mode=TwoWay}"
                         IsClosable="{x:Bind ViewModel.IsButrStackClosable, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.ButrStackSeverity, Mode=OneWay}"
                         Title="{x:Bind ViewModel.ButrStackTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.ButrStackMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptButrStackCommand}"
                                Visibility="{x:Bind ViewModel.CanAcceptButrStack, Mode=OneWay}"
                                loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Spacing="8" Margin="0,8,0,8">
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{x:Bind ViewModel.IsButrStackRunning, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" />
                            <ListView Height="96" ItemsSource="{x:Bind ViewModel.ButrStackResults}" SelectionMode="None"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button loc:Loc.Content="Install.ButrStackSkipButton"
                                        Visibility="{x:Bind ViewModel.IsButrStackGuided, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SkipButrStackModCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.ButrStackSkipButton.Tooltip" />
                                <Button loc:Loc.Content="Install.ButrStackCancelButton"
                                        Visibility="{x:Bind ViewModel.IsButrStackRunning, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.CancelButrStackCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.ButrStackCancelButton.Tooltip" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- A collection lists dozens of files, so its plan is the same fixed-height list the stack
                     bar uses, scrolled rather than grown. The link box and Read come first, because nothing
                     is installed until the player has seen what the collection would change. -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsCollectionVisible, Mode=TwoWay}"
                         IsClosable="{x:Bind ViewModel.IsCollectionClosable, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.CollectionSeverity, Mode=OneWay}"
                         Title="{x:Bind ViewModel.CollectionTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.CollectionMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptCollectionCommand}"
                                Visibility="{x:Bind ViewModel.CanAcceptCollection, Mode=OneWay}"
                                loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Spacing="8" Margin="0,8,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsCollectionIdle, Mode=OneWay}">
                                <TextBox Text="{x:Bind ViewModel.CollectionLinkText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Install.CollectionLink.Placeholder" MinWidth="360"
                                         loc:Loc.Tooltip="Install.CollectionLink.Tooltip" />
                                <Button loc:Loc.Content="Install.CollectionReadButton"
                                        Command="{x:Bind ViewModel.ReadCollectionCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CollectionReadButton.Tooltip" />
                                <Button loc:Loc.Content="Install.CollectionInstallButton"
                                        Command="{x:Bind ViewModel.InstallCollectionCommand}"
                                        Style="{StaticResource PrimaryAction}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CollectionInstallButton.Tooltip" />
                                <Button loc:Loc.Content="Install.CollectionBrowseButton"
                                        Command="{x:Bind ViewModel.BrowseCollectionFileCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CollectionBrowseButton.Tooltip" />
                                <Button loc:Loc.Content="Install.CollectionCreateButton"
                                        Command="{x:Bind ViewModel.CreateCollectionCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CollectionCreateButton.Tooltip" />
                                <Button loc:Loc.Content="Install.CollectionDraft.Button" Command="{x:Bind ViewModel.ExportCollectionDraftCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CollectionDraft.Button.Tooltip" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="24" Visibility="{x:Bind ViewModel.IsCollectionIdle, Mode=OneWay}">
                                <CheckBox IsChecked="{x:Bind ViewModel.IncludeOptionalCollectionMods, Mode=TwoWay}"
                                          loc:Loc.Content="Install.CollectionIncludeOptional"
                                          loc:Loc.Tooltip="Install.CollectionIncludeOptional.Tooltip" />
                                <CheckBox IsChecked="{x:Bind ViewModel.FollowCuratorUpdateChoice, Mode=TwoWay}"
                                          loc:Loc.Content="Install.CollectionFollowCurator"
                                          loc:Loc.Tooltip="Install.CollectionFollowCurator.Tooltip" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{x:Bind ViewModel.IsCollectionRunning, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" />
                            <ListView Height="160" ItemsSource="{x:Bind ViewModel.CollectionResults}" SelectionMode="None"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button loc:Loc.Content="Install.ButrStackSkipButton"
                                        Visibility="{x:Bind ViewModel.IsCollectionGuided, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SkipCollectionModCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CollectionSkipButton.Tooltip" />
                                <Button loc:Loc.Content="Install.ButrStackCancelButton"
                                        Visibility="{x:Bind ViewModel.IsCollectionRunning, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.CancelCollectionCommand}"
                                        Style="{StaticResource Action}" MinWidth="160"
                                        loc:Loc.Tooltip="Install.CollectionCancelButton.Tooltip" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
            </StackPanel>

            <!-- What each version did with the archives. The status line counts archives, which
                 cannot say that the second version took the mod and the third was skipped; it stays
                 empty while one version installs cleanly, which is what it has always reported on
                 its own. -->
            <Border x:Name="InstallResultsSheet" HorizontalAlignment="Stretch"
                    Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}"
                    BorderThickness="1" CornerRadius="0" Padding="12"
                    Visibility="{x:Bind ViewModel.HasInstallResults, Mode=OneWay}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock loc:Loc.Text="Install.InstallResultsLabel" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" loc:Loc.Content="Install.DismissResultsButton"
                                Command="{x:Bind ViewModel.DismissInstallResultsCommand}" Style="{StaticResource Quiet}"
                                loc:Loc.Tooltip="Install.DismissResultsButton.Tooltip" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.InstallResults}" SelectionMode="None"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
