<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />
        <converters:ReferencedToLabelConverter x:Key="ReferencedToLabel" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- BodyText is selectable, and a selectable TextBlock takes the pointer for text selection:
             over one of these columns the cursor became an I-beam and the click never reached the row
             underneath, so no instance in this list could be selected at all. Rows in a list that
             selects opt out; the paths and figures outside the list stay selectable. -->
        <Style x:Key="InstanceColumn" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextSelectionEnabled" Value="False" />
        </Style>

        <!-- Counts read against each other down the column, so they take the face with tabular
             figures and hang off the right edge: every digit then lines up with the digit above it. -->
        <Style x:Key="InstanceNumberColumn" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextSelectionEnabled" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Table headers: Steel Gray, 12 px bold, as the mockup's table header row. -->
        <Style x:Key="InstanceHeader" TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="IsTextSelectionEnabled" Value="False" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InstanceNumberHeader" TargetType="TextBlock" BasedOn="{StaticResource InstanceHeader}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <!-- Versions (redesign step 4, mockup-versions.html): the installed versions table is the primary
         card; beside it the selected version with its actions, and the card that adds a version. The
         page never scrolls; each card scrolls inside its share. Build Id and Used By are Advanced Mode
         columns. Everything that can be done to one version stays on the row menu as well. -->
    <Grid x:Name="PageRoot" Padding="8" RowSpacing="8" ColumnSpacing="{StaticResource AlkCardGap}" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TableRow" Height="*" />
            <RowDefinition x:Name="FoldedRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition x:Name="SideColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader x:Name="Header" Grid.ColumnSpan="2" TitleKey="Versions.Title" BlurbKey="Versions.Blurb" />

        <controls:CardShell x:Name="TableCard" Grid.Row="1" TitleKey="Versions.InstancesLabel" IsPrimary="True"
                            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}" BodyScrolls="False" BodyPadded="False">
            <controls:CardShell.Toolbar>
                <!-- Mirrors the item template's own Grid so the labels line up over their columns. -->
                <Grid ColumnSpacing="16" Padding="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(Navigation.IsAdvancedMode, 1), Mode=OneWay}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(Navigation.IsAdvancedMode, 1), Mode=OneWay}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" loc:Loc.Text="Versions.StatusColumn" Style="{StaticResource InstanceHeader}" />
                    <TextBlock Grid.Column="1" loc:Loc.Text="Versions.VersionColumn" Style="{StaticResource InstanceHeader}" />
                    <TextBlock Grid.Column="2" loc:Loc.Text="Versions.BranchColumn" Style="{StaticResource InstanceHeader}" />
                    <TextBlock Grid.Column="3" loc:Loc.Text="Versions.BuildIdColumn" Style="{StaticResource InstanceNumberHeader}" />
                    <TextBlock Grid.Column="4" loc:Loc.Text="Versions.DlcColumn" Style="{StaticResource InstanceHeader}" />
                    <TextBlock Grid.Column="5" loc:Loc.Text="Versions.ReferencedColumn" Style="{StaticResource InstanceHeader}" />
                    <TextBlock Grid.Column="6" loc:Loc.Text="Versions.SizeOnDiskColumn" Style="{StaticResource InstanceNumberHeader}" />
                </Grid>
            </controls:CardShell.Toolbar>

            <Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}"
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="4,0,4,8"
                      ContextRequested="OnInstanceContextRequested"
                      loc:Loc.Tooltip="Versions.InstanceList.Tooltip">
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="InstanceRowMenu" x:FieldModifier="internal">
                            <MenuFlyoutItem x:Name="RenameMenuItem" x:FieldModifier="internal"
                                            loc:Loc.Text="Versions.Menu.Rename"
                                            Command="{x:Bind ViewModel.RenameInstanceCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanRename, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.RenameTooltip, Mode=OneWay}" />
                            <!-- Purpose used to sit here. It is in the outer ring now
                                 (DevRing\DeveloperSurfaces.cs), which puts it back into
                                 this flyout below Rename: what a version is for is what
                                 tells a mod's build tool a testing instance from one the
                                 owner plays in, and a player has no build tool. Every
                                 build still reads and labels the purpose an instance
                                 already carries. -->
                            <MenuFlyoutItem loc:Loc.Text="Versions.Menu.OpenFolder"
                                            Command="{x:Bind ViewModel.OpenInstanceFolderCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanOpenFolder, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.OpenFolderTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem loc:Loc.Text="Versions.Menu.CopyPath"
                                            Command="{x:Bind ViewModel.CopyInstancePathCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanCopyPath, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.CopyPathTooltip, Mode=OneWay}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Versions.Menu.SetActive"
                                            Command="{x:Bind ViewModel.SetActiveCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanSetActive, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.SetActiveTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem loc:Loc.Text="Versions.SetRestingButton"
                                            Command="{x:Bind ViewModel.SetRestingCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanSetResting, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.SetRestingTooltip, Mode=OneWay}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Versions.Menu.InstallAnotherCopy"
                                            Command="{x:Bind ViewModel.InstallAnotherCopyCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanInstallAnotherCopy, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.InstallAnotherCopyTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem loc:Loc.Text="Versions.VerifyButton"
                                            Command="{x:Bind ViewModel.VerifyGameFilesCommand}"
                                            loc:Loc.Tooltip="Versions.VerifyButton.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Versions.AdoptButton"
                                            Command="{x:Bind ViewModel.AdoptCurrentInstallCommand}"
                                            loc:Loc.Tooltip="Versions.AdoptButton.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Versions.BuildUninstallReportButton"
                                            Command="{x:Bind ViewModel.PrepareForUninstallCommand}"
                                            loc:Loc.Tooltip="Versions.BuildUninstallReportButton.Tooltip" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Versions.Menu.ShowDetails"
                                            Command="{x:Bind ViewModel.ShowInstanceDetailsCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanShowDetails, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.ShowDetailsTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem loc:Loc.Text="Versions.RemoveButton"
                                            Command="{x:Bind ViewModel.RemoveInstanceCommand}"
                                            IsEnabled="{x:Bind ViewModel.Menu.CanRemove, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Menu.RemoveTooltip, Mode=OneWay}" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstanceRowViewModel">
                            <!-- The row records itself as the menu's target before the flyout opens. This
                                 handler is the half that cannot be skipped: ContextRequested bubbles, the
                                 list-level one runs only if nothing in between marked the event handled,
                                 and the framework shows the flyout either way, which is how a right-click
                                 on one row came to act on whichever row was selected last. Transparent so
                                 the grid itself is hit-testable: without it a click in a column gap
                                 reaches the item container instead and this handler never runs. The
                                 InstanceColumn and InstanceNumberColumn styles turn text selection off
                                 for the same gesture's sake, since a selectable TextBlock takes the
                                 pointer and the right-click never reaches the row at all. -->
                            <Grid ColumnSpacing="16" Padding="4" ToolTipService.ToolTip="{x:Bind StatusTooltip}"
                                  Background="Transparent"
                                  ContextRequested="OnInstanceRowContextRequested">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, 1), Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, 1), Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <controls:Pill TextKey="Versions.RestingPill" Kind="Clear"
                                                   Visibility="{x:Bind IsResting, Converter={StaticResource BoolToVisibility}}"
                                                   loc:Loc.Tooltip="Versions.RestingPill.Tooltip" />
                                    <controls:Pill TextKey="Versions.ActivePill" Kind="Action"
                                                   Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibility}}"
                                                   loc:Loc.Tooltip="Versions.ActivePill.Tooltip" />
                                </StackPanel>
                                <!-- The name first, then what the version and its DLC actually
                                     are underneath it whenever a name was chosen, so a name
                                     the user typed can never stand in for a fact. With no
                                     chosen name the first line already is that fact. -->
                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind RowLabel}" Style="{StaticResource InstanceColumn}" TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Bind VersionText}" Style="{StaticResource MetaText}" IsTextSelectionEnabled="False"
                                               Visibility="{x:Bind HasChosenName, Converter={StaticResource BoolToVisibility}}"
                                               loc:Loc.Tooltip="Versions.VersionColumn.DerivedTooltip" />
                                    <TextBlock Text="{x:Bind VersionDriftText}" Style="{StaticResource InstanceColumn}"
                                               Visibility="{x:Bind HasVersionDrift, Converter={StaticResource BoolToVisibility}}"
                                               loc:Loc.Tooltip="Versions.VersionColumn.DriftTooltip" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind BranchText}" Style="{StaticResource InstanceColumn}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind BuildIdText}" Style="{StaticResource InstanceNumberColumn}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind DlcLabel}" Style="{StaticResource InstanceColumn}"
                                           loc:Loc.Tooltip="Versions.DlcColumn.Tooltip" />
                                <TextBlock Grid.Column="5"
                                           Text="{x:Bind Record.GameFolderIsReferenced, Converter={StaticResource ReferencedToLabel}}"
                                           Style="{StaticResource InstanceColumn}"
                                           loc:Loc.Tooltip="Versions.ReferencedColumn.Tooltip" />
                                <TextBlock Grid.Column="6" Text="{x:Bind SizeOnDiskText}" Style="{StaticResource InstanceNumberColumn}"
                                           loc:Loc.Tooltip="Versions.SizeOnDiskColumn.Tooltip" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
            </ListView>
                <controls:EmptyState Kind="Empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Title="{x:Bind EmptyTitle}" Reason="{x:Bind EmptyReason}"
                                     Visibility="{x:Bind ViewModel.HasNoInstances, Mode=OneWay}">
                    <Button loc:Loc.Content="Versions.AdoptButton" Command="{x:Bind ViewModel.AdoptCurrentInstallCommand}"
                            Style="{StaticResource PrimaryAction}" MinWidth="170"
                            loc:Loc.Tooltip="Versions.AdoptButton.Tooltip" />
                </controls:EmptyState>
            </Grid>

            <!-- Where BEM keeps the versions it manages: shown once for the whole table. -->
            <controls:CardShell.Footer>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock loc:Loc.Text="Versions.GamesRootLabel" Style="{StaticResource FieldLabelText}" />
                    <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{x:Bind ViewModel.GamesRoot, Mode=OneWay}" Style="{StaticResource MonoText}"
                               VerticalAlignment="Center" IsTextSelectionEnabled="True"
                               loc:Loc.Tooltip="Versions.GamesRootPath.Tooltip" />
                    <Button Grid.Column="2" loc:Loc.Content="Versions.BrowseGamesRootButton" Command="{x:Bind ViewModel.BrowseGamesRootCommand}"
                            Style="{StaticResource QuietAction}"
                            loc:Loc.Tooltip="Versions.BrowseGamesRootButton.Tooltip" />
                </Grid>
            </controls:CardShell.Footer>
        </controls:CardShell>

        <Grid x:Name="SideCards" Grid.Row="1" Grid.Column="1" RowSpacing="{StaticResource AlkCardGap}" ColumnSpacing="{StaticResource AlkCardGap}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SideFirstRow" Height="*" />
                <RowDefinition x:Name="SideSecondRow" Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideSecondColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- The selected version: what it is and what can be done to it. The same commands and the
                 same reasons as the row menu, so the two can never disagree. -->
            <controls:CardShell x:Name="SelectedCard" Title="{x:Bind SelectedTitle(ViewModel.SelectedInstance), Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyText}" loc:Loc.Text="Versions.Selected.Nothing"
                               Visibility="{x:Bind NothingSelectedVisibility(ViewModel.SelectedInstance), Mode=OneWay}" />
                    <Grid ColumnSpacing="16" RowSpacing="6"
                          Visibility="{x:Bind SelectedVisibility(ViewModel.SelectedInstance), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock loc:Loc.Text="Versions.Selected.Path" Style="{StaticResource BodyText}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedInstance.Folder, Mode=OneWay}" Style="{StaticResource MonoText}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" loc:Loc.Text="Versions.BranchColumn" Style="{StaticResource BodyText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedInstance.BranchText, Mode=OneWay}" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="2" loc:Loc.Text="Versions.DlcColumn" Style="{StaticResource BodyText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedInstance.DlcLabel, Mode=OneWay}" Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" loc:Loc.Text="Versions.SizeOnDiskColumn" Style="{StaticResource BodyText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedInstance.SizeOnDiskText, Mode=OneWay}" Style="{StaticResource LabelText}" />
                    </Grid>
                    <!-- One button per DLC the selected version does not have yet. -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedInstanceMissingDlc, Mode=OneWay}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MissingDlcRowViewModel">
                                <Button Content="{x:Bind AddLabel}" Command="{x:Bind AddCommand}" CommandParameter="{x:Bind Dlc}"
                                        Style="{StaticResource RowAction}"
                                        ToolTipService.ToolTip="{x:Bind AddTooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <controls:CardShell.Footer>
                    <controls:WrapPanel Spacing="8">
                        <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.Menu.SetRestingTooltip, Mode=OneWay}">
                            <Button loc:Loc.Content="Versions.SetRestingButton" Command="{x:Bind ViewModel.SetRestingCommand}"
                                    IsEnabled="{x:Bind ViewModel.Menu.CanSetResting, Mode=OneWay}" Style="{StaticResource RowPrimaryAction}" />
                        </Border>
                        <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.Menu.RenameTooltip, Mode=OneWay}">
                            <Button loc:Loc.Content="Versions.Menu.Rename" Command="{x:Bind ViewModel.RenameInstanceCommand}"
                                    IsEnabled="{x:Bind ViewModel.Menu.CanRename, Mode=OneWay}" Style="{StaticResource RowAction}" />
                        </Border>
                        <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.Menu.RemoveTooltip, Mode=OneWay}">
                            <Button loc:Loc.Content="Versions.RemoveButton" Command="{x:Bind ViewModel.RemoveInstanceCommand}"
                                    IsEnabled="{x:Bind ViewModel.Menu.CanRemove, Mode=OneWay}" Style="{StaticResource DangerAction}" HorizontalAlignment="Left" />
                        </Border>
                    </controls:WrapPanel>
                </controls:CardShell.Footer>
            </controls:CardShell>

            <!-- Adding a version. This card's Download is the only thing anywhere in BEM that starts a
                 base game download; picking a version chooses what it would fetch and downloads nothing. -->
            <controls:CardShell x:Name="AddCard" Grid.Row="1" TitleKey="Versions.Add.Title"
                                IsBusy="{x:Bind ViewModel.VersionSwitcher.IsProgressVisible, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <ComboBox ItemsSource="{x:Bind ViewModel.DownloadableVersions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedDownload, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.VersionSwitcher.IsIdle, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              loc:Loc.Header="Versions.DownloadLabel"
                              loc:Loc.Tooltip="Versions.DownloadComboBox.Tooltip">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameVersionRowViewModel">
                                <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap" Text="{x:Bind DisplayLabel}" Style="{StaticResource LabelText}" IsTextSelectionEnabled="False" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateText}" Style="{StaticResource MetaText}"
                                               HorizontalAlignment="Right" IsTextSelectionEnabled="False" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Fixed at 56 px while a download runs, because the status line rewrites itself
                         several times a second; once it is over it grows to hold the whole result. -->
                    <Grid Height="{x:Bind StatusBoxHeight(ViewModel.VersionSwitcher.IsProgressVisible), Mode=OneWay}" RowSpacing="6"
                          Visibility="{x:Bind DownloadStatusVisibility(ViewModel.VersionSwitcher.IsProgressVisible, ViewModel.VersionSwitcher.StatusMessage), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{x:Bind ViewModel.VersionSwitcher.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       IsTextSelectionEnabled="True"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.VersionSwitcher.StatusMessage, Mode=OneWay}" />
                        </ScrollViewer>
                        <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.VersionSwitcher.ProgressValue, Mode=OneWay}"
                                     Minimum="0" Maximum="100" VerticalAlignment="Center"
                                     Visibility="{x:Bind ViewModel.VersionSwitcher.IsProgressVisible, Mode=OneWay}"
                                     loc:Loc.Tooltip="Versions.DownloadProgressBar.Tooltip" />
                    </Grid>

                    <!-- White, padded and opaque on purpose: a QR code is read by contrast. It appears
                         once when Steam asks for a sign-in and stays until it is scanned. -->
                    <Border Background="{StaticResource AlkQrQuietZoneBrush}" Padding="12" HorizontalAlignment="Left"
                            Visibility="{x:Bind ViewModel.VersionSwitcher.QrImage, Mode=OneWay, Converter={StaticResource TextToVisibility}}"
                            loc:Loc.Tooltip="Versions.SteamQrCode.Tooltip">
                        <Image Source="{x:Bind ViewModel.VersionSwitcher.QrImage, Mode=OneWay}" Width="264" Height="264" />
                    </Border>

                    <!-- A download that stopped short: shown only when one exists. -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasUnfinishedDownloads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock loc:Loc.Text="Versions.UnfinishedLabel" Style="{StaticResource CardGroupText}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.UnfinishedDownloads, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UnfinishedDownloadRowViewModel">
                                    <Grid ColumnSpacing="8" Padding="0,4" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock TextWrapping="Wrap" Text="{x:Bind Label}" Style="{StaticResource LabelText}"
                                                   VerticalAlignment="Center" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Label}" />
                                        <Button Grid.Column="1" loc:Loc.Content="Versions.Unfinished.ResumeButton"
                                                Command="{x:Bind ResumeCommand}" CommandParameter="{x:Bind}"
                                                IsEnabled="{x:Bind CanResume}" Style="{StaticResource RowAction}"
                                                ToolTipService.ToolTip="{x:Bind ResumeTooltip}" />
                                        <Button Grid.Column="2" loc:Loc.Content="Versions.Unfinished.DiscardButton"
                                                Command="{x:Bind DiscardCommand}" CommandParameter="{x:Bind}"
                                                Style="{StaticResource DangerAction}" HorizontalAlignment="Left"
                                                ToolTipService.ToolTip="{x:Bind DiscardTooltip}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource CardNoteText}"
                               IsTextSelectionEnabled="True"
                               Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />

                    <!-- What uninstalling the game would leave behind: Advanced Mode. The report is built
                         from a version row's menu, with Verify game files and Adopt Current Install, so
                         Download is the one visible action. -->
                    <StackPanel Spacing="4" Visibility="{x:Bind views:PageDensity.AdvancedAnd(Navigation.IsAdvancedMode, ViewModel.HasUninstallLines), Mode=OneWay}">
                        <TextBlock loc:Loc.Text="Versions.UninstallLabel" Style="{StaticResource CardGroupText}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.UninstallLines, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" Margin="0,2,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <controls:CardShell.Footer>
                    <controls:WrapPanel Spacing="8">
                        <Button loc:Loc.Content="Versions.DownloadButton" Command="{x:Bind ViewModel.DownloadVersionCommand}"
                                Style="{StaticResource RowPrimaryAction}"
                                loc:Loc.Tooltip="Versions.DownloadButton.Tooltip" />
                        <Button loc:Loc.Content="Versions.StopDownloadButton" Command="{x:Bind ViewModel.VersionSwitcher.StopDownloadCommand}"
                                Style="{StaticResource RowAction}"
                                loc:Loc.Tooltip="Versions.StopDownloadButton.Tooltip" />
                    </controls:WrapPanel>
                </controls:CardShell.Footer>
            </controls:CardShell>
        </Grid>

        <controls:PanelSplitter x:Name="SideSplitter" Grid.Row="1" Grid.Column="1" SectionKey="VersionsSideWidth" />
    </Grid>
</Page>
