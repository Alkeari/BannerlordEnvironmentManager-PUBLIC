<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>


    <!-- One destination for "is my setup sound", instead of four screens to hold in the head. Each
         tile is a family of checks, its count, and its color; every tile opens the full page that
         owns the findings, so the evidence stays reachable. -->
    <controls:PageShell TitleKey="Health.Title" Status="{x:Bind ViewModel.HealthSummary, Mode=OneWay}"
                        BlurbKey="Health.Blurb">

        <StackPanel Spacing="0">
            <TextBlock Style="{StaticResource BodyText}" loc:Loc.Text="Health.Intro" />

            <Grid Margin="0,16,0,0" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Click="OnOpenInstallChecks" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Health.InstallChecksButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="InstallChecks.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" Text="{x:Bind ViewModel.InstallChecksCount, Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE7C1;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="0" Grid.Column="1" Click="OnOpenModOverlaps" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Health.ModOverlapsButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Overlaps.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" Text="{x:Bind ViewModel.OverlapsCount, Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE8C4;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="1" Grid.Column="0" Click="OnOpenModSafety" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Health.ModSafetyButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Safety.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" Text="{x:Bind ViewModel.SafetyCount, Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE72E;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="1" Grid.Column="1" Click="OnOpenBootChecks" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Health.BootChecksButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Health.BootChecksButton" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" Text="{x:Bind ViewModel.BootCount, Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE945;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Click="OnOpenValidator" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Health.ValidatorButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Health.ValidatorButton" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" loc:Loc.Text="Health.ValidatorButton.Description" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE73E;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Basic mode only: the Forensics destination is out of the navigation there, and a
                 crashed game must still be one click from its answers. In Advanced this tile is
                 redundant - Forensics owns the crash reports - so it hides rather than repeat it. -->
            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Click="OnOpenCrashReports" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    Visibility="{x:Bind views:PageDensity.Basic(Navigation.IsAdvancedMode), Mode=OneWay}"
                    loc:Loc.Tooltip="Health.CrashReportsButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Diagnostics.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" loc:Loc.Text="Health.CrashReportsButton.Description" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE7BA;" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Grid>

        <Button x:Name="RefreshButton" loc:Loc.Content="Health.RefreshButton" Click="OnRefresh" Style="{StaticResource Action}"
                Margin="0,16,0,0" HorizontalAlignment="Left"
                loc:Loc.Tooltip="Health.RefreshButton.Tooltip" />

        <!-- Every family that shares AcceptedFindingStore, in one place: an install check, a boot check
             result, a mod safety alarm. Read, never erased - Forget is the only way one of these leaves
             this list, and it goes back to counting against its badge the next time that check runs. -->
        <Expander HorizontalAlignment="Stretch" IsExpanded="False" Padding="12,4,12,8" Margin="0,16,0,0"
                  loc:Loc.AutomationName="Health.AcceptedFindings"
                  loc:Loc.Tooltip="Health.AcceptedFindings.Tooltip"
                  Visibility="{x:Bind DiagnosticsViewModel.HasAcceptedFindings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <TextBlock loc:Loc.Text="Health.AcceptedFindings" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" />
            </Expander.Header>
            <ScrollViewer MaxHeight="300" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.AcceptedFindingRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AcceptedFindingRowViewModel">
                            <Grid ColumnSpacing="12" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind CategoryText}" Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind RecordedText}" Style="{StaticResource BodyText}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkMutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" loc:Loc.Content="Health.ForgetButton"
                                        Click="OnForgetAcceptedFindingClicked" Tag="{x:Bind}" VerticalAlignment="Top"
                                        loc:Loc.Tooltip="Health.ForgetButton.Tooltip" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>
        </StackPanel>
    </controls:PageShell>
</Page>
