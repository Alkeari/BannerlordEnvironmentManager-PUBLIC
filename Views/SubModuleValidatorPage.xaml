<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.SubModuleValidatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BannerlordEnvironmentManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:modules="using:BannerlordEnvironmentManager.Core.Modules"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
    </Page.Resources>
    <Grid Padding="20,14,20,16">
        <Grid RowSpacing="12">
            <!-- The modules list and the pane beside it are what this page exists for. What used to
                 take their height was the status line written after a load; it declares a fixed share
                 now, and every other row here is one row of controls that cannot grow, so this row is
                 simply what is left and shrinks smoothly with the window. That is the order these
                 regions give up size in: the controls and the status keep their heights, the list and
                 the pane absorb the difference. A minimum here instead would add to the fixed total,
                 and below it the grid runs off the bottom edge and puts the status where no scrollbar
                 reaches. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader TitleKey="Validator.Title" BlurbKey="Validator.Blurb" />

            <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock loc:Loc.Text="Validator.ModulesPathLabel" Style="{StaticResource LabelText}" />
                    <TextBox Text="{x:Bind ValidatorViewModel.ModulesPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" loc:Loc.Placeholder="Validator.ModulesPath.Placeholder"
                             loc:Loc.Tooltip="Validator.ModulesPath.Tooltip" />
                </StackPanel>
                <Button Grid.Column="1" loc:Loc.Content="Validator.BrowseButton" Command="{x:Bind ValidatorViewModel.BrowseModulesFolderCommand}" Style="{StaticResource Action}" Width="140" VerticalAlignment="Bottom"
                        loc:Loc.Tooltip="Validator.BrowseButton.Tooltip" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Update All Dependency Versions used to sit directly after Load Modules and is in
                     the outer ring now (DevRing\DeveloperSurfaces.cs), which puts it back there.
                     Rewriting the version another author declared silences the launcher's
                     compatibility check without changing whether the mod works; Widen Wildcard
                     Versions and both restores keep the declaration true and stay in every build. -->
                <!-- Four buttons and a ring, about 820 px that cannot shrink, on a page with no sideways
                     scrolling anywhere: below that width Restore Lost Elements simply sat past the right edge
                     with no bar able to reach it. The row scrolls inside its own container now, which is the
                     only scroller on this axis anywhere on the page. -->
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ValidatorActions" x:FieldModifier="internal" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="LoadModulesButton" x:FieldModifier="internal"
                                loc:Loc.Content="Validator.LoadModulesButton" Command="{x:Bind ValidatorViewModel.LoadModulesCommand}" Style="{StaticResource PrimaryAction}" Width="160"
                                loc:Loc.Tooltip="Validator.LoadModulesButton.Tooltip" />
                        <Button loc:Loc.Content="Validator.WidenWildcardVersionsButton" Command="{x:Bind ValidatorViewModel.WidenWildcardVersionsCommand}" Style="{StaticResource Action}" MinWidth="200"
                                loc:Loc.Tooltip="Validator.WidenWildcardVersionsButton.Tooltip" />
                        <Button loc:Loc.Content="Validator.RestoreBackupsButton" Command="{x:Bind ValidatorViewModel.RestoreBackupsCommand}" Style="{StaticResource Action}" MinWidth="160"
                                loc:Loc.Tooltip="Validator.RestoreBackupsButton.Tooltip" />
                        <Button loc:Loc.Content="Validator.RestoreLostElementsButton" Command="{x:Bind ValidatorViewModel.RestoreLostElementsCommand}" Style="{StaticResource Action}" MinWidth="190"
                                loc:Loc.Tooltip="Validator.RestoreLostElementsButton.Tooltip" />
                        <ProgressRing IsActive="{x:Bind ValidatorViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBlock loc:Loc.Text="Validator.GameVersionLabel" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ValidatorViewModel.GameVersion, Mode=OneWay}" Style="{StaticResource SubHeadingText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock loc:Loc.Text="Validator.InstalledModulesLabel" Style="{StaticResource SubHeadingText}" Margin="0,0,0,8" />

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ValidatorViewModel.Modules}" SelectedItem="{x:Bind ValidatorViewModel.SelectedModule, Mode=TwoWay}" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="modules:ModuleManifest">
                                    <!-- Selecting a row is how a module's manifest is shown beside the list,
                                         so its text opts out. The detail pane's text stays selectable. -->
                                    <StackPanel Spacing="4" Padding="8">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubHeadingText}" IsTextSelectionEnabled="False" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Version.ToString()}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                                            <TextBlock Text="{x:Bind Origin.ToString()}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <Grid>
                        <!-- The selected module block declares its share instead of measuring itself:
                             it appears only once a module is picked, and as an Auto row it took that
                             height out of the dependencies below it, so choosing a module shrank the
                             pane that exists to describe the module you chose. 27 for the name, 4, 22
                             for the version, 8, 32 for the button and 12 of margin come to 105,
                             rounded to the grid. The order this pane gives up size in follows from
                             that: the heading and the block keep their heights, the dependencies
                             absorb the difference and scroll inside whatever is left. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="108" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock loc:Loc.Text="Validator.ModuleDetailsLabel" Style="{StaticResource SubHeadingText}" Margin="0,0,0,8" />

                        <!-- Update This Module's Versions used to sit directly under this module's name
                             and version and is in the outer ring now (DevRing\DeveloperSurfaces.cs),
                             which puts it back there, for the same reason Update All is. -->
                        <StackPanel x:Name="ModuleDetailActions" x:FieldModifier="internal" Grid.Row="1" Spacing="8" Margin="0,0,0,12" Visibility="{x:Bind ValidatorViewModel.SelectedModule, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}">
                            <StackPanel x:Name="SelectedModuleHeadings" x:FieldModifier="internal" Spacing="4">
                                <TextBlock Text="{x:Bind ValidatorViewModel.SelectedModule.Name, Mode=OneWay}" Style="{StaticResource HeadingText}" />
                                <TextBlock Text="{x:Bind ValidatorViewModel.SelectedModule.Version.ToString(), Mode=OneWay}" Style="{StaticResource SubHeadingText}" />
                            </StackPanel>
                            <Button loc:Loc.Content="Validator.RestoreModuleLostElementsButton" Command="{x:Bind ValidatorViewModel.RestoreSelectedModuleLostElementsCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left"
                                    loc:Loc.Tooltip="Validator.RestoreModuleLostElementsButton.Tooltip" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="2">
                            <StackPanel Spacing="8">
                                <TextBlock loc:Loc.Text="Validator.DependenciesLabel" Style="{StaticResource SubHeadingText}" />
                                <ItemsControl ItemsSource="{x:Bind ValidatorViewModel.SelectedModuleDependencies, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="modules:ModuleDependency">
                                            <Border Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="8" CornerRadius="0" Margin="0,0,0,8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Bind TargetId.Value}" Style="{StaticResource SubHeadingText}" />
                                                    <TextBlock Text="{x:Bind Describe()}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Fixed height on purpose. The line is written after a load or a fix, which is when
                 the list above it is fullest, and each message is a different length, so a label that
                 sized to its own text took that height out of the list. Two lines, then the ellipsis,
                 and the whole message on the hover. -->
            <Grid Grid.Row="4" Height="40" Margin="0,8,0,0">
                <TextBlock Text="{x:Bind ValidatorViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                           ToolTipService.ToolTip="{x:Bind ValidatorViewModel.StatusMessage, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
