<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.DiagnosticFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />

        <!-- A capture row carries its own two buttons, because a capture the product lists and cannot
             open or get rid of is half a feature. -->
        <DataTemplate x:Key="CaptureRow" x:DataType="vm:KnownIssueRowViewModel">
            <Border Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Heading}" />
                    <TextBlock Text="{x:Bind DetailAndNote}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ItemsControl ItemsSource="{x:Bind Actions}"
                                  Visibility="{x:Bind Actions.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KnownIssueActionViewModel">
                                <Button Content="{x:Bind Label}" Command="{x:Bind Command}" CommandParameter="{x:Bind Parameter}"
                                        Style="{StaticResource Action}" Margin="0,6,0,0"
                                        ToolTipService.ToolTip="{x:Bind Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20,14,20,16">
        <Grid RowSpacing="12">
            <!-- The batches and the captures beside them are what this page exists for. What used to
                 take their height was the footer, which is written after a scan or a clear and sized
                 itself to a folder list several paths long; it declares a fixed share now, so this row
                 is simply what is left and shrinks smoothly with the window. That is the order these
                 regions give up size in: the footer keeps its height, the lists absorb the difference.
                 A minimum here instead would add to the fixed total, and below it the grid runs off the
                 bottom edge and puts the footer where no scrollbar reaches. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader TitleKey="Files.Title" BlurbKey="Files.Blurb">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button loc:Loc.Content="Files.ScanButton" Command="{x:Bind DiagnosticsViewModel.ScanLogsAndCrashReportsCommand}" Style="{StaticResource PrimaryAction}" MinWidth="240"
                            loc:Loc.Tooltip="Files.ScanButton.Tooltip" />
                    <ProgressRing IsActive="{x:Bind DiagnosticsViewModel.IsBusy, Mode=OneWay}" Width="28" Height="28" />

                    <DropDownButton loc:Loc.Content="Files.ClearFilesButton" Style="{StaticResource Action}" MinWidth="140"
                                    loc:Loc.Tooltip="Files.ClearFilesButton.Tooltip">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem loc:Loc.Text="Files.ClearLogsMenuItem" Command="{x:Bind DiagnosticsViewModel.ClearLogsCommand}"
                                                loc:Loc.Tooltip="Files.ClearLogsMenuItem.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Files.ClearCrashReportsMenuItem" Command="{x:Bind DiagnosticsViewModel.ClearCrashReportsCommand}"
                                                loc:Loc.Tooltip="Files.ClearCrashReportsMenuItem.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Files.ClearBothMenuItem" Command="{x:Bind DiagnosticsViewModel.ClearLogsAndCrashReportsCommand}"
                                                loc:Loc.Tooltip="Files.ClearBothMenuItem.Tooltip" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem loc:Loc.Text="Files.ClearCapturesMenuItem" Command="{x:Bind DiagnosticsViewModel.ClearCapturesCommand}"
                                                loc:Loc.Tooltip="Files.ClearCapturesMenuItem.Tooltip" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock Text="{x:Bind DiagnosticsViewModel.GameInstallPath, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                               Foreground="{StaticResource AlkSteelGrayBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                               loc:Loc.Tooltip="Files.InstallPathText.Tooltip" />
                </StackPanel>
            </controls:PageHeader>


            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The other half of Clear Files, and deliberately beside it: a clear that cannot be
                     undone from where it was done is a backup with no restore. -->
                <Border Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <!-- The same defect one level in: the heading row above these lists carries the
                             blurb and the line reporting what a clear did, and sized to their own text
                             they took their height out of both lists. Both are held to two lines now,
                             and the rows between and under the lists are single rows of controls, so
                             the two lists are what is left and share it evenly. That is the order this
                             column gives up size in: the headings, buttons and status keep their
                             heights, the lists absorb the difference. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock loc:Loc.Text="Files.ClearedBatchesHeading" Style="{StaticResource SubHeadingText}"
                                       loc:Loc.Tooltip="Files.ClearedBatchesHeading.Tooltip" />
                            <!-- Held to two lines for the reason the status under it is: it sits in the
                                 heading row above two lists, and narrowing the window re-wraps it onto
                                 more lines, each one taken from the lists. The whole of it is on the
                                 hover. -->
                            <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                       loc:Loc.Text="Files.ClearedBatchesHeading.Blurb"
                                       loc:Loc.Tooltip="Files.ClearedBatchesHeading.Blurb" />
                            <!-- Held to two lines, with the whole of it on the hover. It is written by
                                 the clear that fills the list under it, so sized to its own text it
                                 grew at the one moment that list had the most to show. -->
                            <TextBlock Text="{x:Bind DiagnosticsViewModel.ClearedStoreStatus, Mode=OneWay}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                       ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.ClearedStoreStatus, Mode=OneWay}"
                                       Visibility="{x:Bind DiagnosticsViewModel.ClearedStoreStatus, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind DiagnosticsViewModel.ClearedBatches}"
                                  SelectedItem="{x:Bind DiagnosticsViewModel.SelectedClearedBatch, Mode=TwoWay}"
                                  SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  ContextRequested="OnClearedBatchContextRequested">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem loc:Loc.Text="Files.CopyBatchRowMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyClearedBatchCommand}"
                                                    loc:Loc.Tooltip="Files.CopyBatchRowMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Files.CopyBatchPathMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyClearedBatchPathCommand}"
                                                    loc:Loc.Tooltip="Files.CopyBatchPathMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Files.CopyBatchOriginsMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyClearedBatchOriginsCommand}"
                                                    loc:Loc.Tooltip="Files.CopyBatchOriginsMenuItem.Tooltip" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClearedBatchRowViewModel">
                                    <!-- Selecting a batch is what the buttons below act on, so its text opts out.
                                         The handler here is the half that cannot be skipped: ContextRequested
                                         bubbles, so the one on the list runs only if nothing in between marked
                                         the event handled, while the framework shows the flyout either way. -->
                                    <StackPanel Spacing="1" Padding="2" Background="Transparent"
                                                ContextRequested="OnClearedBatchRowContextRequested">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind Origins}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="False" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- The three buttons come to about 520 px of text and padding and none of them shrinks, so
                             a narrow window put Refresh the List past the right edge of a column that only scrolls
                             vertically. Sideways inside its own container instead; the two scrollers share no axis. -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button loc:Loc.Content="Files.RestoreBatchButton" Command="{x:Bind DiagnosticsViewModel.RestoreClearedBatchCommand}" Style="{StaticResource PrimaryAction}"
                                        loc:Loc.Tooltip="Files.RestoreBatchButton.Tooltip" />
                                <Button loc:Loc.Content="Files.DeleteBatchButton" Command="{x:Bind DiagnosticsViewModel.DiscardClearedBatchCommand}" Style="{StaticResource DangerAction}"
                                        loc:Loc.Tooltip="Files.DeleteBatchButton.Tooltip" />
                                <Button loc:Loc.Content="Files.RefreshListButton" Command="{x:Bind DiagnosticsViewModel.ListClearedBatchesCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Files.RefreshListButton.Tooltip" />
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Grid.Row="3" loc:Loc.Text="Files.SelectedBatchHeading" Style="{StaticResource SubHeadingText}"
                                   loc:Loc.Tooltip="Files.SelectedBatchHeading.Tooltip" />

                        <ListView Grid.Row="4" ItemsSource="{x:Bind DiagnosticsViewModel.ClearedBatchFiles}"
                                  SelectedItem="{x:Bind DiagnosticsViewModel.SelectedClearedFile, Mode=TwoWay}"
                                  SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  ContextRequested="OnClearedFileContextRequested">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem loc:Loc.Text="Files.CopyFileRowMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyClearedFileCommand}"
                                                    loc:Loc.Tooltip="Files.CopyFileRowMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Files.CopyFileOriginMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyClearedFileOriginCommand}"
                                                    loc:Loc.Tooltip="Files.CopyFileOriginMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Files.CopyFileStoredPathMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyClearedFileStoredPathCommand}"
                                                    loc:Loc.Tooltip="Files.CopyFileStoredPathMenuItem.Tooltip" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClearedFileRowViewModel">
                                    <!-- Selecting a file is what Restore acts on, so its text opts out. The
                                         handler here is the half that cannot be skipped, for the same reason
                                         as the batch list above. -->
                                    <StackPanel Spacing="1" Padding="2" Background="Transparent"
                                                ContextRequested="OnClearedFileRowContextRequested">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind Origin}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="False" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="5" loc:Loc.Content="Files.RestoreFileButton" Command="{x:Bind DiagnosticsViewModel.RestoreClearedFileCommand}" Style="{StaticResource Action}"
                                HorizontalAlignment="Left"
                                loc:Loc.Tooltip="Files.RestoreFileButton.Tooltip" />
                    </Grid>
                </Border>

                <!-- The game's own uploader deletes its crash folder once it has sent it, so these
                     copies are usually the only surviving record. -->
                <Border Grid.Column="1" Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock loc:Loc.Text="Files.CapturesHeading" Style="{StaticResource SubHeadingText}"
                                           loc:Loc.Tooltip="Files.CapturesHeading.Tooltip" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}"
                                           loc:Loc.Text="Files.CapturesHeading.Blurb" />
                                <TextBlock Text="{x:Bind DiagnosticsViewModel.CapturesSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- One crash on this install left 844 MB behind, and nothing showed the user
                                 that number or let them act on it. Both live here now. -->
                            <Border Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0">
                                <StackPanel Spacing="8">
                                    <TextBlock loc:Loc.Text="Files.RetentionHeading" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Files.RetentionHeading.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.RetentionSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <!-- An emptied box sets its own Value to NaN whatever the
                                             validation mode says, and this once persisted "keep 1" from
                                             one backspace. The binding is a double now, so NaN reaches
                                             the settings intact and is refused there. The refusal puts
                                             back the number already in force, which is no change and so
                                             repaints nothing, so OnRetentionLimitLostFocus writes the
                                             figure into the box by hand rather than leaving the user
                                             looking at a blank limit. -->
                                        <NumberBox x:Name="KeepCapturesBox" loc:Loc.Header="Files.KeepCapturesBox.Header" Minimum="1" Maximum="500" SpinButtonPlacementMode="Compact"
                                                   ValidationMode="InvalidInputOverwritten"
                                                   Value="{x:Bind DiagnosticsViewModel.KeepCaptures, Mode=TwoWay}"
                                                   LostFocus="OnRetentionLimitLostFocus"
                                                   MinWidth="150"
                                                   loc:Loc.Tooltip="Files.KeepCapturesBox.Tooltip" />
                                        <NumberBox x:Name="KeepDumpsBox" loc:Loc.Header="Files.KeepDumpsBox.Header" Minimum="0" Maximum="500" SpinButtonPlacementMode="Compact"
                                                   ValidationMode="InvalidInputOverwritten"
                                                   Value="{x:Bind DiagnosticsViewModel.KeepDumps, Mode=TwoWay}"
                                                   LostFocus="OnRetentionLimitLostFocus"
                                                   MinWidth="240"
                                                   loc:Loc.Tooltip="Files.KeepDumpsBox.Tooltip" />
                                    </StackPanel>
                                    <Button loc:Loc.Content="Files.PruneButton" Command="{x:Bind DiagnosticsViewModel.PruneCapturesCommand}" Style="{StaticResource Action}"
                                            HorizontalAlignment="Left"
                                            loc:Loc.Tooltip="Files.PruneButton.Tooltip" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.Captures}" ItemTemplate="{StaticResource CaptureRow}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Fixed height on purpose, and it keeps that height whether or not the scan has run: two
                 lines for the outcome and two for the folders it read, each trimmed with the whole of
                 it on the hover. Sized to their own text, a folder list several paths long took every
                 one of those lines out of the lists above. -->
            <Grid Grid.Row="2" Height="84" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind DiagnosticsViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                           IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.StatusMessage, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Text="{x:Bind DiagnosticsViewModel.SearchedFolders, Mode=OneWay}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                           IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}"
                           ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.SearchedFolders, Mode=OneWay}"
                           Visibility="{x:Bind DiagnosticsViewModel.SearchedFolders, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
