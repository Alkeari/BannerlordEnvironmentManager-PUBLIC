<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="ModuleRow" x:DataType="vm:CrashModuleRowViewModel">
            <Border Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Heading}" />
                    <TextBlock Text="{x:Bind Evidence}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One member of a candidate set. No rank, no badge and nothing that could be read as an
             ordering: the position is here to find the module in a load order of 242. -->
        <DataTemplate x:Key="CandidateRow" x:DataType="vm:CandidateRowViewModel">
            <StackPanel Spacing="2" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind Position}" Style="{StaticResource BodyText}" FontFamily="Consolas" MinWidth="52"
                               IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}" />
                    <TextBlock Text="{x:Bind ModuleId}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
                <TextBlock Text="{x:Bind Corroboration}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Margin="62,0,0,0" Foreground="{StaticResource AlkSteelGrayBrush}"
                           Visibility="{x:Bind Corroboration, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NoteRow" x:DataType="x:String">
            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,6" />
        </DataTemplate>

        <!-- A Windows minidump, read rather than counted. The stack is shown whole, including the
             frames the dump does not carry, because a hole in it is why an answer stops short. -->
        <DataTemplate x:Key="CrashDumpRow" x:DataType="vm:CrashDumpRowViewModel">
            <Border Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Written}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkWarmGoldShadowBrush}" />
                    <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Attribution}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkWarmGoldShadowBrush}" />
                    <ItemsControl ItemsSource="{x:Bind Frames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind Path}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkWarmGoldShadowBrush}" />
                    <Button loc:Loc.Content="Diagnostics.CrashDumpRow.RemoveButton" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Command="{x:Bind RemoveCommand}" CommandParameter="{x:Bind Path}"
                            loc:Loc.Tooltip="Diagnostics.CrashDumpRow.RemoveButton.Tooltip" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- One crash folder the game wrote, read as one crash report. Everything on it is selectable:
             the code, the address and the two module lists exist to be pasted somewhere else. -->
        <DataTemplate x:Key="GameCrashFolderRow" x:DataType="vm:GameCrashFolderRowViewModel">
            <Border Background="{StaticResource AlkBackgroundBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind When}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkWarmGoldShadowBrush}" />
                    <TextBlock Text="{x:Bind Code}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind Code, Converter={StaticResource NullOrEmptyToVisibility}}"
                               loc:Loc.Tooltip="Diagnostics.GameCrashFolderRow.Code.Tooltip" />
                    <TextBlock Text="{x:Bind Meaning}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind Meaning, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Text="{x:Bind RunTime}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind RunTime, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Text="{x:Bind Boundary}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,0"
                              Visibility="{x:Bind HadInitializedHeading, Converter={StaticResource NullOrEmptyToVisibility}}"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <Expander.Header>
                            <TextBlock Text="{x:Bind HadInitializedHeading}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                       loc:Loc.Tooltip="Diagnostics.GameCrashFolderRow.HadInitializedExpander.Tooltip" />
                        </Expander.Header>
                        <TextBlock Text="{x:Bind HadInitialized}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,8,0,0"
                                   Foreground="{StaticResource AlkSteelGrayBrush}" />
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Visibility="{x:Bind NotObservedHeading, Converter={StaticResource NullOrEmptyToVisibility}}"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <Expander.Header>
                            <TextBlock Text="{x:Bind NotObservedHeading}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                       loc:Loc.Tooltip="Diagnostics.GameCrashFolderRow.NotObservedExpander.Tooltip" />
                        </Expander.Header>
                        <TextBlock Text="{x:Bind NotObserved}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,8,0,0" />
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <Expander.Header>
                            <TextBlock loc:Loc.Text="Diagnostics.GameCrashFolderRow.StackExpander.Header" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                       loc:Loc.Tooltip="Diagnostics.GameCrashFolderRow.StackExpander.Tooltip" />
                        </Expander.Header>
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{x:Bind Stack}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind Artifacts}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource AlkSteelGrayBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{x:Bind Path}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                        <Button loc:Loc.Content="Diagnostics.GameCrashFolderRow.OpenFolderButton" Style="{StaticResource Action}"
                                Command="{x:Bind OpenCommand}" CommandParameter="{x:Bind}"
                                loc:Loc.Tooltip="Diagnostics.GameCrashFolderRow.OpenFolderButton.Tooltip" />
                        <Button loc:Loc.Content="Diagnostics.GameCrashFolderRow.CopyButton" Style="{StaticResource Action}"
                                Command="{x:Bind CopyCommand}" CommandParameter="{x:Bind}"
                                loc:Loc.Tooltip="Diagnostics.GameCrashFolderRow.CopyButton.Tooltip" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One occurrence of a fault, and every other view of that same event. A join made on the
             process id and a join made on the clock are shown apart, because only one of them is a
             fact. What lined up with nothing is listed too: a fault with no dump is a real state and
             has to read differently from no fault at all. -->
        <DataTemplate x:Key="WindowsFaultRecordRow" x:DataType="vm:WindowsFaultRecordRowViewModel">
            <StackPanel Spacing="2" Margin="0,0,0,10">
                <TextBlock Text="{x:Bind When}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}" />
                <ItemsControl ItemsSource="{x:Bind Evidence}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{x:Bind Gaps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- One crash signature. The code and the offset get a line of their own because they exist to
             be pasted into a search, and burying them in a sentence makes that a retyping job. -->
        <DataTemplate x:Key="WindowsFaultRow" x:DataType="vm:WindowsFaultRowViewModel">
            <Border Background="{StaticResource AlkBackgroundBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Code}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind Code, Converter={StaticResource NullOrEmptyToVisibility}}"
                               loc:Loc.Tooltip="Diagnostics.WindowsFaultRow.Code.Tooltip" />
                    <TextBlock Text="{x:Bind Meaning}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind Meaning, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Text="{x:Bind Offset}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind Offset, Converter={StaticResource NullOrEmptyToVisibility}}"
                               loc:Loc.Tooltip="Diagnostics.WindowsFaultRow.Offset.Tooltip" />
                    <TextBlock Text="{x:Bind Occurrences}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkWarmGoldShadowBrush}" />
                    <TextBlock Text="{x:Bind Source}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}" />

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,0"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <Expander.Header>
                            <TextBlock loc:Loc.Text="Diagnostics.WindowsFaultRow.OccurrencesExpander.Header" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                       loc:Loc.Tooltip="Diagnostics.WindowsFaultRow.OccurrencesExpander.Tooltip" />
                        </Expander.Header>
                        <ItemsControl ItemsSource="{x:Bind Records}" ItemTemplate="{StaticResource WindowsFaultRecordRow}" Margin="0,8,0,0" />
                    </Expander>

                    <Button loc:Loc.Content="Diagnostics.WindowsFaultRow.CopyButton" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Command="{x:Bind CopyCommand}" CommandParameter="{x:Bind}"
                            loc:Loc.Tooltip="Diagnostics.WindowsFaultRow.CopyButton.Tooltip" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20,14,20,16">
        <Grid RowSpacing="12">
            <!-- The reports list and the report beside it are what this page exists for. What used to
                 take their height was the footer, which is written after a scan and sized itself to a
                 folder list several paths long; it declares a fixed share now, so this row is simply
                 what is left and shrinks smoothly with the window. That is the order these regions give
                 up size in: the footer keeps its height, the lists absorb the difference. A minimum
                 here instead would add to the fixed total, and below it the grid runs off the bottom
                 edge and puts the footer where no scrollbar reaches. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader TitleKey="Diagnostics.Title" BlurbKey="Diagnostics.Blurb">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button loc:Loc.Content="Diagnostics.ScanButton" Command="{x:Bind DiagnosticsViewModel.ScanLogsAndCrashReportsCommand}" Style="{StaticResource PrimaryAction}" MinWidth="240"
                            loc:Loc.Tooltip="Diagnostics.ScanButton.Tooltip" />
                    <ProgressRing IsActive="{x:Bind DiagnosticsViewModel.IsBusy, Mode=OneWay}" Width="28" Height="28" />
                    <TextBlock Text="{x:Bind DiagnosticsViewModel.GameInstallPath, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                               Foreground="{StaticResource AlkSteelGrayBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                               loc:Loc.Tooltip="Diagnostics.GameInstallPath.Tooltip" />
                </StackPanel>
            </controls:PageHeader>


            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock loc:Loc.Text="Diagnostics.ReportsListSection" Style="{StaticResource SubHeadingText}"
                                   loc:Loc.Tooltip="Diagnostics.ReportsListSection.Tooltip" />

                        <ListView Grid.Row="1" ItemsSource="{x:Bind DiagnosticsViewModel.Reports}" SelectedItem="{x:Bind DiagnosticsViewModel.SelectedReport, Mode=TwoWay}" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  ContextRequested="OnReportContextRequested">
                            <!-- The flyout lives on the list rather than in the item template so its items
                                 can bind the page view model. Which row it applies to is recorded on the
                                 way up, the same way the Play tab does it. -->
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem loc:Loc.Text="Diagnostics.OpenInEditorMenuItem" Command="{x:Bind DiagnosticsViewModel.OpenReportCommand}"
                                                    loc:Loc.Tooltip="Diagnostics.OpenInEditorMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Diagnostics.ShowInFolderMenuItem" Command="{x:Bind DiagnosticsViewModel.ShowReportInFolderCommand}"
                                                    loc:Loc.Tooltip="Diagnostics.ShowInFolderMenuItem.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Diagnostics.CopyPathMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyReportPathCommand}"
                                                    loc:Loc.Tooltip="Diagnostics.CopyPathMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Diagnostics.CopyFindingsMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyReportFindingsCommand}"
                                                    loc:Loc.Tooltip="Diagnostics.CopyFindingsMenuItem.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Diagnostics.ClearReportMenuItem" Command="{x:Bind DiagnosticsViewModel.ClearReportCommand}"
                                                    loc:Loc.Tooltip="Diagnostics.ClearReportMenuItem.Tooltip" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CrashReportRowViewModel">
                                    <!-- Selecting a row is how a report is opened, so its text opts out of
                                         selection. The row's context menu is what copies it. -->
                                    <StackPanel Spacing="4" Padding="8" Background="Transparent"
                                                ContextRequested="OnReportRowContextRequested">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="False" ToolTipService.ToolTip="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Written}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind Verdict}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind Occurrences}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}" IsTextSelectionEnabled="False" Visibility="{x:Bind Occurrences, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <!-- The only scroller in this column, and the only one on either axis. Anything inside
                         it that scrolled sideways would steal the wheel from it. -->
                    <ScrollViewer x:Name="DetailScroller" x:FieldModifier="internal"
                                  HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailColumn" x:FieldModifier="internal" Spacing="16">
                            <!-- Scrolling sideways measures the content against an unbounded width, which stops
                                 every wrapping paragraph from wrapping. Only the decompiled source wants that
                                 width, so the prose is held to the viewport and the source is not. -->
                            <!-- Said once, where the verdict would be. Seven section headings drawn
                                 against no selected report read as a page that looked and found
                                 nothing, which is the opposite of what is true before one is picked. -->
                            <TextBlock Text="{x:Bind DiagnosticsViewModel.NoReportSelectedText, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource AlkSteelGrayBrush}"
                                       Visibility="{x:Bind DiagnosticsViewModel.NoReportSelectedText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

                            <StackPanel x:Name="ReportDetail" x:FieldModifier="internal" Spacing="16" HorizontalAlignment="Left"
                                        MaxWidth="{x:Bind DetailScroller.ViewportWidth, Mode=OneWay}"
                                        Visibility="{x:Bind DiagnosticsViewModel.HasSelectedReport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Bind DiagnosticsViewModel.Headline, Mode=OneWay}" Style="{StaticResource HeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.Headline, Mode=OneWay}" />

                                <!-- The reasoning behind the headline, and on a refusal the list of things
                                     that stopped an answer. Without it an honest "BEM cannot identify a mod"
                                     reads as the feature failing rather than the feature working. -->
                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="Diagnostics.VerdictSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.VerdictSection.Tooltip" />
                                    <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.VerdictDetail}" ItemTemplate="{StaticResource NoteRow}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="Diagnostics.WhatThrewSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.WhatThrewSection.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.WhatThrew, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="Diagnostics.SuspectsSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.SuspectsSection.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.SuspectsEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind DiagnosticsViewModel.SuspectsEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                    <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.Suspects}" ItemTemplate="{StaticResource ModuleRow}" />
                                </StackPanel>

                                <!-- The set this crash narrows to. It sits under the ranked suspects
                                     and stays a separate section, because a suspect is ranked and a
                                     member of this set is not, and merging the two would let one of
                                     these names be read as the strongest in the report.

                                     Absent when there is nothing to narrow, rather than an empty
                                     panel taking space on the page. -->
                                <StackPanel Spacing="6"
                                            Visibility="{x:Bind DiagnosticsViewModel.HasNarrowing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Diagnostics.NarrowingSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.NarrowingSection.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingHeadline, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{StaticResource AlkAlertAmberBrush}" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingNecessity, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                    <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.Candidates}" ItemTemplate="{StaticResource CandidateRow}" Margin="0,4,0,0" />

                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingSetIds, Mode=OneWay}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{StaticResource AlkSteelGrayBrush}"
                                               loc:Loc.Tooltip="Diagnostics.NarrowingSetIds.Tooltip" />

                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                        <Button loc:Loc.Content="Diagnostics.CopySetButton" Command="{x:Bind DiagnosticsViewModel.CopyCandidateSetCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Diagnostics.CopySetButton.Tooltip" />
                                    </StackPanel>

                                    <!-- The test that turns a set into a proof, next to the set it
                                         tests. Not who, but where. -->
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingContainment, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Margin="0,4,0,0" />

                                    <!-- Everything behind the disclosure is detail the reader asked
                                         for: the arithmetic, what was ruled out, and the limits. -->
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <Expander.Header>
                                            <TextBlock loc:Loc.Text="Diagnostics.NarrowingMechanismExpander.Header" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                                       loc:Loc.Tooltip="Diagnostics.NarrowingMechanismExpander.Tooltip" />
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingMechanism, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingBoundaryFact, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.NarrowingSteps}" ItemTemplate="{StaticResource NoteRow}" />
                                            <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingPromotion, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind DiagnosticsViewModel.NarrowingDisproof, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.NarrowingCaveats}" ItemTemplate="{StaticResource NoteRow}" />
                                            <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.NarrowingRuledOut}" ItemTemplate="{StaticResource NoteRow}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <!-- The caveat travels with the delivery: every band a registry rule
                                     produced is only as good as the registry it read, so what this
                                     report was analyzed against is stated beside the ranking. -->
                                <StackPanel Spacing="6"
                                            Visibility="{x:Bind DiagnosticsViewModel.PatchRegistryStatusText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}">
                                    <TextBlock loc:Loc.Text="Diagnostics.PatchRegistrySection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.PatchRegistrySection.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.PatchRegistryStatusText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                    <!-- The names, folded away. They are needed and they are not needed
                                         all at once in the sentence above. -->
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              Visibility="{x:Bind DiagnosticsViewModel.PatchRegistryDetailsText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}"
                                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <Expander.Header>
                                            <TextBlock loc:Loc.Text="Diagnostics.PatchRegistryDetailsExpander.Header" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                                       loc:Loc.Tooltip="Diagnostics.PatchRegistryDetailsExpander.Tooltip" />
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Text="{x:Bind DiagnosticsViewModel.PatchRegistryDetailsText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <Button loc:Loc.Content="Diagnostics.CopyModuleNamesButton" Command="{x:Bind DiagnosticsViewModel.CopyPatchRegistryDetailsCommand}" Style="{StaticResource Action}"
                                                    HorizontalAlignment="Left"
                                                    loc:Loc.Tooltip="Diagnostics.CopyModuleNamesButton.Tooltip" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- The safety net sits where the danger is: a stale or missing registry is
                                         named here, and the thing that fixes it is the next control. -->
                                    <Button loc:Loc.Content="Diagnostics.RefreshPatchRegistryButton" Command="{x:Bind DiagnosticsViewModel.RefreshPatchRegistryCommand}" Style="{StaticResource Action}"
                                            HorizontalAlignment="Left"
                                            Visibility="{x:Bind DiagnosticsViewModel.PatchRegistryNeedsRefresh, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            loc:Loc.Tooltip="Diagnostics.RefreshPatchRegistryButton.Tooltip" />

                                    <!-- What the last press of that button did. A run that started and
                                         captured nothing says so here rather than leaving the panel
                                         looking untouched. -->
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.PatchRegistryCaptureOutcomeText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{StaticResource AlkSteelGrayBrush}"
                                               Visibility="{x:Bind DiagnosticsViewModel.PatchRegistryCaptureOutcomeText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="Diagnostics.NotSuspectedSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.NotSuspectedSection.Tooltip" />
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}"
                                               loc:Loc.Text="Diagnostics.NotSuspectedBlurb" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.NotSuspectedEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind DiagnosticsViewModel.NotSuspectedEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                    <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.NotSuspected}" ItemTemplate="{StaticResource ModuleRow}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="Diagnostics.ClearedSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.ClearedSection.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.ClearedEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind DiagnosticsViewModel.ClearedEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                    <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.Cleared}" ItemTemplate="{StaticResource NoteRow}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="Diagnostics.UnknownsSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.UnknownsSection.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.UnknownsEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind DiagnosticsViewModel.UnknownsEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                    <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.Unknowns}" ItemTemplate="{StaticResource NoteRow}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="Diagnostics.NextStepSection" Style="{StaticResource SubHeadingText}"
                                               loc:Loc.Tooltip="Diagnostics.NextStepSection.Tooltip" />
                                    <TextBlock Text="{x:Bind DiagnosticsViewModel.NextStep, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button loc:Loc.Content="Diagnostics.OpenBootChecksButton" Click="OnOpenBootChecks" Style="{StaticResource Action}" HorizontalAlignment="Left"
                                            loc:Loc.Tooltip="Diagnostics.OpenBootChecksButton.Tooltip" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Read the Compiled Method used to sit here as an Expander: the blurb, the
                                 frame dropdown, the buttons, the status line and the source panel. The
                                 whole of it is in the outer ring now (DevRing\DeveloperSurfaces.cs),
                                 which builds it and puts it back directly after this section, because
                                 nothing in it can be filled without a decompiler and a screen that
                                 cannot be filled is not a feature. The crash reading itself, the ranked
                                 suspects and the frame attribution behind them are unchanged and stay
                                 in every build. It goes back directly after ReportDetail above. -->

                            <!-- What the game itself wrote. A crash report from the game is not a file,
                                 it is a dated folder of artifacts, and reading that folder file by file
                                 found nothing in a complete crash and reported that nothing was found.

                                 Open by default, because on a run that just crashed this is the whole
                                 answer and it should not be behind a click. -->
                            <!-- Everything on this machine that is not the selected report: the game's own crash
                                 folder, what Windows logged, the dumps Windows kept, and contributing one
                                 upward. Four sibling Expanders put all four headers on screen at once and
                                 opened three of them; the picker shows the one being read. -->
                            <Border Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}"
                                    BorderThickness="1" CornerRadius="0" Padding="12">
                                <StackPanel Spacing="10">
                                <SelectorBar x:Name="EvidencePicker" SelectionChanged="OnCrashEvidenceSelected">
                                    <SelectorBarItem loc:Loc.Text="Diagnostics.EvidenceGameItem" Tag="EvidenceGame" IsSelected="True"
                                                     loc:Loc.Tooltip="Diagnostics.EvidenceGameItem.Tooltip" />
                                    <SelectorBarItem loc:Loc.Text="Diagnostics.EvidenceWindowsItem" Tag="EvidenceWindows"
                                                     loc:Loc.Tooltip="Diagnostics.EvidenceWindowsItem.Tooltip" />
                                    <SelectorBarItem loc:Loc.Text="Diagnostics.EvidenceDumpsItem" Tag="EvidenceDumps"
                                                     loc:Loc.Tooltip="Diagnostics.EvidenceDumpsItem.Tooltip" />
                                    <SelectorBarItem loc:Loc.Text="Diagnostics.EvidenceContributeItem" Tag="EvidenceContribute"
                                                     loc:Loc.Tooltip="Diagnostics.EvidenceContributeItem.Tooltip" />
                                </SelectorBar>

                                <StackPanel x:Name="EvidenceGame" Spacing="10">
                                        <StackPanel Spacing="10" Margin="0,8,0,0"
                                                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="10" HorizontalAlignment="Left"
                                                        MaxWidth="{x:Bind DetailScroller.ViewportWidth, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind DiagnosticsViewModel.GameCrashFoldersStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Visibility="{x:Bind DiagnosticsViewModel.GameCrashFoldersStatus, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{StaticResource AlkAlertAmberBrush}"
                                                           loc:Loc.Text="Diagnostics.LoadOrderProgressBlurb" />

                                                <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.GameCrashFolderRows}" ItemTemplate="{StaticResource GameCrashFolderRow}" />
                                            </StackPanel>
                                        </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="EvidenceWindows" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="10" Margin="0,8,0,0"
                                                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="10" HorizontalAlignment="Left"
                                                        MaxWidth="{x:Bind DetailScroller.ViewportWidth, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind DiagnosticsViewModel.WindowsFaultsStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Visibility="{x:Bind DiagnosticsViewModel.WindowsFaultsStatus, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                                <TextBlock Text="{x:Bind DiagnosticsViewModel.WindowsFaultSourcesText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{StaticResource AlkSteelGrayBrush}" />

                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{StaticResource AlkAlertAmberBrush}"
                                                           loc:Loc.Text="Diagnostics.FaultRecordBlurb" />

                                                <Button loc:Loc.Content="Diagnostics.OpenEventViewerButton" Command="{x:Bind DiagnosticsViewModel.OpenEventViewerCommand}" Style="{StaticResource Action}" MinWidth="240"
                                                        HorizontalAlignment="Left"
                                                        loc:Loc.Tooltip="Diagnostics.OpenEventViewerButton.Tooltip" />

                                                <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.WindowsFaultRows}" ItemTemplate="{StaticResource WindowsFaultRow}" />
                                            </StackPanel>
                                        </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="EvidenceDumps" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="10" Margin="0,8,0,0"
                                                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="DumpEvidence" x:FieldModifier="internal" Spacing="10" HorizontalAlignment="Left"
                                                        MaxWidth="{x:Bind DetailScroller.ViewportWidth, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind DiagnosticsViewModel.CrashDumpsStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Visibility="{x:Bind DiagnosticsViewModel.CrashDumpsStatus, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                                <!-- What Windows keeps is read and said in every build. Keep a Full Crash
                                                     Dump for the Game and Put the Dump Settings Back used to sit directly
                                                     below this sentence and are in the outer ring now
                                                     (DevRing\DeveloperSurfaces.cs), which puts them back there: both write
                                                     Windows' own registry keys machine-wide and ask for administrator
                                                     rights, which is a change outside BEM made to read compiled code back. -->
                                                <TextBlock x:Name="DumpSettingsSentence" x:FieldModifier="internal"
                                                           Text="{x:Bind DiagnosticsViewModel.DumpSettingsText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{StaticResource AlkSteelGrayBrush}"
                                                           Visibility="{x:Bind DiagnosticsViewModel.DumpSettingsText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                                <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.CrashDumpRows}" ItemTemplate="{StaticResource CrashDumpRow}" />
                                            </StackPanel>
                                        </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="EvidenceContribute" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="10" Margin="0,8,0,0"
                                                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="10" HorizontalAlignment="Left"
                                                        MaxWidth="{x:Bind DetailScroller.ViewportWidth, Mode=OneWay}">
                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           loc:Loc.Text="Diagnostics.ButrScoringBlurb" />

                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{StaticResource AlkSteelGrayBrush}"
                                                           loc:Loc.Text="Diagnostics.ButrPrivacyBlurb" />

                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{StaticResource AlkAlertAmberBrush}"
                                                           loc:Loc.Text="Diagnostics.ButrUntestedBlurb" />

                                                <CheckBox loc:Loc.Content="Diagnostics.ContributeCheckBox"
                                                          IsChecked="{x:Bind SettingsViewModel.ButrContributionEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource AlkCheckBox}"
                                                          loc:Loc.Tooltip="Diagnostics.ContributeCheckBox.Tooltip" />

                                                <StackPanel Spacing="10"
                                                            Visibility="{x:Bind SettingsViewModel.ButrContributionEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- Send and Discard are grayed out until a report is prepared, and a
                                                         disabled Button shows no tooltip of its own, so those two carry
                                                         theirs on a transparent wrapper instead. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Button loc:Loc.Content="Diagnostics.PrepareContributionButton" Command="{x:Bind SettingsViewModel.PrepareButrContributionCommand}" Style="{StaticResource Action}" MinWidth="240"
                                                                loc:Loc.Tooltip="Diagnostics.PrepareContributionButton.Tooltip" />
                                                        <Border Background="Transparent"
                                                                loc:Loc.Tooltip="Diagnostics.SendContributionWrapper.Tooltip">
                                                            <Button loc:Loc.Content="Diagnostics.SendContributionButton" Command="{x:Bind SettingsViewModel.SendButrContributionCommand}" Style="{StaticResource PrimaryAction}" MinWidth="160" />
                                                        </Border>
                                                        <Border Background="Transparent"
                                                                loc:Loc.Tooltip="Diagnostics.DiscardContributionWrapper.Tooltip">
                                                            <Button loc:Loc.Content="Diagnostics.DiscardContributionButton" Command="{x:Bind SettingsViewModel.DiscardButrContributionCommand}" Style="{StaticResource Action}" MinWidth="120" />
                                                        </Border>
                                                        <Button loc:Loc.Content="Diagnostics.StopContributionButton" Command="{x:Bind SettingsViewModel.CancelButrContributionCommand}" Style="{StaticResource Action}" MinWidth="140"
                                                                Visibility="{x:Bind SettingsViewModel.ButrContributionBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                                loc:Loc.Tooltip="Diagnostics.StopContributionButton.Tooltip" />
                                                        <Button loc:Loc.Content="Diagnostics.AboutButrButton" Command="{x:Bind SettingsViewModel.OpenButrCrashProjectCommand}" Style="{StaticResource Action}" MinWidth="200"
                                                                loc:Loc.Tooltip="Diagnostics.AboutButrButton.Tooltip" />
                                                        <ProgressRing IsActive="{x:Bind SettingsViewModel.ButrContributionBusy, Mode=OneWay}" Width="20" Height="20" />
                                                    </StackPanel>

                                                    <TextBlock Text="{x:Bind SettingsViewModel.ButrContributionStatusMessage, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                               Visibility="{x:Bind SettingsViewModel.ButrContributionStatusMessage, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                                    <!-- Every byte that would go on the wire, selectable so it can be
                                                         read somewhere else before it is agreed to. -->
                                                    <Border Background="{StaticResource AlkSurfaceBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0"
                                                            Visibility="{x:Bind SettingsViewModel.ButrContributionPayload, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}">
                                                        <!-- Sideways only. Every byte has to be readable
                                                             before it is agreed to, so it is neither
                                                             trimmed nor held to a height: the column's
                                                             own scroller carries it down, and this one
                                                             carries the long lines across, which is a
                                                             different axis and cannot run into it. A
                                                             vertical bar here sat against the column's,
                                                             close enough that neither could be told
                                                             apart. It costs nothing at rest: the payload
                                                             appears only on the Contribute tab, with
                                                             contributing ticked, after Prepare. -->
                                                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                                            <TextBlock Text="{x:Bind SettingsViewModel.ButrContributionPayload, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                                       FontFamily="Consolas" TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                                                                       loc:Loc.Tooltip="Diagnostics.PayloadScroller.Tooltip" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Fixed height on purpose, and it keeps that height whether or not the scan has run: two
                 lines for the outcome and two for the folders it read, each trimmed with the whole of
                 it on the hover. Sized to their own text, a folder list several paths long took every
                 one of those lines out of the reports above. -->
            <Grid Grid.Row="2" Height="84" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind DiagnosticsViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                           IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.StatusMessage, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Text="{x:Bind DiagnosticsViewModel.SearchedFolders, Mode=OneWay}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                           IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}"
                           ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.SearchedFolders, Mode=OneWay}"
                           Visibility="{x:Bind DiagnosticsViewModel.SearchedFolders, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
