<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.ForensicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- One destination for "it crashed, why": the crash reports, the logs, the recorded runs and
         the experiment that finds the culprit, in one place instead of four. Each tile opens the full
         page that owns the evidence, so nothing is orphaned. -->
    <controls:PageShell TitleKey="Forensics.Title" Status="{x:Bind ViewModel.ForensicsSummary, Mode=OneWay}"
                        BlurbKey="Forensics.Blurb">

        <StackPanel Spacing="0">
            <TextBlock Style="{StaticResource BodyText}" loc:Loc.Text="Forensics.Intro" />

            <Grid Margin="0,16,0,0" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Click="OnOpenCrashReports" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Forensics.CrashReportsButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Diagnostics.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" loc:Loc.Text="Forensics.CrashReportsButton.Description" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE7BA;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="0" Grid.Column="1" Click="OnOpenLogs" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Forensics.LogsButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Logs.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" loc:Loc.Text="Forensics.LogsButton.Description" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE9D5;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="1" Grid.Column="0" Click="OnOpenWatch" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Forensics.WatchButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Watch.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" loc:Loc.Text="Forensics.WatchButton.Description" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE7B3;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="1" Grid.Column="1" Click="OnOpenBootChecks" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Forensics.BootChecksButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Forensics.BootChecksButton" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" loc:Loc.Text="Forensics.BootChecksButton.Description" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE945;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Click="OnOpenDiagnosticFiles" Style="{StaticResource Action}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16"
                    loc:Loc.Tooltip="Forensics.DiagnosticFilesButton.Tooltip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Files.Title" Style="{StaticResource RowTitleText}" IsTextSelectionEnabled="False" />
                        <TextBlock Style="{StaticResource MetaText}" IsTextSelectionEnabled="False" loc:Loc.Text="Forensics.DiagnosticFilesButton.Description" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="20" Glyph="&#xE8F1;" VerticalAlignment="Center" />
                </Grid>
            </Button>
            </Grid>
        </StackPanel>
    </controls:PageShell>
</Page>