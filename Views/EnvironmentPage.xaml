<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.EnvironmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:launcher="using:BannerlordEnvironmentManager.Core.Launcher"
    xmlns:loadorder="using:BannerlordEnvironmentManager.Core.LoadOrder"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />

        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="{StaticResource AlkPillCornerRadius}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource AlkDeepGraphiteBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AlkWarmGoldShadowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ModuleList's ItemTemplateSelector. Living here rather than nested inside
             ListView.ItemTemplate because ItemTemplate is DataTemplate-typed and a
             ModuleRowTemplateSelector is not a DataTemplate: setting the selector as ItemTemplate's
             value crashes the XAML compiler instead of producing a diagnostic. ItemTemplateSelector
             is the property meant for this. -->
        <views:ModuleRowTemplateSelector x:Key="ModuleRowTemplates">
            <views:ModuleRowTemplateSelector.ModuleTemplate>
                <DataTemplate x:DataType="vm:ModuleRowViewModel">
                    <Border Background="{x:Bind SelectionBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind SelectionBorder, Mode=OneWay}"
                            BorderThickness="2" CornerRadius="0" Padding="2">
                    <Grid ColumnSpacing="12" Padding="6,3" Background="Transparent"
                          ContextRequested="OnModuleRowContextRequested"
                          MinHeight="{x:Bind views:RowDensityHeight.For(views:ShellViewModels.Instance.NavigationSettings.RowDensity), Mode=OneWay}"
                          Opacity="{x:Bind CanToggle, Converter={StaticResource BoolToOpacity}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Every TextBlock in this row opts out of text selection. The row drags to
                             reorder the load order, and a selectable TextBlock captures the pointer
                             on press, so the drag would never start from wherever the text is. What
                             is worth copying off a row is on its context menu instead. -->
                        <TextBlock Text="{x:Bind Position, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                        <CheckBox Grid.Column="1" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}" Style="{StaticResource AlkCheckBox}"
                                  loc:Loc.Tooltip="Environment.ModuleEnabledCheckBox.Tooltip" />

                        <StackPanel Grid.Column="2" Spacing="2">
                            <!-- Wraps, so a long name drops its marks to the next line instead of under the version. -->
                            <controls:WrapPanel Spacing="8" RowSpacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SubHeadingText}" IsTextSelectionEnabled="False" />
                                <!-- What Auto-Sort leads with, on the row it decided. The tooltip
                                     carries the reason so the sort's rationale is readable here
                                     rather than only in the sort menu. -->
                                <TextBlock Text="{x:Bind TierText, Mode=OneWay}" Style="{StaticResource MarkText}"
                                           ToolTipService.ToolTip="{x:Bind TierTooltip, Mode=OneWay}"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, ShowTier), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind OfficialText}" Style="{StaticResource MarkText}"
                                           ToolTipService.ToolTip="{x:Bind OfficialTooltip}"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsOfficial), Mode=OneWay}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.Workshop.Name" Style="{StaticResource MarkText}"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsWorkshop), Mode=OneWay}" />
                                <!-- The other half of Workshop. A community module came from one place
                                     or the other, and naming only one left every Nexus mod looking
                                     as though it had no origin at all. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.Nexus.Name" Style="{StaticResource MarkText}"
                                           loc:Loc.Tooltip="Environment.NexusMark.Tooltip"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, ShowNexus), Mode=OneWay}" />
                                <!-- A gap in what BEM knows, never shown for a Workshop module, which
                                     is not supposed to have a Nexus id and would be thirteen false
                                     alarms on this install. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.NoNexusId.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.NoNexusIdMark.Tooltip"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, ShowNoNexusId), Mode=OneWay}" />
                                <TextBlock loc:Loc.Text="Environment.OrphanMark" Style="{StaticResource MarkActionText}"
                                           Visibility="{x:Bind IsOrphan, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.Unreadable.Name" Style="{StaticResource MarkActionText}"
                                           Visibility="{x:Bind IsUnreadable, Converter={StaticResource BoolToVisibility}}" />
                                <!-- The update verdict, on the row it is about. Amber because it is the
                                     one thing here the user may want to act on; Out of date and
                                     Probably are separate words because they are separate claims.
                                     One compares the file Nexus published against the file that was
                                     installed, the other reasons about a date because nothing
                                     identified the file. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.OutOfDate.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.OutOfDateMark.Tooltip"
                                           Visibility="{x:Bind IsOutOfDate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.ProbablyOutOfDate.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.ProbablyOutOfDateMark.Tooltip"
                                           Visibility="{x:Bind IsProbablyOutOfDate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Two sources naming two different mod pages, which is the reason
                                     behind an unknown often enough that it gets said instead of it.
                                     Amber rather than gray because unlike the rest of the unknowns
                                     this one has a fix, and the fix is on this row's own menu. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.IdConflict.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.IdConflictMark.Tooltip"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, HasIdConflict), Mode=OneWay}" />
                                <!-- Gray, not amber. An unknown is a gap in what BEM knows and not a
                                     problem with the mod, and the count at the top of the tab named
                                     five of these with nothing on any row to find them by. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.UpdateUnknown.Name" Style="{StaticResource MarkText}"
                                           loc:Loc.Tooltip="Environment.UnknownUpdateMark.Tooltip"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, ShowUnknownUpdate), Mode=OneWay}" />
                                <!-- Pinned is the user's own decision about the row rather than something
                                     read off the manifest, so it carries a color instead of the dimmed
                                     treatment the computed badges use. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.Pinned.Name" Style="{StaticResource MarkText}" Foreground="{StaticResource AlkWarmGoldShadowBrush}"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsPinned), Mode=OneWay}" />
                                <!-- The user's own statement, so it gets the same colored treatment
                                     as Pinned rather than the dimmed one the computed badges use. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.NotOnNexus.Name" Style="{StaticResource MarkText}" Foreground="{StaticResource AlkWarmGoldShadowBrush}"
                                           loc:Loc.Tooltip="Environment.NotOnNexusMark.Tooltip"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsNotOnNexus), Mode=OneWay}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.BuiltHere.Name" Style="{StaticResource MarkText}" Foreground="{StaticResource AlkWarmGoldShadowBrush}"
                                           loc:Loc.Tooltip="Environment.BuiltHereMark.Tooltip"
                                           Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsBuiltLocally), Mode=OneWay}" />
                                <controls:Pill TextKey="Environment.Manager.Bem.Pill" Kind="Identity" Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsManagedByBem), Mode=OneWay}" />
                                <controls:Pill TextKey="Environment.Manager.Vortex.Pill" Kind="Identity" Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsManagedByVortex), Mode=OneWay}" />
                                <controls:Pill TextKey="Environment.Manager.Mo2.Pill" Kind="Identity" Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, IsManagedByMo2), Mode=OneWay}" />
                            </controls:WrapPanel>
                            <TextBlock Text="{x:Bind ModuleIdText}" Style="{StaticResource MonoText}" IsTextSelectionEnabled="False"
                                       Visibility="{x:Bind views:PageDensity.Advanced(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind UserNoteLine, Mode=OneWay}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}"
                                       Visibility="{x:Bind HasUserNoteLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Why this module cannot work, each reason with its fix beside it. -->
                            <ItemsControl ItemsSource="{x:Bind Problems, Mode=OneWay}"
                                          Visibility="{x:Bind HasProblems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModuleRowProblem">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" IsTextSelectionEnabled="False" />
                                            <Button Content="{x:Bind FixLabel}" Command="{x:Bind Fix}" Style="{StaticResource RowAction}"
                                                    ToolTipService.ToolTip="{x:Bind FixTooltip}" VerticalAlignment="Center"
                                                    Visibility="{x:Bind HasFix, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander HorizontalAlignment="Left" IsExpanded="False" Padding="12,4,12,8"
                                      AutomationProperties.Name="{x:Bind NotesAutomationName}"
                                      Visibility="{x:Bind AreNotesVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Expander.Header>
                                    <TextBlock Text="{x:Bind NotesHeader, Mode=OneWay}" Style="{StaticResource BodyText}"
                                               IsTextSelectionEnabled="False"
                                               loc:Loc.Tooltip="Environment.ModuleNotesExpander.Header.Tooltip" Foreground="{StaticResource AlkMutedTextBrush}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{x:Bind Notes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <!-- Expander bodies are normally safe to select in, but this one
                                                 is inside the draggable row, so it opts out too. -->
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2"
                                                       IsTextSelectionEnabled="False" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{x:Bind DisplayVersion, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}"
                                   Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, StateIsQuiet), Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource MarkActionText}" VerticalAlignment="Center"
                                   Visibility="{x:Bind StateNeedsAttention, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The player's own before, after and incompatible rules for this module.
                             Two short lines so the button stays narrow at the end of every row. -->
                        <Button Grid.Column="5" Style="{StaticResource RowAction}" VerticalAlignment="Center" Padding="8,2"
                                Visibility="{x:Bind views:PageDensity.Advanced(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode), Mode=OneWay}"
                                Click="LoadRulesButtonClicked" loc:Loc.Tooltip="Environment.LoadRulesButton.Tooltip"
                                AutomationProperties.Name="{x:Bind LoadRulesAutomationName}">
                            <TextBlock loc:Loc.Text="Environment.LoadRulesButton" Style="{StaticResource MetaText}"
                                       TextAlignment="Center" HorizontalAlignment="Center" IsTextSelectionEnabled="False" />
                        </Button>
                        <!-- This mod's own settings folders, instead of a page for every mod's at once. -->
                        <Button Grid.Column="6" Style="{StaticResource RowAction}" VerticalAlignment="Center" Padding="8,2"
                                Visibility="{x:Bind views:PageDensity.AdvancedAnd(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, HasSettingsFile), Mode=OneWay}"
                                loc:Loc.Content="ModSettings.Row.Button" Click="ModSettingsButtonClicked"
                                loc:Loc.Tooltip="ModSettings.Row.Tooltip" />
                    </Grid>
                    </Border>
                </DataTemplate>
            </views:ModuleRowTemplateSelector.ModuleTemplate>
            <views:ModuleRowTemplateSelector.DividerTemplate>
                <DataTemplate x:DataType="vm:DividerRowViewModel">
                    <!-- MinHeight matches the module row's own density-driven height (RowDensityHeight.For)
                         rather than sizing to its single line of text: a divider was the shortest row in
                         the list by a wide margin, and WinUI's drag-reorder computes insertion position
                         from row geometry, so dragging it past taller module rows tracked the pointer
                         poorly - this closes that height mismatch. -->
                    <Border Background="{StaticResource AlkDeepGraphiteBrush}" CornerRadius="0"
                            MinHeight="{x:Bind views:RowDensityHeight.For(views:ShellViewModels.Instance.NavigationSettings.RowDensity), Mode=OneWay}">
                        <Border.ContextFlyout>
                            <MenuFlyout Opening="OnDividerContextMenuOpening">
                                <MenuFlyoutItem loc:Loc.Text="Environment.RenameDividerMenuItem" Click="OnRenameDividerClicked"
                                                loc:Loc.Tooltip="Environment.RenameDividerMenuItem.Tooltip" />
                                <MenuFlyoutItem Text="{x:Bind CollapseExpandLabel, Mode=OneWay}"
                                                Click="OnToggleDividerCollapsedClicked"
                                                loc:Loc.Tooltip="Environment.CollapseExpandDividerMenuItem.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Environment.RemoveDividerMenuItem" Click="OnRemoveDividerClicked"
                                                loc:Loc.Tooltip="Environment.RemoveDividerMenuItem.Tooltip" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <!-- ContextRequested lives on this stretched, transparent child rather than the
                             Border above: a Border that owns ContextFlyout marks ContextRequested handled
                             in native code before any app handler on that same element runs
                             (CUIElement::OnContextRequestedCore), so a handler on the flyout owner itself
                             never fires. -->
                        <Grid Background="Transparent" Padding="10,6"
                              ContextRequested="OnDividerRowContextRequested">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                           Style="{StaticResource LabelText}"
                                           Foreground="{StaticResource AlkSoftChampagneBrush}"
                                           IsTextSelectionEnabled="False" />
                                <TextBlock Text="{x:Bind HiddenCountText, Mode=OneWay}"
                                           Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource AlkSteelGrayBrush}"
                                           IsTextSelectionEnabled="False"
                                           Visibility="{x:Bind Collapsed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </views:ModuleRowTemplateSelector.DividerTemplate>
        </views:ModuleRowTemplateSelector>

    </Page.Resources>

    <!-- Play (mockup-play.html): the load order is the primary card and keeps two thirds of the width;
         beside it the Preflight, Selected Module and Profiles cards share the rest, giving up height in
         that order's reverse. Launch is in the context bar above every page. Below the compact width
         the three side cards fold into one tabbed card, 360 px wide. The page never scrolls; each card
         scrolls inside its share. -->
    <Grid x:Name="PageRoot" Padding="8" RowSpacing="8" ColumnSpacing="{StaticResource AlkCardGap}" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition x:Name="SideColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader x:Name="PlayHeader" Grid.ColumnSpan="2" TitleKey="Environment.Title" BlurbKey="Environment.Blurb"
                             ShowWhy="{x:Bind Navigation.IsAdvancedMode, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Basic's whole Profiles card, the way the other managers do it: name and Save, the saved
                 orders behind one press, and Import and Export, each one click from the page. The card
                 itself, with its sets, saves, compare and backups, is Advanced. -->
            <controls:WrapPanel Spacing="8" Visibility="{x:Bind views:PageDensity.Basic(Navigation.IsAdvancedMode), Mode=OneWay}">
                <TextBox Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         loc:Loc.Placeholder="Environment.NewProfileNameBox.Placeholder" Width="180"
                         MaxLength="{x:Bind ViewModel.MaxProfileNameLength}"
                         loc:Loc.Tooltip="Environment.NewProfileNameBox.Tooltip" />
                <Button loc:Loc.Content="Environment.SaveProfileButton" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{StaticResource Action}"
                        loc:Loc.Tooltip="Environment.SaveProfileButton.Tooltip" />
                <DropDownButton loc:Loc.Content="Environment.Simple.ProfilesDropDown" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.Simple.ProfilesDropDown.Tooltip">
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="6" MinWidth="300" MaxWidth="460">
                                <TextBlock loc:Loc.Text="Environment.Simple.ProfilesEmpty" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           Visibility="{x:Bind EmptyVisibility(ViewModel.Profiles.Count), Mode=OneWay}" />
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Profiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProfileRowViewModel">
                                                <Grid ColumnSpacing="8" Padding="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind SavedText}" Style="{StaticResource MetaText}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" loc:Loc.Content="Environment.ProfileRow.RestoreButton" Command="{x:Bind RestoreCommand}" Style="{StaticResource RowAction}"
                                                            VerticalAlignment="Center" loc:Loc.Tooltip="Environment.ProfileRow.RestoreButton.Tooltip" />
                                                    <Button Grid.Column="2" loc:Loc.Content="Environment.ProfileRow.RemoveButton" Command="{x:Bind DeleteCommand}" Style="{StaticResource QuietAction}"
                                                            VerticalAlignment="Center" loc:Loc.Tooltip="Environment.ProfileRow.RemoveButton.Tooltip" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button loc:Loc.Content="Environment.ImportProfileButton" Command="{x:Bind ViewModel.ImportProfileCommand}" Style="{StaticResource Action}"
                        loc:Loc.Tooltip="Environment.ImportProfileButton.Tooltip" />
                <Button loc:Loc.Content="Environment.ExportLoadOrderMenuItem" Command="{x:Bind ViewModel.ExportLoadOrderCommand}" Style="{StaticResource Action}"
                        loc:Loc.Tooltip="Environment.ExportLoadOrderMenuItem.Tooltip" />
            </controls:WrapPanel>
            <!-- Simple by default: Auto-Sort, Undo and More are Advanced Mode tools. -->
            <controls:WrapPanel Spacing="8" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
            <Border Background="Transparent"
                    loc:Loc.Tooltip="Environment.AutoSortButton.Tooltip">
                <Button loc:Loc.Content="Environment.AutoSortButton" Command="{x:Bind ViewModel.AutoSortCommand}" Style="{StaticResource Action}" />
            </Border>
            <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.UndoReason, Mode=OneWay}">
                <Button loc:Loc.Content="Environment.UndoButton" Command="{x:Bind ViewModel.UndoCommand}" Style="{StaticResource Action}" />
            </Border>
            <DropDownButton loc:Loc.Content="Environment.MoreDropDown" Style="{StaticResource Action}"
                            loc:Loc.Tooltip="Environment.MoreDropDown.Tooltip">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem loc:Loc.Text="Environment.ValidateMenuItem" Command="{x:Bind ViewModel.ValidateCommand}"
                                        loc:Loc.Tooltip="Environment.ValidateMenuItem.Tooltip" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="Environment.ImportLoadOrderMenuItem" Command="{x:Bind ViewModel.ImportLoadOrderCommand}"
                                        loc:Loc.Tooltip="Environment.ImportLoadOrderMenuItem.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Environment.ExportLoadOrderMenuItem" Command="{x:Bind ViewModel.ExportLoadOrderCommand}"
                                        loc:Loc.Tooltip="Environment.ExportLoadOrderMenuItem.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Environment.ImportVortexMenuItem" Command="{x:Bind ViewModel.ImportVortexLoadOrderCommand}"
                                        loc:Loc.Tooltip="Environment.ImportVortexMenuItem.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Environment.ImportMo2MenuItem" Command="{x:Bind ViewModel.ImportMo2LoadOrderCommand}"
                                        loc:Loc.Tooltip="Environment.ImportMo2MenuItem.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Environment.ExportMo2MenuItem" Command="{x:Bind ViewModel.ExportMo2LoadOrderCommand}"
                                        loc:Loc.Tooltip="Environment.ExportMo2MenuItem.Tooltip" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="Environment.RereadFromDiskMenuItem" Click="OnRefreshClicked"
                                        loc:Loc.Tooltip="Environment.RereadFromDiskMenuItem.Tooltip" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            </controls:WrapPanel>
            </StackPanel>
        </controls:PageHeader>

        <!-- What appears after the page is up and needs reading before the list: an interrupted search,
             BEM's companion left in the game, a download running, no version installed yet, and the
             command line when it is nearly full. Each is collapsed when it has nothing to say. -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
            <Border Height="96" Background="{StaticResource AlkSurfaceRaisedBrush}" Padding="14,12" CornerRadius="0"
                    BorderBrush="{StaticResource AlkAlertAmberBrush}" BorderThickness="2,0,0,0"
                    Visibility="{x:Bind ViewModel.HasInterruptedBisection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock loc:Loc.Text="Environment.InterruptedBisectionHeading" Style="{StaticResource SubHeadingText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.InterruptedBisectionNotice, Mode=OneWay}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.InterruptedBisectionNotice, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button loc:Loc.Content="Environment.RestoreInterruptedOrderButton" Command="{x:Bind ViewModel.RestoreInterruptedBisectionOrderCommand}" Style="{StaticResource PrimaryAction}" MinWidth="200"
                                loc:Loc.Tooltip="Environment.RestoreInterruptedOrderButton.Tooltip" />
                        <Button loc:Loc.Content="Environment.DismissInterruptedBisectionButton" Command="{x:Bind ViewModel.DismissInterruptedBisectionCommand}" Style="{StaticResource Action}" MinWidth="150"
                                loc:Loc.Tooltip="Environment.DismissInterruptedBisectionButton.Tooltip" />
                        <Button loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptInterruptedBisectionCommand}" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Height="96" Background="{StaticResource AlkSurfaceRaisedBrush}" Padding="14,12" CornerRadius="0"
                    BorderBrush="{StaticResource AlkAlertAmberBrush}" BorderThickness="2,0,0,0"
                    Visibility="{x:Bind ViewModel.HasCompanionLeftBehind, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.CompanionLeftBehindTitle, Mode=OneWay}" Style="{StaticResource SubHeadingText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CompanionLeftBehindNotice, Mode=OneWay}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.CompanionLeftBehindNotice, Mode=OneWay}" />
                    </StackPanel>
<controls:WrapPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <Button loc:Loc.Content="Environment.RemoveCompanionLeftBehindButton" Command="{x:Bind ViewModel.RemoveCompanionLeftBehindCommand}" Style="{StaticResource PrimaryAction}" MinWidth="200"
                            loc:Loc.Tooltip="Environment.RemoveCompanionLeftBehindButton.Tooltip" />
                        <Button loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptCompanionLeftBehindCommand}" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip" />
                    </controls:WrapPanel>
                </Grid>
            </Border>
            <!-- Another mod manager has deployed files into this game folder. -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasManagerDeployment, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     HorizontalAlignment="Left" MaxWidth="720" Title="{x:Bind ManagerActiveTitle}"
                     Message="{x:Bind ViewModel.ManagerDeploymentText, Mode=OneWay}" />
            <!-- A kept copy of a Workshop module whose Workshop folder is gone. -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasMissingWorkshopCopies, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     HorizontalAlignment="Left" MaxWidth="720" Title="{x:Bind MissingWorkshopTitle}"
                     Message="{x:Bind ViewModel.MissingWorkshopCopiesText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button loc:Loc.Content="Environment.WorkshopMissing.Restore" Command="{x:Bind ViewModel.RestoreWorkshopCopiesCommand}"
                            Style="{StaticResource Action}" loc:Loc.Tooltip="Environment.WorkshopMissing.Restore.Tooltip" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Steam updated the game since the last launch BEM saw. -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasGameUpdateNotice, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="{x:Bind ViewModel.GameUpdateHeading, Mode=OneWay}" HorizontalAlignment="Left" MaxWidth="720">
                <InfoBar.Content>
                    <StackPanel Spacing="8" Margin="0,8,0,8">
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasGameUpdateMods, Mode=OneWay}">
                            <TextBlock loc:Loc.Text="Core.Launcher.GameUpdate.ModList" Style="{StaticResource MetaText}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.GameUpdateModList, Mode=OneWay}" Style="{StaticResource MetaText}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <controls:WrapPanel>
                            <Button loc:Loc.Content="Core.Launcher.GameUpdate.Action.PlayPrevious" Click="OnOpenVersionsRequested"
                                    Style="{StaticResource Action}" loc:Loc.Tooltip="Environment.GameUpdate.PlayPrevious.Tooltip" />
                            <Button loc:Loc.Content="Core.Launcher.GameUpdate.Action.TurnOff" Command="{x:Bind ViewModel.TurnOffGameUpdateModsCommand}"
                                    Visibility="{x:Bind ViewModel.HasGameUpdateMods, Mode=OneWay}"
                                    Style="{StaticResource Action}" loc:Loc.Tooltip="Environment.GameUpdate.TurnOff.Tooltip" />
                            <Button loc:Loc.Content="Core.Launcher.GameUpdate.Action.GoOn" Command="{x:Bind ViewModel.GoOnAfterGameUpdateCommand}"
                                    Style="{StaticResource Action}" loc:Loc.Tooltip="Environment.GameUpdate.GoOn.Tooltip" />
                        </controls:WrapPanel>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <Grid Width="520" Height="56" HorizontalAlignment="Left" RowSpacing="6"
                  Visibility="{x:Bind DownloadStatusVisibility(ViewModel.VersionSwitcher.IsProgressVisible), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Wraps, then scrolls past four lines, so a long download error is never cut off. -->
                <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{x:Bind ViewModel.VersionSwitcher.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource MetaText}" TextWrapping="Wrap" VerticalAlignment="Top"
                               IsTextSelectionEnabled="True"
                               ToolTipService.ToolTip="{x:Bind ViewModel.VersionSwitcher.StatusMessage, Mode=OneWay}" />
                </ScrollViewer>
                <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.VersionSwitcher.ProgressValue, Mode=OneWay}"
                             Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Visibility="{x:Bind ViewModel.VersionSwitcher.IsProgressVisible, Mode=OneWay}"
                             loc:Loc.Tooltip="Environment.DownloadProgressBar.Tooltip" />
            </Grid>
            <controls:EmptyState Kind="Empty" HorizontalAlignment="Left"
                                 Title="{x:Bind NoVersionsTitle}" Reason="{x:Bind NoVersionsReason}"
                                 Visibility="{x:Bind NoVersionsVisibility(ViewModel.VersionSwitcher.HasInstalledVersions), Mode=OneWay}">
                <Button loc:Loc.Content="Environment.NoVersionsButton" Click="OnOpenVersionsRequested"
                        Style="{StaticResource PrimaryAction}" MinWidth="170"
                        loc:Loc.Tooltip="Environment.NoVersionsButton.Tooltip" />
            </controls:EmptyState>
                <TextBlock Text="{x:Bind ViewModel.CommandLineText, Mode=OneWay}" Style="{StaticResource MetaText}"
                           Foreground="{x:Bind CommandLineBrush(ViewModel.CommandLineIsTight), Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Visibility="{x:Bind views:PageDensity.Show(Navigation.IsAdvancedMode, ViewModel.CommandLineIsTight), Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.CommandLineTooltip}" />
        </StackPanel>

        <controls:CardShell x:Name="LoadOrderCard" Grid.Row="2" TitleKey="Environment.Card.LoadOrder" IsPrimary="True"
                            Meta="{x:Bind IssueMeta(Navigation.IsAdvancedMode, ViewModel.IssueCountText, ViewModel.ErrorCount, ViewModel.WarningCount), Mode=OneWay}" BodyScrolls="False" BodyPadded="False">
            <controls:CardShell.HeaderActions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Why the last sort put each module where it is, biggest move first. -->
                    <Button Content="{x:Bind ViewModel.SortExplanationHeader, Mode=OneWay}" Style="{StaticResource QuietAction}" MaxWidth="260"
                            Visibility="{x:Bind views:PageDensity.AdvancedAnd(Navigation.IsAdvancedMode, ViewModel.HasSortExplanation), Mode=OneWay}"
                            loc:Loc.Tooltip="Environment.SortExplanationExpander.Tooltip">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="420" Width="520" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SortExplanationLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                        <DropDownButton Content="{x:Bind ViewModel.UpdateCheckStatus, Mode=OneWay}" Style="{StaticResource Action}" MaxWidth="320"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.UpdateCheckDetail, Mode=OneWay}"
                                        Visibility="{x:Bind views:PageDensity.AdvancedAnd(Navigation.IsAdvancedMode, ViewModel.ShowNexusUpdates), Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <!-- Three actions and nothing else: Check for Updates (always fresh),
                                         Install Updates, and Find Mod IDs, which runs one chain over every
                                         module with no id, free steps first. Rebuild Every Mod ID is the
                                         chain's one option. The ids BEM holds and the pages turned down sit
                                         in the expander, so a wrong one can be seen and taken back. -->
                                    <StackPanel Spacing="10" MinWidth="330" MaxWidth="420">
                                        <TextBlock loc:Loc.Text="Environment.UpdatesFlyout.Heading" Style="{StaticResource SectionText}" />
                                        <TextBlock Text="{x:Bind ViewModel.UpdateCheckDetail, Mode=OneWay}" Style="{StaticResource MetaText}"
                                                   TextWrapping="Wrap" MaxWidth="330"
                                                   Visibility="{x:Bind ViewModel.UpdateCheckDetail, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                                        <Button loc:Loc.Content="Environment.CheckForUpdatesButton" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.CheckForUpdatesButton.Tooltip" />
                                        <Button Content="{x:Bind ViewModel.AvailableUpdatesLabel, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.InstallAvailableUpdatesCommand}"
                                                Style="{StaticResource PrimaryAction}"
                                                loc:Loc.Tooltip="Environment.InstallUpdatesButton.Tooltip" />
                                        <Button loc:Loc.Content="Environment.FindModIdsButton" Command="{x:Bind ViewModel.FindModIdsCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.FindModIdsButton.Tooltip" />
                                        <CheckBox loc:Loc.Content="Environment.RebuildModIdsCheckBox" IsChecked="{x:Bind ViewModel.RebuildEveryModId, Mode=TwoWay}"
                                                  loc:Loc.Tooltip="Environment.RebuildModIdsCheckBox.Tooltip" />
                                        <Border Height="1" Background="{StaticResource AlkHairlineBrush}" Margin="0,2" />
                                        <TextBlock Text="{x:Bind ViewModel.ModIdCoverage, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  loc:Loc.AutomationName="Environment.ModIdLists.Header"
                                                  loc:Loc.Tooltip="Environment.ModIdLists.Header.Tooltip">
                                            <Expander.Header>
                                                <TextBlock loc:Loc.Text="Environment.ModIdLists.Header" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" />
                                            </Expander.Header>
                                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{x:Bind Library.ConfirmedNexusIdSummary, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                               Visibility="{x:Bind Library.ConfirmedNexusIdSummary, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                                                    <TextBlock loc:Loc.Text="Install.ConfirmedNexusIdsHeading" Style="{StaticResource LabelText}"
                                                               loc:Loc.Tooltip="Install.ConfirmedNexusIdsHeading.Tooltip" />
                                                    <ListView ItemsSource="{x:Bind Library.ConfirmedNexusIds}"
                                                              SelectedItem="{x:Bind Library.SelectedConfirmedNexusId, Mode=TwoWay}"
                                                              SelectionMode="Single"
                                                              Background="Transparent"
                                                              BorderThickness="0">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ConfirmedNexusIdRow">
                                                                <StackPanel Spacing="2" Margin="0,2,0,2">
                                                                    <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                                               IsTextSelectionEnabled="False" />
                                                                    <TextBlock Text="{x:Bind Basis}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                                               IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    <controls:WrapPanel Spacing="8">
                                                        <Button loc:Loc.Content="Install.OpenConfirmedPageButton" Command="{x:Bind Library.OpenConfirmedNexusIdPageCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Install.OpenConfirmedPageButton.Tooltip" />
                                                        <Button loc:Loc.Content="Install.CopyConfirmedPageUrlMenuItem" Command="{x:Bind Library.CopyConfirmedNexusIdPageUrlCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Install.CopyConfirmedPageUrlMenuItem.Tooltip" />
                                                    </controls:WrapPanel>
                                                    <TextBlock loc:Loc.Text="Install.RejectedNexusIdsHeading" Style="{StaticResource LabelText}"
                                                               loc:Loc.Tooltip="Install.RejectedNexusIdsHeading.Tooltip" />
                                                    <ListView ItemsSource="{x:Bind Library.RejectedNexusIds}"
                                                              SelectedItem="{x:Bind Library.SelectedRejectedNexusId, Mode=TwoWay}"
                                                              SelectionMode="Single"
                                                              Background="Transparent"
                                                              BorderThickness="0">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RejectedNexusIdRow">
                                                                <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                                           Margin="0,2,0,2" IsTextSelectionEnabled="False" />
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    <Button loc:Loc.Content="Install.ProposeAgainButton" Command="{x:Bind Library.RestoreRejectedNexusIdCommand}" Style="{StaticResource Action}"
                                                            loc:Loc.Tooltip="Install.ProposeAgainButton.Tooltip" />
                                                    <Button loc:Loc.Content="Environment.UndoRebuildButton" Command="{x:Bind ViewModel.UndoModIdRebuildCommand}" Style="{StaticResource Action}"
                                                            loc:Loc.Tooltip="Environment.UndoRebuildButton.Tooltip"
                                                            Visibility="{x:Bind ViewModel.CanUndoModIdRebuild, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Expander>
                                        <TextBlock Text="{x:Bind ViewModel.UpdateCheckRanAt, Mode=OneWay}" Style="{StaticResource MonoText}"
                                                   TextWrapping="Wrap" MaxWidth="330"
                                                   loc:Loc.Tooltip="Environment.UpdateCheckRanAtText.Tooltip" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <!-- Basic's whole Updates popup: one button naming how many updates wait, shown only
                             while there are any. The check itself runs on its own. -->
                        <Button Content="{x:Bind ViewModel.AvailableUpdatesLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.InstallAvailableUpdatesCommand}"
                                Style="{StaticResource PrimaryAction}" MaxWidth="260"
                                Visibility="{x:Bind UpdatesPillVisibility(Navigation.IsAdvancedMode, ViewModel.ShowNexusUpdates, ViewModel.HasAvailableUpdates), Mode=OneWay}"
                                loc:Loc.Tooltip="Environment.InstallUpdatesButton.Tooltip" />
                        <Button loc:Loc.Content="Environment.CancelUpdateCheckButton" Command="{x:Bind ViewModel.CancelUpdateCheckCommand}" Style="{StaticResource Action}"
                                Visibility="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                loc:Loc.Tooltip="Environment.CancelUpdateCheckButton.Tooltip" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                        <Button Command="{x:Bind ViewModel.PruneOrphansCommand}" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.PruneButton.Tooltip"
                                Visibility="{x:Bind PruneVisibility(Navigation.IsAdvancedMode, ViewModel.OrphanCount), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.PruneButtonText, Mode=OneWay}" />
                        </Button>
                </StackPanel>
            </controls:CardShell.HeaderActions>
            <controls:CardShell.Toolbar>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 loc:Loc.Placeholder="Environment.SearchBox.Placeholder" MinWidth="260"
                                 Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                                 loc:Loc.Tooltip="Environment.SearchBox.Tooltip" />
                    <!-- Everything that narrows what the list shows, behind one press: the questions,
                         the notes switch, and what the current filters are hiding. -->
                    <DropDownButton Grid.Column="1" loc:Loc.Content="Environment.ViewDropDown" Style="{StaticResource Action}"
                                    Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                                    loc:Loc.Tooltip="Environment.ViewDropDown.Tooltip">
                        <DropDownButton.Flyout>
                            <Flyout>
                                <StackPanel Spacing="10" MinWidth="300" MaxWidth="560">
                                <!-- The bulk actions apply to the modules the list is showing, so they sit with
                                     the filters that decide which those are. Official modules are never touched. -->
                                <controls:WrapPanel Spacing="8">
                                    <Button loc:Loc.Content="Environment.EnableAllMenuItem" Command="{x:Bind ViewModel.EnableAllCommand}"
                                            Style="{StaticResource Action}" loc:Loc.Tooltip="Environment.EnableAllMenuItem.Tooltip" />
                                    <Button loc:Loc.Content="Environment.DisableAllMenuItem" Command="{x:Bind ViewModel.DisableAllCommand}"
                                            Style="{StaticResource Action}" loc:Loc.Tooltip="Environment.DisableAllMenuItem.Tooltip" />
                                    <Button loc:Loc.Content="Environment.InvertEnabledMenuItem" Command="{x:Bind ViewModel.InvertEnabledCommand}"
                                            Style="{StaticResource Action}" loc:Loc.Tooltip="Environment.InvertEnabledMenuItem.Tooltip" />
                                </controls:WrapPanel>
                                <CheckBox loc:Loc.Content="Environment.ShowNotesCheckBox" IsChecked="{x:Bind ViewModel.ShowNotes, Mode=TwoWay}"
                                          Style="{StaticResource AlkCheckBox}" VerticalAlignment="Center"
                                          loc:Loc.Tooltip="Environment.ShowNotesCheckBox.Tooltip" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.FilterGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModuleFilterGroupViewModel">
                                            <DropDownButton Content="{x:Bind Label, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                            Visibility="{x:Bind HasAny, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <DropDownButton.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="8" MinWidth="260">
                                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodyText}"
                                                                       TextWrapping="Wrap" Foreground="{StaticResource AlkSteelGrayBrush}" />
                                                            <ItemsControl ItemsSource="{x:Bind Options}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ModuleFilterViewModel">
                                                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                                  Content="{x:Bind Label, Mode=OneWay}"
                                                                                  ToolTipService.ToolTip="{x:Bind Description}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button loc:Loc.Content="Environment.ClearFilterGroupButton" Command="{x:Bind ClearCommand}"
                                                                    Style="{StaticResource Action}" HorizontalAlignment="Left"
                                                                    loc:Loc.Tooltip="Environment.ClearFilterGroupButton.Tooltip"
                                                                    Visibility="{x:Bind IsNarrowing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button loc:Loc.Content="Environment.ClearFiltersButton" Command="{x:Bind ViewModel.ClearFiltersCommand}"
                                        Style="{StaticResource Action}" VerticalAlignment="Center"
                                        loc:Loc.Tooltip="Environment.ClearFiltersButton.Tooltip"
                                        Visibility="{x:Bind ViewModel.IsFiltering, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.FilterSummary, Mode=OneWay}"
                                           Foreground="{StaticResource AlkSteelGrayBrush}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </controls:CardShell.Toolbar>

            <Grid RowSpacing="6" Padding="8,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- The column header: Order and Pins live on it rather than on the card's bar, and the
                     same two actions are on a row's context menu (Pin, Pin Everything In Place, Remove
                     All Pins, Clear Sort). Both are Advanced, so Basic shows no strip at all. -->
                <Grid Grid.Row="0" ColumnSpacing="8" Padding="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                        <DropDownButton Content="{x:Bind ViewModel.SortLabel, Mode=OneWay}" Style="{StaticResource QuietAction}" MaxWidth="360"
                                        Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                                        loc:Loc.Tooltip="Environment.SortDropDown.Tooltip">
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" MinWidth="320">
                                        <TextBlock loc:Loc.Text="Environment.SortFlyout.Heading" Style="{StaticResource SubHeadingText}" />
                                        <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}"
                                                   TextWrapping="Wrap" MaxWidth="320"
                                                   loc:Loc.Text="Environment.SortFlyout.Description" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SortOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModuleSortViewModel">
                                                    <StackPanel Spacing="2">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ToggleButton Style="{StaticResource FilterChip}"
                                                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                          Content="{x:Bind Label, Mode=OneWay}"
                                                                          IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                                          IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                                                          Command="{x:Bind SelectCommand}"
                                                                          AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                                                                          loc:Loc.Tooltip="Environment.SortKeyChip.Tooltip" />
                                                            <!-- Direction belongs to the key, not to the sort, so it
                                                                 only exists once the key has a precedence number. -->
                                                            <Button Grid.Column="1" Style="{StaticResource Action}"
                                                                    Content="{x:Bind DirectionText, Mode=OneWay}"
                                                                    Command="{x:Bind ToggleDirectionCommand}"
                                                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                                    AutomationProperties.Name="{x:Bind DirectionText, Mode=OneWay}"
                                                                    loc:Loc.Tooltip="Environment.SortDirectionButton.Tooltip" />
                                                        </Grid>
                                                        <!-- A key only ever chooses between modules the declared
                                                             constraints leave free of each other. When nothing is
                                                             free for it to choose between, that is said here rather
                                                             than left to look broken. -->
                                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="320"
                                                                   Foreground="{StaticResource AlkAlertAmberBrush}"
                                                                   Text="{x:Bind UnreachableNote, Mode=OneWay}"
                                                                   Visibility="{x:Bind HasUnreachableNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind AcceptUnreachableNoteCommand}" Style="{StaticResource RowAction}"
                                                                loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip"
                                                                Visibility="{x:Bind HasUnreachableNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- A disabled Button shows no tooltip of its own, so the tooltip lives on this
                                             wrapper. Clearing the keys is not an undo: it stops the menu claiming an
                                             order the list may no longer be in, and Undo is what puts the order back.
                                             It sits with the keys it clears rather than beside them in the toolbar. -->
                                        <Border Background="Transparent" HorizontalAlignment="Left"
                                                loc:Loc.Tooltip="Environment.ClearSortKeysButton.Tooltip">
                                            <Button loc:Loc.Content="Environment.ClearSortKeysButton" Command="{x:Bind ViewModel.ClearSortCommand}" Style="{StaticResource Action}" />
                                        </Border>
        
                                        <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource AlkAlertAmberBrush}"
                                                   TextWrapping="Wrap" MaxWidth="320"
                                                   Text="{x:Bind ViewModel.SortLimitNote, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.HasSortLimitNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptSortLimitNoteCommand}" Style="{StaticResource RowAction}"
                                                loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip"
                                                Visibility="{x:Bind ViewModel.HasSortLimitNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}"
                                                   TextWrapping="Wrap" MaxWidth="320"
                                                   loc:Loc.Text="Environment.SortFlyout.Footnote" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton Grid.Column="1" Content="{x:Bind ViewModel.PinsLabel, Mode=OneWay}" Style="{StaticResource QuietAction}" MaxWidth="200"
                                        Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                                        loc:Loc.Tooltip="Environment.PinsDropDown.Tooltip">
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="10" MinWidth="420" MaxWidth="460">
                                        <TextBlock loc:Loc.Text="Environment.PinsFlyout.Heading" Style="{StaticResource SubHeadingText}" />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   Text="{x:Bind ViewModel.PinsSummary, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="Transparent"
                                                    loc:Loc.Tooltip="Environment.PinEverythingButton.Tooltip">
                                                <Button loc:Loc.Content="Environment.PinEverythingButton" Command="{x:Bind ViewModel.PinEverythingInPlaceCommand}" Style="{StaticResource Action}" />
                                            </Border>
                                            <Border Background="Transparent"
                                                    loc:Loc.Tooltip="Environment.RemoveAllPinsButton.Tooltip">
                                                <Button loc:Loc.Content="Environment.RemoveAllPinsButton" Command="{x:Bind ViewModel.ClearPinsCommand}" Style="{StaticResource Action}" />
                                            </Border>
                                        </StackPanel>
                                        <ListView ItemsSource="{x:Bind ViewModel.PinnedModules}" SelectionMode="None"
                                                  MaxHeight="260" Background="Transparent" BorderThickness="0">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PinRowViewModel">
                                                    <Grid ColumnSpacing="8" Padding="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyText}"
                                                                       TextWrapping="Wrap" />
                                                            <!-- A pin whose module is missing is kept and shown here rather than
                                                                 dropped: the module comes back and so does the pin. -->
                                                            <TextBlock Text="{x:Bind PositionText}" Style="{StaticResource BodyText}"
                                                                       Foreground="{StaticResource AlkWarmGoldShadowBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" loc:Loc.Content="Environment.UnpinButton" Command="{x:Bind UnpinCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.UnpinButton.Tooltip" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                </Grid>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ReorderBlockedReason, Mode=OneWay}"
                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="4,2"
                           ToolTipService.ToolTip="{x:Bind ViewModel.ReorderBlockedReason, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasReorderBlockedReason, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource AlkSteelGrayBrush}" />
                <ListView x:Name="ModuleList" Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.DisplayRows}"
                          ItemTemplateSelector="{StaticResource ModuleRowTemplates}"
                          SelectionMode="Single"
                          SelectedItem="{x:Bind ViewModel.SelectedModule, Mode=OneWay}"
                          CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          CanDragItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionChanged="OnModuleSelectionChanged"
                          ContextRequested="OnModuleContextRequested"
                          DragItemsStarting="OnDragItemsStarting"
                          DragItemsCompleted="OnDragItemsCompleted">
                    <!-- Empty on purpose: the default AddDeleteThemeTransition/ContentThemeTransition
                         play a delete-then-add animation on every drag-reorder, since WinUI's own
                         reorder always arrives as a genuine Remove followed by a genuine Add
                         (microsoft-ui-xaml #9685), never a Move. Removing them stops a real reorder
                         from visually looking like the row vanished and a new one appeared. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <!-- The default panel, declared only so ItemsUpdatingScrollMode can be stated
                         rather than assumed. The fix for the list losing its place leans on it: rows
                         are inserted and removed in place now instead of the collection being cleared
                         and refilled, and this is what holds the first visible row where it was while
                         that happens. ItemsUpdatingScrollMode belongs to the panel, not to ListView. -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <!-- The flyout lives on the list, not in the item template, so its items can x:Bind
                         the page view model. Which row it applies to is recorded by the handler on the
                         row itself, and re-read here as the menu opens. -->
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="ModuleRowMenu" x:FieldModifier="internal" Opening="OnModuleContextMenuOpening">
                            <!-- Two menus off one list, the way Windows Explorer does it. A plain
                                 right-click carries what the user came to do, frequency-ordered, with
                                 anything that has nothing to act on hidden rather than grayed; a
                                 Shift+right-click reveals the maintenance and the rarities in place.
                                 Declaration order here IS menu order, because RebuildModuleContextMenu
                                 only ever sets Visibility, and it matches ModuleContextMenu.Groups in
                                 Core, which decides what a row shows. An item that is merely blocked
                                 keeps appearing, disabled, carrying its reason in its tooltip. -->
                            <MenuFlyoutItem x:Name="ModuleToggleItem" Text="{x:Bind ViewModel.ContextToggleLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.ToggleModuleMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleEnableWithDependenciesItem" loc:Loc.Text="Environment.EnableWithDependenciesMenuItem"
                                            Command="{x:Bind ViewModel.EnableWithDependenciesCommand}"
                                            loc:Loc.Tooltip="Environment.EnableWithDependenciesMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleDisableWithDependentsItem" loc:Loc.Text="Environment.DisableWithDependentsMenuItem"
                                            Command="{x:Bind ViewModel.DisableWithDependentsCommand}"
                                            loc:Loc.Tooltip="Environment.DisableWithDependentsMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleUninstallItem" loc:Loc.Text="Environment.UninstallModuleMenuItem"
                                            Command="{x:Bind ViewModel.UninstallContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.UninstallModuleMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModulePruneItem" loc:Loc.Text="Environment.PruneEntryMenuItem"
                                            Command="{x:Bind ViewModel.PruneContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.PruneEntryMenuItem.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleOrderSeparator" />
                            <MenuFlyoutItem x:Name="ModuleMoveToTopItem" loc:Loc.Text="Environment.MoveToTopMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleToTopCommand}"
                                            loc:Loc.Tooltip="Environment.MoveToTopMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleMoveToBottomItem" loc:Loc.Text="Environment.MoveToBottomMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleToBottomCommand}"
                                            loc:Loc.Tooltip="Environment.MoveToBottomMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleMoveUpItem" loc:Loc.Text="Environment.MoveUpMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleUpCommand}"
                                            loc:Loc.Tooltip="Environment.MoveUpMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleMoveDownItem" loc:Loc.Text="Environment.MoveDownMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleDownCommand}"
                                            loc:Loc.Tooltip="Environment.MoveDownMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleOrderRulesItem" loc:Loc.Text="Environment.OrderRulesMenuItem"
                                            Click="OrderRulesClicked"
                                            loc:Loc.Tooltip="Environment.OrderRulesMenuItem.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleModSeparator" />
                            <MenuFlyoutItem x:Name="ModuleUpdateItem" loc:Loc.Text="Environment.UpdateModMenuItem"
                                            Command="{x:Bind ViewModel.UpdateContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.UpdateModMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleOpenModPageItem" loc:Loc.Text="Environment.OpenModPageMenuItem"
                                            Command="{x:Bind ViewModel.OpenContextModulePageCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.ContextOpenModPageTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem x:Name="ModuleHoldItem" Text="{x:Bind ViewModel.ContextHoldLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleContextModuleHoldCommand}"
                                            loc:Loc.Tooltip="Environment.HoldUpdate.Tooltip" />
                            <MenuFlyoutItem x:Name="ModulePinItem" Text="{x:Bind ViewModel.ContextPinLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleContextPinCommand}"
                                            loc:Loc.Tooltip="Environment.TogglePinMenuItem.Tooltip" />
                            <MenuFlyoutSubItem x:Name="ModuleOrderAndPinsItem" loc:Loc.Text="Environment.OrderAndPinsMenuItem"
                                               loc:Loc.Tooltip="Environment.OrderAndPinsMenuItem.Tooltip">
                                <MenuFlyoutItem loc:Loc.Text="Environment.PinEverythingButton" Command="{x:Bind ViewModel.PinEverythingInPlaceCommand}"
                                                loc:Loc.Tooltip="Environment.PinEverythingButton.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Environment.RemoveAllPinsButton" Command="{x:Bind ViewModel.ClearPinsCommand}"
                                                loc:Loc.Tooltip="Environment.RemoveAllPinsButton.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Environment.ClearSortKeysButton" Command="{x:Bind ViewModel.ClearSortCommand}"
                                                loc:Loc.Tooltip="Environment.ClearSortKeysButton.Tooltip" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="ModuleNotesItem" loc:Loc.Text="Library.Notes.Edit"
                                            Command="{x:Bind ViewModel.EditContextModuleNotesCommand}"
                                            loc:Loc.Tooltip="Library.Notes.Edit.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleEndorseItem" loc:Loc.Text="Library.Endorse"
                                            Command="{x:Bind ViewModel.EndorseContextModuleCommand}"
                                            loc:Loc.Tooltip="Library.Endorse.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleToolsSeparator" />
                            <!-- Open Module Folder stays in every build: a player has real reasons to
                                 reach the folder. Open SubModule.xml used to sit directly below it and
                                 is in the outer ring now (DevRing\DeveloperSurfaces.cs), which puts it
                                 back in the same place: reading another author's raw manifest is the
                                 author's move, not a player's. -->
                            <MenuFlyoutItem x:Name="ModuleOpenFolderItem" x:FieldModifier="internal"
                                            loc:Loc.Text="Environment.OpenModuleFolderMenuItem"
                                            Command="{x:Bind ViewModel.OpenContextModuleFolderCommand}"
                                            loc:Loc.Tooltip="Environment.OpenModuleFolderMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleCopyIdItem" loc:Loc.Text="Environment.CopyModuleIdMenuItem"
                                            Command="{x:Bind ViewModel.CopyContextModuleIdCommand}"
                                            loc:Loc.Tooltip="Environment.CopyModuleIdMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleInsertDividerAboveItem" loc:Loc.Text="Environment.InsertDividerAboveMenuItem"
                                            Command="{x:Bind ViewModel.InsertDividerAboveContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.InsertDividerAboveMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleInsertDividerBelowItem" loc:Loc.Text="Environment.InsertDividerBelowMenuItem"
                                            Command="{x:Bind ViewModel.InsertDividerBelowContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.InsertDividerBelowMenuItem.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleIdentitySeparator" />
                            <MenuFlyoutItem x:Name="ModuleSetNexusIdItem" loc:Loc.Text="Environment.SetNexusModIdMenuItem"
                                            Command="{x:Bind ViewModel.SetContextModuleNexusIdCommand}"
                                            loc:Loc.Tooltip="Environment.SetNexusModIdMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleForgetModIdItem" loc:Loc.Text="Environment.ForgetModIdMenuItem"
                                            Command="{x:Bind ViewModel.ForgetContextModuleNexusIdCommand}"
                                            loc:Loc.Tooltip="Environment.ForgetModIdMenuItem.Tooltip" />
                            <!-- Not on Nexus stays in every build on purpose: a mod can come from
                                 Discord or a friend, and the population BEM cannot identify includes
                                 hand-extracted downloads. Built on This Machine, which the outer ring
                                 (DevRing\DeveloperSurfaces.cs) inserts directly below it, lands here. -->
                            <MenuFlyoutItem x:Name="NotOnNexusMenuItem" x:FieldModifier="internal"
                                            Text="{x:Bind ViewModel.ContextNotOnNexusLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleContextNotOnNexusCommand}"
                                            loc:Loc.Tooltip="Environment.ToggleNotOnNexusMenuItem.Tooltip" />
                            <!-- Everything above this line acts on modules; everything below it chooses
                                 which modules a later action will act on. Ctrl+A, Shift+click and
                                 Ctrl+click all build a selection now, so Select All and Clear are
                                 rarities held behind Shift, except on a right-click below the last
                                 row, where choosing is the only thing the click can mean. Taking one
                                 row back out of a set is not a rarity and stays in the plain menu. -->
                            <MenuFlyoutSeparator x:Name="ModuleSelectionSeparator" />
                            <MenuFlyoutItem x:Name="ModuleDeselectItem" loc:Loc.Text="Environment.Multi.DeselectMenuItem"
                                            Command="{x:Bind ViewModel.DeselectContextModuleCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.DeselectContextModuleTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem x:Name="ModuleSelectAllItem" Text="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.SelectAllShownCommand}"
                                            loc:Loc.Tooltip="Environment.SelectAllMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleClearSelectionItem" loc:Loc.Text="Environment.ClearSelectionMenuItem"
                                            Command="{x:Bind ViewModel.ClearModuleSelectionCommand}"
                                            loc:Loc.Tooltip="Environment.ClearSelectionMenuItem.Tooltip" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
            </Grid>
        </controls:CardShell>

        <Grid x:Name="SideCards" Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SideTabsRow" Height="0" />
                <RowDefinition x:Name="PreflightRow" Height="1.3*" />
                <RowDefinition x:Name="ModuleRow" Height="{x:Bind ModuleRowHeight(ViewModel.HasSelectedModule), Mode=OneWay}" />
                <RowDefinition x:Name="ProfilesRow" Height="Auto" MaxHeight="420" />
            </Grid.RowDefinitions>

            <!-- Shown below the compact width only, where the three cards share one place. -->
            <controls:Segmented x:Name="SideTabs" Visibility="Collapsed" Margin="0,0,0,12" SelectionChanged="OnSideTabChanged" />

            <!-- What the launch check found and the load order's own issues, each the shared finding
                 row: Accept the Risk moves a finding to the Accepted Risks section at the card's foot. -->
            <controls:CardShell x:Name="PreflightCard" Grid.Row="1" TitleKey="Environment.Card.Preflight"
                                Meta="{x:Bind ViewModel.PreflightHeader, Mode=OneWay}">
                <controls:CardShell.HeaderActions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- The undo for Use the Installed BUTR Stack: the bundled copies BEM set aside. -->
                        <Button loc:Loc.Content="Environment.SetAsideExpander.Header" Style="{StaticResource QuietAction}"
                                Visibility="{x:Bind ViewModel.HasSetAsideCopies, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                loc:Loc.Tooltip="Environment.SetAsideExpander.Tooltip">
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="420" Width="560" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SetAsideRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SetAsideRowViewModel">
                                                <Grid ColumnSpacing="12" Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Text}" Style="{StaticResource BodyText}"
                                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="{x:Bind Location}" Style="{StaticResource BodyText}"
                                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" loc:Loc.Content="Environment.SetAsideRow.PutBackButton"
                                                            Click="OnPutBackSetAsideClicked" Tag="{x:Bind}" VerticalAlignment="Top"
                                                            loc:Loc.Tooltip="Environment.SetAsideRow.PutBackButton.Tooltip" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </controls:CardShell.HeaderActions>
                <StackPanel Spacing="4">
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.PanelIssues.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Style="{StaticResource CardTitleText}"
                                   Text="{x:Bind ViewModel.IssueCountText, Mode=OneWay}"
                                   loc:Loc.Tooltip="Environment.IssueCountText.Tooltip" />
                        <Border Background="Transparent"
                                loc:Loc.Tooltip="Environment.FixAllButton.Tooltip">
                            <Button loc:Loc.Content="Environment.FixAllButton" Command="{x:Bind ViewModel.FixAllCommand}" Style="{StaticResource Action}" />
                        </Border>
                        </StackPanel>
                    <ListView x:Name="IssueList" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{x:Bind ViewModel.PanelIssues}" SelectionMode="Single"
                              SelectionChanged="OnIssueSelected"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IssueRowViewModel">
                                <!-- The shared finding row. The row opens its issue when selected, so its text
                                     opts out of selection. -->
                                <Border BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="0,0,0,1">
                                    <controls:FindingRow Severity="{x:Bind views:EnvironmentPage.SeverityOf(Issue.Severity)}"
                                                         Headline="{x:Bind Message}" Detail="{x:Bind ModuleId}"
                                                         IsAccepted="{x:Bind Accepted}" CanAccept="{x:Bind IsProminent}"
                                                         IsTextSelectable="False" CommandParameter="{x:Bind}"
                                                         AcceptConfirmed="OnIssueAcceptConfirmed" UndoRequested="OnIssueUndoRequested">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button loc:Loc.Content="Environment.IssueRow.FixButton" Style="{StaticResource RowAction}"
                                                    Click="OnFixClicked" Tag="{x:Bind Issue}"
                                                    loc:Loc.Tooltip="Environment.IssueRow.FixButton.Tooltip"
                                                    Visibility="{x:Bind IsFixable, Converter={StaticResource BoolToVisibility}}" />
                                            <Button loc:Loc.Content="Environment.IssueRow.RemoveFolderButton" Style="{StaticResource DangerAction}"
                                                    HorizontalAlignment="Left" Click="OnRemoveFolderClicked" Tag="{x:Bind Folder}"
                                                    loc:Loc.Tooltip="Environment.IssueRow.RemoveFolderButton.Tooltip"
                                                    Visibility="{x:Bind CanRemoveFolder, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </controls:FindingRow>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="{x:Bind ShowHiddenLabel(ViewModel.HiddenPreflightCount), Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.ShowHiddenPreflightFindings, Mode=TwoWay}"
                                  Visibility="{x:Bind HasHidden(ViewModel.HiddenPreflightCount), Mode=OneWay}"
                                  loc:Loc.Tooltip="Environment.Preflight.ShowHidden.Tooltip" />
                        <TextBlock Text="{x:Bind IgnoredLabel(ViewModel.IgnoredPreflightCount), Mode=OneWay}" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource AlkSteelGrayBrush}" VerticalAlignment="Center"
                                   Visibility="{x:Bind HasHidden(ViewModel.IgnoredPreflightCount), Mode=OneWay}"
                                   loc:Loc.Tooltip="Environment.Preflight.IgnoredCount.Tooltip" />
                        <Button loc:Loc.Content="Environment.XmlRepair.UndoButton" Command="{x:Bind ViewModel.UndoXmlRepairCommand}"
                                Style="{StaticResource RowAction}"
                                Visibility="{x:Bind ViewModel.CanUndoXmlRepair, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                loc:Loc.Tooltip="Environment.XmlRepair.UndoButton.Tooltip" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" loc:Loc.Text="Environment.Preflight.Empty"
                               Visibility="{x:Bind NoPreflightVisibility(ViewModel.HasPreflight), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PreflightFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PreflightRowViewModel">
                                <Border BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                    <TextBlock Text="{x:Bind GroupHeading}" Style="{StaticResource CardGroupText}"
                                               Visibility="{x:Bind HasGroupHeading, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:FindingRow Severity="{x:Bind Severity}" Headline="{x:Bind Headline}" Detail="{x:Bind Detail}"
                                                         IsAccepted="{x:Bind IsAccepted, Mode=OneWay}" CanAccept="{x:Bind CanAccept}"
                                                         CanUndo="{x:Bind CanUndo}" CommandParameter="{x:Bind}" CanIgnoreOnce="{x:Bind CanAccept}"
                                                         IgnoreOnceRequested="OnPreflightIgnoreOnceRequested"
                                                         AcceptConfirmed="OnPreflightAcceptConfirmed" UndoRequested="OnPreflightUndoRequested">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{x:Bind FixLabel}" Style="{StaticResource RowAction}"
                                                    Click="OnPreflightFixClicked" Tag="{x:Bind}"
                                                    loc:Loc.Tooltip="Environment.PreflightRow.FixButton.Tooltip"
                                                    Visibility="{x:Bind IsFixable, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{x:Bind TurnOffLabel}" Style="{StaticResource RowAction}"
                                                    Click="OnPreflightTurnOffClicked" Tag="{x:Bind}"
                                                    loc:Loc.Tooltip="Environment.PreflightRow.TurnOffButton.Tooltip"
                                                    Visibility="{x:Bind CanTurnOff, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </controls:FindingRow>
                                    <ItemsControl ItemsSource="{x:Bind Links}" Margin="0,0,0,8"
                                                  Visibility="{x:Bind HasLinks, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="launcher:FindingLink">
                                                <HyperlinkButton Content="{x:Bind Label}" NavigateUri="{x:Bind Url}" Padding="0,2"
                                                                 ToolTipService.ToolTip="{x:Bind Url}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <controls:CardShell.Footer>
                    <StackPanel Spacing="4">
                    <controls:WrapPanel Spacing="8">
                    </controls:WrapPanel>
                    </StackPanel>
                </controls:CardShell.Footer>
            </controls:CardShell>

            <controls:CardShell x:Name="ModuleCard" Grid.Row="2" Margin="0,24,0,0" Title="{x:Bind ViewModel.SelectedModuleTitle, Mode=OneWay}"
                                Meta="{x:Bind ViewModel.SelectedModuleId, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasSelectedModule, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <controls:CardShell.HeaderActions>
                    <Button loc:Loc.Content="Environment.CloseDetailsButton" Command="{x:Bind ViewModel.CloseDetailsCommand}" Style="{StaticResource QuietAction}"
                            loc:Loc.Tooltip="Environment.CloseDetailsButton.Tooltip" />
                </controls:CardShell.HeaderActions>
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleFacts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="loadorder:ModuleFact">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource AlkWarmGoldShadowBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource BodyText}"
                                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
    
                    <TextBlock loc:Loc.Text="Environment.DeclaresHeading" Style="{StaticResource LabelText}"
                               loc:Loc.Tooltip="Environment.DeclaresHeading.Tooltip" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleDeclares}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
    
                    <TextBlock loc:Loc.Text="Environment.DeclaredByHeading" Style="{StaticResource LabelText}"
                               loc:Loc.Tooltip="Environment.DeclaredByHeading.Tooltip" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleNeededBy}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
    
                    <TextBlock loc:Loc.Text="Environment.UndeclaredHeading" Style="{StaticResource LabelText}"
                               loc:Loc.Tooltip="Environment.UndeclaredHeading.Tooltip" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleUndeclared}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
    
                    <!-- Two exclusive regions, one per site. A subscribed item is Steam's: Steam
                         publishes it, keeps it at the version its author published and ends it, so
                         nothing Nexus reports is about it and nothing here is worded in Nexus terms.
                         The link is the item's page in the Steam client, which is where Unsubscribe
                         lives and the only way such a module is removed, so replacing the framing
                         never costs the destination. -->
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.ShowWorkshopFacts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock loc:Loc.Text="Environment.WorkshopFactsHeading" Style="{StaticResource LabelText}"
                                   loc:Loc.Tooltip="Environment.WorkshopFactsHeading.Tooltip" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleWorkshop}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button loc:Loc.Content="Environment.OpenWorkshopPageButton" Command="{x:Bind ViewModel.OpenSelectedModuleWorkshopPageCommand}"
                                Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Visibility="{x:Bind ViewModel.CanOpenSelectedModuleWorkshopPage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                loc:Loc.Tooltip="Environment.OpenWorkshopPageButton.Tooltip" />
                    </StackPanel>
    
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.ShowNexusModuleFacts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock loc:Loc.Text="Environment.NexusFactsHeading" Style="{StaticResource LabelText}"
                                   loc:Loc.Tooltip="Environment.NexusFactsHeading.Tooltip" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleNexus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button loc:Loc.Content="Environment.OpenModulePageButton" Command="{x:Bind ViewModel.OpenSelectedModuleOnNexusCommand}"
                                Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Visibility="{x:Bind ViewModel.CanOpenSelectedModuleOnNexus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                loc:Loc.Tooltip="Environment.OpenModulePageButton.Tooltip" />
                    </StackPanel>
    
                    <TextBlock loc:Loc.Text="Environment.DiagnosesHeading" Style="{StaticResource LabelText}"
                               loc:Loc.Tooltip="Environment.DiagnosesHeading.Tooltip" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleDiagnoses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:CardShell>

            <!-- Saved load orders, the deleted ones and the dated backups. Each row's buttons need the
                 width they always had, so the rows scroll sideways inside the card. -->
            <controls:CardShell x:Name="ProfilesCard" Grid.Row="3" Margin="0,24,0,0" TitleKey="Environment.Card.Profiles"
                                BodyScrolls="False" BodyPadded="False">
                <!-- The card's one scroller, downward only: the button row wraps to the card width,
                     the lists scroll down, and no bar sits inside another. -->
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" Padding="20,4,20,16">
                <StackPanel Spacing="10">
                    <controls:WrapPanel Spacing="8">
                        <!-- Capped at the length a shared profile file can carry, so a
                             name typed here is always one an import can read back. -->
                        <TextBox Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 loc:Loc.Placeholder="Environment.NewProfileNameBox.Placeholder" MinWidth="220"
                                 MaxLength="{x:Bind ViewModel.MaxProfileNameLength}"
                                 loc:Loc.Tooltip="Environment.NewProfileNameBox.Tooltip" />
                        <Button loc:Loc.Content="Environment.SaveProfileButton" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.SaveProfileButton.Tooltip" />
                        <Border Background="Transparent"
                                loc:Loc.Tooltip="Environment.KnownGoodButton.Tooltip">
                            <!-- The label carries a profile name, so it is capped rather
                                 than allowed to push the row past the flyout edge. -->
                            <Button Content="{x:Bind ViewModel.KnownGoodLabel, Mode=OneWay}" MaxWidth="280"
                                    Command="{x:Bind ViewModel.ReturnToKnownGoodCommand}" Style="{StaticResource Action}" />
                        </Border>
                        <Button loc:Loc.Content="Environment.ImportProfileButton" Command="{x:Bind ViewModel.ImportProfileCommand}" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.ImportProfileButton.Tooltip" />
                        <Button loc:Loc.Content="Environment.ExportLoadOrderMenuItem" Command="{x:Bind ViewModel.ExportLoadOrderCommand}" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.ExportLoadOrderMenuItem.Tooltip" />
                    </controls:WrapPanel>

                    <!-- The three kinds of saved setup (enabled sets, profile saves, launch presets) sit in one
                         Presets expander, so Advanced shows one row here instead of three. -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                              loc:Loc.Tooltip="Environment.Presets.Tooltip">
                        <Expander.Header>
                            <TextBlock loc:Loc.Text="Environment.Presets.Title" Style="{StaticResource SubHeadingText}" />
                        </Expander.Header>
                        <StackPanel Spacing="10">
                    <!-- Enabled sets are a power-user surface: Advanced only. Pick one to see what it would
                         turn on and off, apply it, and undo it from the one Undo every Play change uses. -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}" loc:Loc.Tooltip="Environment.EnabledSets.Expander.Tooltip">
                        <Expander.Header>
                            <TextBlock loc:Loc.Text="Environment.EnabledSets.Title" Style="{StaticResource SubHeadingText}" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <TextBlock loc:Loc.Text="Environment.EnabledSets.Blurb" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <controls:WrapPanel Spacing="8">
                                <TextBox Text="{x:Bind ViewModel.NewEnabledSetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Environment.EnabledSets.NameBox.Placeholder" MinWidth="220"
                                         MaxLength="{x:Bind ViewModel.MaxEnabledSetNameLength}"
                                         loc:Loc.Tooltip="Environment.EnabledSets.NameBox.Tooltip" />
                                <Button loc:Loc.Content="Environment.EnabledSets.SaveButton" Command="{x:Bind ViewModel.SaveEnabledSetCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.EnabledSets.SaveButton.Tooltip" />
                            </controls:WrapPanel>
                            <controls:WrapPanel Spacing="8">
                                <ComboBox ItemsSource="{x:Bind ViewModel.EnabledSetNames}" SelectedItem="{x:Bind ViewModel.SelectedEnabledSetName, Mode=TwoWay}"
                                          loc:Loc.Placeholder="Environment.EnabledSets.Pick.Placeholder" MinWidth="220"
                                          loc:Loc.Tooltip="Environment.EnabledSets.Pick.Tooltip" />
                                <Button loc:Loc.Content="Environment.EnabledSets.ApplyButton" Command="{x:Bind ViewModel.ApplyEnabledSetCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.EnabledSets.ApplyButton.Tooltip" />
                                <Button loc:Loc.Content="Environment.EnabledSets.UndoButton" Command="{x:Bind ViewModel.UndoCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.EnabledSets.UndoButton.Tooltip" />
                                <Button loc:Loc.Content="Environment.EnabledSets.DeleteButton" Command="{x:Bind ViewModel.DeleteEnabledSetCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.EnabledSets.DeleteButton.Tooltip" />
                            </controls:WrapPanel>
                            <TextBlock Text="{x:Bind ViewModel.EnabledSetDiffText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.EnabledSetDiffText, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Expander>

                    <!-- Profile saves are a power-user surface: Advanced only. Off until a profile is switched on. -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}" loc:Loc.Tooltip="Environment.ProfileSaves.Expander.Tooltip">
                        <Expander.Header>
                            <TextBlock loc:Loc.Text="Environment.ProfileSaves.Title" Style="{StaticResource SubHeadingText}" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <TextBlock loc:Loc.Text="Environment.ProfileSaves.Blurb" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <controls:WrapPanel Spacing="8">
                                <ComboBox ItemsSource="{x:Bind ViewModel.ProfileSavesNames}" SelectedItem="{x:Bind ViewModel.SelectedProfileSavesName, Mode=TwoWay}"
                                          loc:Loc.Placeholder="Environment.ProfileSaves.Pick.Placeholder" MinWidth="220"
                                          loc:Loc.Tooltip="Environment.ProfileSaves.Pick.Tooltip" />
                                <CheckBox IsChecked="{x:Bind ViewModel.SelectedProfileKeepsSaves, Mode=TwoWay}"
                                          loc:Loc.Content="Environment.ProfileSaves.Keep"
                                          loc:Loc.Tooltip="Environment.ProfileSaves.Keep.Tooltip" />
                            </controls:WrapPanel>
                            <TextBlock Text="{x:Bind ViewModel.ProfileSavesNote, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ProfileSavesNote, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Expander>

                    <!-- Launch presets and tools for the profile in force are a power-user surface: Advanced only. -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}" loc:Loc.Tooltip="Environment.ProfileLaunch.Expander.Tooltip">
                        <Expander.Header>
                            <TextBlock loc:Loc.Text="Environment.ProfileLaunch.Title" Style="{StaticResource SubHeadingText}" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.LaunchProfileLabel, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <TextBlock loc:Loc.Text="Environment.ProfileLaunch.Blurb" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <controls:WrapPanel Spacing="8">
                                <ComboBox ItemsSource="{x:Bind ViewModel.LaunchPresetNames}" SelectedItem="{x:Bind ViewModel.SelectedLaunchPreset, Mode=TwoWay}"
                                          loc:Loc.Placeholder="Environment.ProfileLaunch.Pick.Placeholder" MinWidth="220"
                                          loc:Loc.Tooltip="Environment.ProfileLaunch.Pick.Tooltip" />
                                <Button loc:Loc.Content="Environment.ProfileLaunch.ClearButton" Command="{x:Bind ViewModel.ClearLaunchPresetCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.ProfileLaunch.ClearButton.Tooltip" />
                                <Button loc:Loc.Content="Environment.ProfileLaunch.RemovePresetButton" Command="{x:Bind ViewModel.RemoveLaunchPresetCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.ProfileLaunch.RemovePresetButton.Tooltip" />
                            </controls:WrapPanel>
                            <controls:WrapPanel Spacing="8">
                                <TextBox Text="{x:Bind ViewModel.NewLaunchPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Environment.ProfileLaunch.PresetName.Placeholder" MinWidth="160"
                                         MaxLength="{x:Bind ViewModel.MaxLaunchNameLength}"
                                         loc:Loc.Tooltip="Environment.ProfileLaunch.PresetName.Tooltip" />
                                <TextBox Text="{x:Bind ViewModel.NewLaunchPresetArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Environment.ProfileLaunch.PresetArguments.Placeholder" MinWidth="260"
                                         MaxLength="{x:Bind ViewModel.MaxLaunchArgumentsLength}"
                                         loc:Loc.Tooltip="Environment.ProfileLaunch.PresetArguments.Tooltip" />
                                <Button loc:Loc.Content="Environment.ProfileLaunch.AddPresetButton" Command="{x:Bind ViewModel.AddLaunchPresetCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.ProfileLaunch.AddPresetButton.Tooltip" />
                            </controls:WrapPanel>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LaunchTools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LaunchToolRowViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind PathText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                <TextBlock Text="{x:Bind ProblemText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Foreground="{StaticResource AlkAlertAmberBrush}"
                                                           Visibility="{x:Bind ProblemText, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button loc:Loc.Content="Environment.ProfileLaunch.RunToolButton" Command="{x:Bind RunCommand}" Style="{StaticResource Action}"
                                                        loc:Loc.Tooltip="Environment.ProfileLaunch.RunToolButton.Tooltip" />
                                                <Button loc:Loc.Content="Environment.ProfileLaunch.RemoveToolButton" Command="{x:Bind RemoveCommand}" Style="{StaticResource Action}"
                                                        loc:Loc.Tooltip="Environment.ProfileLaunch.RemoveToolButton.Tooltip" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <controls:WrapPanel Spacing="8">
                                <TextBox Text="{x:Bind ViewModel.NewLaunchToolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Environment.ProfileLaunch.ToolName.Placeholder" MinWidth="160"
                                         MaxLength="{x:Bind ViewModel.MaxLaunchNameLength}"
                                         loc:Loc.Tooltip="Environment.ProfileLaunch.ToolName.Tooltip" />
                                <TextBox Text="{x:Bind ViewModel.NewLaunchToolPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Environment.ProfileLaunch.ToolPath.Placeholder" MinWidth="260"
                                         loc:Loc.Tooltip="Environment.ProfileLaunch.ToolPath.Tooltip" />
                                <TextBox Text="{x:Bind ViewModel.NewLaunchToolArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Environment.ProfileLaunch.ToolArguments.Placeholder" MinWidth="200"
                                         MaxLength="{x:Bind ViewModel.MaxLaunchArgumentsLength}"
                                         loc:Loc.Tooltip="Environment.ProfileLaunch.ToolArguments.Tooltip" />
                                <Button loc:Loc.Content="Environment.ProfileLaunch.AddToolButton" Command="{x:Bind ViewModel.AddLaunchToolCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.ProfileLaunch.AddToolButton.Tooltip" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                    </Expander>

                    <!-- Profile compare: two saved profiles, from the first to the second. -->
                    <controls:WrapPanel Spacing="12" Visibility="{x:Bind ViewModel.CanPickProfilesToCompare, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox ItemsSource="{x:Bind ViewModel.Profiles}" SelectedItem="{x:Bind ViewModel.CompareFromProfile, Mode=TwoWay}"
                                  loc:Loc.Placeholder="Environment.CompareProfiles.FromPlaceholder" MinWidth="200"
                                  loc:Loc.Tooltip="Environment.CompareProfiles.FromPlaceholder.Tooltip" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Profiles}" SelectedItem="{x:Bind ViewModel.CompareToProfile, Mode=TwoWay}"
                                  loc:Loc.Placeholder="Environment.CompareProfiles.ToPlaceholder" MinWidth="200"
                                  loc:Loc.Tooltip="Environment.CompareProfiles.ToPlaceholder.Tooltip" />
                        <Button loc:Loc.Content="Environment.CompareProfiles.Button" Command="{x:Bind ViewModel.CompareSelectedProfilesCommand}" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.CompareProfiles.Button.Tooltip" />
                    </controls:WrapPanel>
                    <ListView ItemsSource="{x:Bind ViewModel.Profiles}" SelectionMode="None"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileRowViewModel">
                                <!-- Every variable-length field trims rather than growing.
                                     A horizontal StackPanel hands its children unbounded
                                     width, so trimming inside one never fires and a long
                                     name pushed the buttons off the edge. -->
                                <Grid ColumnSpacing="8" Padding="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="260" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind KnownGoodText}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind SavedText}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ContentText}" Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" Foreground="{StaticResource AlkMutedTextBrush}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button loc:Loc.Content="Environment.ProfileRow.RestoreButton" Command="{x:Bind RestoreCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.ProfileRow.RestoreButton.Tooltip" />
                                        <Button loc:Loc.Content="Environment.ProfileRow.CompareButton" Command="{x:Bind CompareCommand}" Style="{StaticResource Action}"
                                                Visibility="{x:Bind views:PageDensity.Advanced(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode), Mode=OneWay}"
                                                loc:Loc.Tooltip="Environment.ProfileRow.CompareButton.Tooltip" />
                                        <Button loc:Loc.Content="Environment.ProfileRow.ExportButton" Command="{x:Bind ExportCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.ProfileRow.ExportButton.Tooltip" />
                                        <Button loc:Loc.Content="Environment.ProfileRow.MarkKnownGoodButton" Command="{x:Bind MarkKnownGoodCommand}" Style="{StaticResource Action}"
                                                Visibility="{x:Bind views:PageDensity.Advanced(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode), Mode=OneWay}"
                                                loc:Loc.Tooltip="Environment.ProfileRow.MarkKnownGoodButton.Tooltip" />
                                        <Button loc:Loc.Content="Environment.ProfileRow.RemoveButton" Command="{x:Bind DeleteCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.ProfileRow.RemoveButton.Tooltip" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock loc:Loc.Text="Environment.DeletedProfilesHeading" Style="{StaticResource SubHeadingText}"
                               Visibility="{x:Bind ViewModel.DeletedProfiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.DeletedProfiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}"
                               loc:Loc.Text="Environment.DeletedProfilesBlurb" Foreground="{StaticResource AlkSteelGrayBrush}" />
                    <ListView ItemsSource="{x:Bind ViewModel.DeletedProfiles}" SelectionMode="None"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.DeletedProfiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeletedProfileRowViewModel">
                                <Grid ColumnSpacing="8" Padding="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="260" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind RemovedText}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ContentText}" Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" Foreground="{StaticResource AlkMutedTextBrush}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button loc:Loc.Content="Environment.DeletedProfileRow.RestoreButton" Command="{x:Bind RestoreCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.DeletedProfileRow.RestoreButton.Tooltip" />
                                        <Button loc:Loc.Content="Environment.DeletedProfileRow.DeleteButton" Command="{x:Bind DiscardCommand}" Style="{StaticResource DangerAction}"
                                                loc:Loc.Tooltip="Environment.DeletedProfileRow.DeleteButton.Tooltip" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Collapsed by default: the dated copies are a safety net, and listed open they
                         pushed the profiles and the comparison below them out of view. -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              loc:Loc.AutomationName="Environment.BackupsHeading"
                              loc:Loc.Tooltip="Environment.BackupsExpander.Tooltip">
                        <Expander.Header>
                            <TextBlock loc:Loc.Text="Environment.BackupsHeading" Style="{StaticResource SubHeadingText}" />
                        </Expander.Header>
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       loc:Loc.Text="Environment.BackupsBlurb" Foreground="{StaticResource AlkSteelGrayBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BackupRootPath}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" Foreground="{StaticResource AlkMutedTextBrush}" />

                            <!-- Plain items, not a ListView: at most ten rows that select nothing, and a
                                 virtualizing list recycled their buttons as the card scrolled. -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Backups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                                        <Grid ColumnSpacing="8" Padding="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="260" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind TakenText}" Style="{StaticResource BodyText}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind LabelText}" Style="{StaticResource BodyText}"
                                                               TextWrapping="Wrap" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ContentText}" Style="{StaticResource BodyText}"
                                                           TextWrapping="Wrap" Foreground="{StaticResource AlkMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button loc:Loc.Content="Environment.BackupRow.RestoreButton" Command="{x:Bind RestoreCommand}" Style="{StaticResource Action}"
                                                        loc:Loc.Tooltip="Environment.BackupRow.RestoreButton.Tooltip" />
                                                <Button loc:Loc.Content="Environment.BackupRow.CompareButton" Command="{x:Bind CompareCommand}" Style="{StaticResource Action}"
                                                        loc:Loc.Tooltip="Environment.BackupRow.CompareButton.Tooltip" />
                                                <Button loc:Loc.Content="Environment.BackupRow.DeleteButton" Command="{x:Bind DiscardCommand}" Style="{StaticResource DangerAction}"
                                                        loc:Loc.Tooltip="Environment.BackupRow.DeleteButton.Tooltip" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{x:Bind ViewModel.ComparisonTitle, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ComparisonLines.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />
                    <ListView ItemsSource="{x:Bind ViewModel.ComparisonLines}" SelectionMode="None"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.ComparisonLines.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                </ScrollViewer>
            </controls:CardShell>
        </Grid>

        <controls:PanelSplitter x:Name="SideSplitter" Grid.Row="2" Grid.Column="1" SectionKey="PlaySideWidth" />

        <StackPanel x:Name="StatusBand" Grid.Row="3" Grid.ColumnSpan="2" Spacing="6">
            <!-- Each result takes the full width of the band. A horizontal row beside a fixed 620px
                 scroller cut Last written, held changes and leftover text off at the window's right edge. -->
            <ScrollViewer MaxHeight="84" HorizontalAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top" IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </ScrollViewer>
            <TextBlock Text="{x:Bind ViewModel.LastWrittenText, Mode=OneWay}" Style="{StaticResource BodyText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource AlkSuccessOliveGoldBrush}" IsTextSelectionEnabled="True"
                       loc:Loc.Tooltip="Environment.LastWrittenText.Tooltip"
                       Visibility="{x:Bind ViewModel.LastWrittenText, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ShowHeldChangesNote, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock loc:Loc.Text="Environment.HeldChangesNote" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource AlkAlertAmberBrush}" IsTextSelectionEnabled="False"
                           loc:Loc.Tooltip="Environment.HeldChangesNote.Tooltip" />
                <Button Grid.Column="1" loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptHeldChangesCommand}" Style="{StaticResource RowAction}"
                        VerticalAlignment="Top"
                        loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.LeftoverSummary, Mode=OneWay}" Style="{StaticResource BodyText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource AlkAlertAmberBrush}" IsTextSelectionEnabled="True"
                       Visibility="{x:Bind ViewModel.HasLeftovers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <controls:WrapPanel Spacing="8" Visibility="{x:Bind ViewModel.HasLeftovers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Button loc:Loc.Content="Environment.ClearLeftoversButton" Command="{x:Bind ViewModel.ClearLeftoversCommand}"
                        loc:Loc.Tooltip="Environment.ClearLeftoversButton.Tooltip" />
                <Button loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptLeftoversCommand}"
                        loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip" />
            </controls:WrapPanel>

            <!-- One line, only while a dry run is going, naming the module currently loading. -->
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsDryRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing IsActive="{x:Bind ViewModel.IsDryRunning, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DryRunProgressText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" loc:Loc.Content="Environment.CancelDryRunButton" Command="{x:Bind ViewModel.CancelDryRunCommand}" Style="{StaticResource Action}" MinWidth="90"
                        loc:Loc.Tooltip="Environment.CancelDryRunButton.Tooltip" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
