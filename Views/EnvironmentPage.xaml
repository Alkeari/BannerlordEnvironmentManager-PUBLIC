<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.EnvironmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:launcher="using:BannerlordEnvironmentManager.Core.Launcher"
    xmlns:loadorder="using:BannerlordEnvironmentManager.Core.LoadOrder"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="TextToVisibility" />

        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="{StaticResource AlkPillCornerRadius}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource AlkDeepGraphiteBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AlkWarmGoldShadowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ModuleList's ItemTemplateSelector. Living here rather than nested inside
             ListView.ItemTemplate because ItemTemplate is DataTemplate-typed and a
             ModuleRowTemplateSelector is not a DataTemplate: setting the selector as ItemTemplate's
             value crashes the XAML compiler instead of producing a diagnostic. ItemTemplateSelector
             is the property meant for this. -->
        <views:ModuleRowTemplateSelector x:Key="ModuleRowTemplates">
            <views:ModuleRowTemplateSelector.ModuleTemplate>
                <DataTemplate x:DataType="vm:ModuleRowViewModel">
                    <Border Background="{x:Bind SelectionBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind SelectionBorder, Mode=OneWay}"
                            BorderThickness="2" CornerRadius="0" Padding="2">
                    <Grid ColumnSpacing="12" Padding="6,3" Background="Transparent"
                          ContextRequested="OnModuleRowContextRequested"
                          MinHeight="{x:Bind views:RowDensityHeight.For(views:ShellViewModels.Instance.NavigationSettings.RowDensity), Mode=OneWay}"
                          Opacity="{x:Bind CanToggle, Converter={StaticResource BoolToOpacity}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Every TextBlock in this row opts out of text selection. The row drags to
                             reorder the load order, and a selectable TextBlock captures the pointer
                             on press, so the drag would never start from wherever the text is. What
                             is worth copying off a row is on its context menu instead. -->
                        <TextBlock Text="{x:Bind Position, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                        <CheckBox Grid.Column="1" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}" Style="{StaticResource AlkCheckBox}"
                                  loc:Loc.Tooltip="Environment.ModuleEnabledCheckBox.Tooltip" />

                        <StackPanel Grid.Column="2" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource SubHeadingText}" IsTextSelectionEnabled="False" />
                                <!-- What Auto-Sort leads with, on the row it decided. The tooltip
                                     carries the reason so the sort's rationale is readable here
                                     rather than only in the sort menu. -->
                                <TextBlock Text="{x:Bind TierText, Mode=OneWay}" Style="{StaticResource MarkText}"
                                           ToolTipService.ToolTip="{x:Bind TierTooltip, Mode=OneWay}"
                                           Visibility="{x:Bind ShowTier, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{x:Bind OfficialText}" Style="{StaticResource MarkText}"
                                           ToolTipService.ToolTip="{x:Bind OfficialTooltip}"
                                           Visibility="{x:Bind IsOfficial, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.Workshop.Name" Style="{StaticResource MarkText}"
                                           Visibility="{x:Bind IsWorkshop, Converter={StaticResource BoolToVisibility}}" />
                                <!-- The other half of Workshop. A community module came from one place
                                     or the other, and naming only one left every Nexus mod looking
                                     as though it had no origin at all. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.Nexus.Name" Style="{StaticResource MarkText}"
                                           loc:Loc.Tooltip="Environment.NexusMark.Tooltip"
                                           Visibility="{x:Bind ShowNexus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <!-- A gap in what BEM knows, never shown for a Workshop module, which
                                     is not supposed to have a Nexus id and would be thirteen false
                                     alarms on this install. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.NoNexusId.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.NoNexusIdMark.Tooltip"
                                           Visibility="{x:Bind ShowNoNexusId, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock loc:Loc.Text="Environment.OrphanMark" Style="{StaticResource MarkActionText}"
                                           Visibility="{x:Bind IsOrphan, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.Unreadable.Name" Style="{StaticResource MarkActionText}"
                                           Visibility="{x:Bind IsUnreadable, Converter={StaticResource BoolToVisibility}}" />
                                <!-- The update verdict, on the row it is about. Amber because it is the
                                     one thing here the user may want to act on; Out of date and
                                     Probably are separate words because they are separate claims.
                                     One compares the file Nexus published against the file that was
                                     installed, the other reasons about a date because nothing
                                     identified the file. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.OutOfDate.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.OutOfDateMark.Tooltip"
                                           Visibility="{x:Bind IsOutOfDate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.ProbablyOutOfDate.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.ProbablyOutOfDateMark.Tooltip"
                                           Visibility="{x:Bind IsProbablyOutOfDate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Two sources naming two different mod pages, which is the reason
                                     behind an unknown often enough that it gets said instead of it.
                                     Amber rather than gray because unlike the rest of the unknowns
                                     this one has a fix, and the fix is on this row's own menu. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.IdConflict.Name" Style="{StaticResource MarkActionText}"
                                           loc:Loc.Tooltip="Environment.IdConflictMark.Tooltip"
                                           Visibility="{x:Bind HasIdConflict, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Gray, not amber. An unknown is a gap in what BEM knows and not a
                                     problem with the mod, and the count at the top of the tab named
                                     five of these with nothing on any row to find them by. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.UpdateUnknown.Name" Style="{StaticResource MarkText}"
                                           loc:Loc.Tooltip="Environment.UnknownUpdateMark.Tooltip"
                                           Visibility="{x:Bind ShowUnknownUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Pinned is the user's own decision about the row rather than something
                                     read off the manifest, so it carries a color instead of the dimmed
                                     treatment the computed badges use. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.Pinned.Name" Style="{StaticResource MarkText}" Foreground="{StaticResource AlkWarmGoldShadowBrush}"
                                           Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <!-- The user's own statement, so it gets the same colored treatment
                                     as Pinned rather than the dimmed one the computed badges use. -->
                                <TextBlock loc:Loc.Text="Environment.Filter.NotOnNexus.Name" Style="{StaticResource MarkText}" Foreground="{StaticResource AlkWarmGoldShadowBrush}"
                                           loc:Loc.Tooltip="Environment.NotOnNexusMark.Tooltip"
                                           Visibility="{x:Bind IsNotOnNexus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock loc:Loc.Text="Environment.Filter.BuiltHere.Name" Style="{StaticResource MarkText}" Foreground="{StaticResource AlkWarmGoldShadowBrush}"
                                           loc:Loc.Tooltip="Environment.BuiltHereMark.Tooltip"
                                           Visibility="{x:Bind IsBuiltLocally, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ModuleIdText}" Style="{StaticResource MonoText}" IsTextSelectionEnabled="False" />
                            <TextBlock Text="{x:Bind IssueSummary, Mode=OneWay}" Style="{StaticResource MetaText}" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                                       Visibility="{x:Bind IssueSummary, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                            <Expander HorizontalAlignment="Left" IsExpanded="False" Padding="12,4,12,8"
                                      AutomationProperties.Name="{x:Bind NotesAutomationName}"
                                      Visibility="{x:Bind AreNotesVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Expander.Header>
                                    <TextBlock Text="{x:Bind NotesHeader, Mode=OneWay}" Style="{StaticResource BodyText}"
                                               IsTextSelectionEnabled="False"
                                               loc:Loc.Tooltip="Environment.ModuleNotesExpander.Header.Tooltip" Foreground="{StaticResource AlkMutedTextBrush}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{x:Bind Notes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <!-- Expander bodies are normally safe to select in, but this one
                                                 is inside the draggable row, so it opts out too. -->
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2"
                                                       IsTextSelectionEnabled="False" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{x:Bind VersionText}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="False" Foreground="{StaticResource AlkMutedTextBrush}" />
                    </Grid>
                    </Border>
                </DataTemplate>
            </views:ModuleRowTemplateSelector.ModuleTemplate>
            <views:ModuleRowTemplateSelector.DividerTemplate>
                <DataTemplate x:DataType="vm:DividerRowViewModel">
                    <!-- MinHeight matches the module row's own density-driven height (RowDensityHeight.For)
                         rather than sizing to its single line of text: a divider was the shortest row in
                         the list by a wide margin, and WinUI's drag-reorder computes insertion position
                         from row geometry, so dragging it past taller module rows tracked the pointer
                         poorly - this closes that height mismatch. -->
                    <Border Background="{StaticResource AlkDeepGraphiteBrush}" CornerRadius="0"
                            MinHeight="{x:Bind views:RowDensityHeight.For(views:ShellViewModels.Instance.NavigationSettings.RowDensity), Mode=OneWay}">
                        <Border.ContextFlyout>
                            <MenuFlyout Opening="OnDividerContextMenuOpening">
                                <MenuFlyoutItem loc:Loc.Text="Environment.RenameDividerMenuItem" Click="OnRenameDividerClicked"
                                                loc:Loc.Tooltip="Environment.RenameDividerMenuItem.Tooltip" />
                                <MenuFlyoutItem Text="{x:Bind CollapseExpandLabel, Mode=OneWay}"
                                                Click="OnToggleDividerCollapsedClicked"
                                                loc:Loc.Tooltip="Environment.CollapseExpandDividerMenuItem.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Environment.RemoveDividerMenuItem" Click="OnRemoveDividerClicked"
                                                loc:Loc.Tooltip="Environment.RemoveDividerMenuItem.Tooltip" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <!-- ContextRequested lives on this stretched, transparent child rather than the
                             Border above: a Border that owns ContextFlyout marks ContextRequested handled
                             in native code before any app handler on that same element runs
                             (CUIElement::OnContextRequestedCore), so a handler on the flyout owner itself
                             never fires. -->
                        <Grid Background="Transparent" Padding="10,6"
                              ContextRequested="OnDividerRowContextRequested">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                           Style="{StaticResource LabelText}"
                                           Foreground="{StaticResource AlkSoftChampagneBrush}"
                                           IsTextSelectionEnabled="False" />
                                <TextBlock Text="{x:Bind HiddenCountText, Mode=OneWay}"
                                           Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource AlkSteelGrayBrush}"
                                           IsTextSelectionEnabled="False"
                                           Visibility="{x:Bind Collapsed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </views:ModuleRowTemplateSelector.DividerTemplate>
        </views:ModuleRowTemplateSelector>

    </Page.Resources>

    <!-- Seven bands, and the load order is the one with a floor. Everything that appears later sits in
         a band above or below it and is fitted into what is left over, which is the job UpdateRegionBudget
         in the code-behind does: a star row on its own is whatever the Auto rows did not take, and the
         Auto rows here could take all of it. -->
    <Grid x:Name="PageRoot" Padding="20,14,20,16" RowSpacing="12" SizeChanged="OnLayoutBandSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- The floor the page is sized around is six rows at the standard density plus the panel's
                 frame, and it is delivered by UpdateRegionBudget, which hands the bands below only what
                 is left after it. This smaller number is the backstop under that: in a window too short
                 for the budget to hold the floor, the list is still three rows and a list rather than a
                 sliver. It is deliberately not the floor itself, because a star row forced past the
                 window pushes the bands below it off the bottom, where there is no scrollbar to bring
                 them back and the panel the reader just opened is the one that vanishes. -->
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderBand" ColumnSpacing="16" SizeChanged="OnLayoutBandSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Two shares against the facts' one, and a share rather than Auto because a Grid hands
                     an Auto column an unbounded width: what is in it never yields, so the launch row was
                     what ran off the right edge while the facts beside it were squeezed to nothing. The
                     row is about twice the width of those facts, so it takes twice the space and gives
                     it up last, and what a narrow window cannot fit is reached sideways below. -->
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <controls:PageHeader TitleKey="Environment.Title" BlurbKey="Environment.Blurb" />
                <!-- A stack that wraps rather than one horizontal row. A row lays its children out against
                     an unbounded width, so an instance folder with a long name pushed every fact after the
                     path past the edge of this column, where it was clipped rather than reachable. Each
                     fact now wraps inside the column, so all of it is readable however long the name. -->
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.GameInstallPath, Mode=OneWay}" Style="{StaticResource MonoText}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.GameVersionText, Mode=OneWay}" Style="{StaticResource MetaText}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.LaunchTargetText, Mode=OneWay}" Style="{StaticResource MetaText}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <!-- The budget is advanced reading right up until it is nearly spent, at which
                         point it is a finding and the floor applies: a load order about to stop
                         fitting on the command line is shown whatever the mode. -->
                    <TextBlock Text="{x:Bind ViewModel.CommandLineText, Mode=OneWay}" Style="{StaticResource MetaText}"
                               Foreground="{x:Bind CommandLineBrush(ViewModel.CommandLineIsTight), Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Visibility="{x:Bind views:PageDensity.Show(Navigation.IsAdvancedMode, ViewModel.CommandLineIsTight), Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.CommandLineTooltip}" />
                </StackPanel>

                <!-- What the version dropdown has to say sits under the facts it changes: what
                     switched, and how far a download started on Versions has reached. Read-only
                     here: a base game download runs for hours and the user is very likely sitting
                     on this page while it does, but nothing on Play starts, cancels or otherwise
                     drives one, and the Steam sign-in a download asks for is shown on Versions,
                     with the button that asked for it. -->
                <!-- Fixed width and height on purpose. The status line rewrites itself several
                     times a second during a download and each message is a different length, so
                     a label that wrapped and re-measured moved every row on the page under it,
                     fast enough to be unreadable. The box keeps its footprint whatever it says;
                     only its contents change. -->
                <Grid Width="520" Height="56" HorizontalAlignment="Left" RowSpacing="6"
                      Visibility="{x:Bind DownloadStatusVisibility(ViewModel.VersionSwitcher.IsProgressVisible), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.VersionSwitcher.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource MetaText}" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                               IsTextSelectionEnabled="True"
                               ToolTipService.ToolTip="{x:Bind ViewModel.VersionSwitcher.StatusMessage, Mode=OneWay}" />
                    <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.VersionSwitcher.ProgressValue, Mode=OneWay}"
                                 Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.VersionSwitcher.IsProgressVisible, Mode=OneWay}"
                                 loc:Loc.Tooltip="Environment.DownloadProgressBar.Tooltip" />
                </Grid>

                <!-- With nothing installed the dropdown beside Launch has nothing to offer, so it is
                     taken away rather than left as an empty control, and this says where a version
                     comes from. -->
                <controls:EmptyState Kind="Empty" HorizontalAlignment="Left"
                                     Title="{x:Bind NoVersionsTitle}" Reason="{x:Bind NoVersionsReason}"
                                     Visibility="{x:Bind NoVersionsVisibility(ViewModel.VersionSwitcher.HasInstalledVersions), Mode=OneWay}">
                    <Button loc:Loc.Content="Environment.NoVersionsButton" Click="OnOpenVersionsRequested"
                            Style="{StaticResource PrimaryAction}" MinWidth="170"
                            loc:Loc.Tooltip="Environment.NoVersionsButton.Tooltip" />
                </controls:EmptyState>
            </StackPanel>

            <!-- Launching is its own job, so it sits with the facts about what would launch rather than
                 in the toolbar the load order is edited from. -->
            <!-- Two rows rather than one: the pickers, then the checks and Launch. As a single row they
                 came to about 1100 px that none of them gives up, plus however wide the selected
                 version's name made its picker, which is more than this column has even on a very wide
                 window, so the row scrolled where it should simply have fit. Split, each row is roughly
                 half that. Only a genuinely narrow window still scrolls the pair sideways, right-aligned
                 so the rows keep their place where they fit. Sideways only: the page scroller owns the
                 other axis, so there is one bar per direction.
                 The column this sits in is a share rather than Auto for the same reason. A Grid hands
                 an Auto column an unbounded width, so the column would have taken the row's full 1100
                 whatever the window had, the scroller inside it would have measured to its content and
                 never scrolled, and the facts beside it would have been squeezed to nothing first. -->
            <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <!-- Which game version this whole page is about. Everything below it, the load order
                         included, is read from the version picked here. Only versions already on this
                         machine are listed, so picking one switches and can never begin a download;
                         getting a version onto the machine is the Versions page's Download button. -->
                    <ComboBox ItemsSource="{x:Bind ViewModel.VersionSwitcher.InstalledVersions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.VersionSwitcher.SelectedVersion, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.VersionSwitcher.IsIdle, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.VersionSwitcher.HasInstalledVersions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              MinWidth="200" MaxWidth="420" VerticalAlignment="Center"
                              loc:Loc.Tooltip="Environment.VersionComboBox.Tooltip">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameVersionRowViewModel">
                                <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <!-- The name takes the share and wraps inside the capped picker, so
                                             a long instance name is read in full rather than cut. -->
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DisplayLabel}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateText}" Style="{StaticResource MetaText}"
                                               HorizontalAlignment="Right" IsTextSelectionEnabled="False" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableTargets}"
                              SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                              MinWidth="220" VerticalAlignment="Center"
                              loc:Loc.Tooltip="Environment.LaunchTargetComboBox.Tooltip">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="launcher:LaunchTarget">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           ToolTipService.ToolTip="{x:Bind launcher:LaunchTargetResolver.DescribeTooltip(Kind)}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Why the list above is short, beside the list rather than in the status line, where
                         it was a second and third sentence after every load result and ran off the end of
                         the line. Fixed width so appearing and disappearing cannot move the row, and the
                         whole explanation is on the hover. -->
                    <TextBlock Text="{x:Bind ViewModel.LaunchTargetNote, Mode=OneWay}"
                               Style="{StaticResource MetaText}" Width="230" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" IsTextSelectionEnabled="True"
                               loc:Loc.Tooltip="Environment.LaunchTarget.OnlyDirectNote.Tooltip"
                               Visibility="{x:Bind ViewModel.LaunchTargetNote, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <!-- Secondary, and deliberately beside Launch: the question "will this go wrong" arises
                         exactly where launching does. This is the static half only, no game started; the
                         live boot check that actually starts the game moved to Boot Checks. -->
                    <Button loc:Loc.Content="Environment.CheckPreflightButton" Command="{x:Bind ViewModel.CheckPreflightCommand}" Style="{StaticResource Action}" MinWidth="210"
                            loc:Loc.Tooltip="Environment.CheckPreflightButton.Tooltip" />
                    <!-- Arming, where the launching happens. It is the same armed watch the Watch page
                         owns, and it stays on across restarts until it is turned off. -->
                    <CheckBox loc:Loc.Content="Environment.WatchLaunchesCheckBox"
                              IsChecked="{x:Bind ViewModel.IsWatchArmed, Mode=TwoWay}"
                              Style="{StaticResource AlkCheckBox}"
                              VerticalAlignment="Center"
                              loc:Loc.Tooltip="Environment.WatchLaunchesCheckBox.Tooltip" />
                    <!-- A disabled Button shows no tooltip of its own, and the button's own text is what
                         says whether the next launch is watched. -->
                    <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.LaunchTooltip, Mode=OneWay}">
                        <Button Content="{x:Bind ViewModel.LaunchButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.LaunchCommand}" Style="{StaticResource PrimaryAction}" MinWidth="150" />
                    </Border>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="28" Height="28" />
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- One row per job the user actually does, rather than one row of everything. Arranging the
             order is the frequent one and keeps the first band to itself; checking it and writing it
             out share the second. The scroller is what stops a narrow window putting a button out of
             reach, the same way it already does for the filter chips. -->
        <ScrollViewer x:Name="ToolbarBand" Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                      SizeChanged="OnLayoutBandSizeChanged">
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="Transparent"
                        loc:Loc.Tooltip="Environment.AutoSortButton.Tooltip">
                    <Button loc:Loc.Content="Environment.AutoSortButton" Command="{x:Bind ViewModel.AutoSortCommand}" Style="{StaticResource Action}" />
                </Border>
                <!-- A disabled Button shows no tooltip of its own, so the tooltip lives on this wrapper.
                     Undo is grayed out with a reason rather than clickable and inert. -->
                <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.UndoReason, Mode=OneWay}">
                    <Button loc:Loc.Content="Environment.UndoButton" Command="{x:Bind ViewModel.UndoCommand}" Style="{StaticResource Action}" />
                </Border>
                <!-- Auto-Sort is the everyday sort; the key-stacking machinery behind this menu is
                     Advanced. Hiding the menu abandons no state: keys already chosen keep governing
                     the order they last produced, and Auto-Sort and Undo still work in Basic. -->
                <DropDownButton Content="{x:Bind ViewModel.SortLabel, Mode=OneWay}" Style="{StaticResource Action}" MaxWidth="360"
                                Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                                loc:Loc.Tooltip="Environment.SortDropDown.Tooltip">
                    <DropDownButton.Flyout>
                        <Flyout>
                            <StackPanel Spacing="8" MinWidth="320">
                                <TextBlock loc:Loc.Text="Environment.SortFlyout.Heading" Style="{StaticResource SubHeadingText}" />
                                <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}"
                                           TextWrapping="Wrap" MaxWidth="320"
                                           loc:Loc.Text="Environment.SortFlyout.Description" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SortOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModuleSortViewModel">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Style="{StaticResource FilterChip}"
                                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                  Content="{x:Bind Label, Mode=OneWay}"
                                                                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                                  IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                                                  Command="{x:Bind SelectCommand}"
                                                                  AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                                                                  loc:Loc.Tooltip="Environment.SortKeyChip.Tooltip" />
                                                    <!-- Direction belongs to the key, not to the sort, so it
                                                         only exists once the key has a precedence number. -->
                                                    <Button Grid.Column="1" Style="{StaticResource Action}"
                                                            Content="{x:Bind DirectionText, Mode=OneWay}"
                                                            Command="{x:Bind ToggleDirectionCommand}"
                                                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="{x:Bind DirectionText, Mode=OneWay}"
                                                            loc:Loc.Tooltip="Environment.SortDirectionButton.Tooltip" />
                                                </Grid>
                                                <!-- A key only ever chooses between modules the declared
                                                     constraints leave free of each other. When nothing is
                                                     free for it to choose between, that is said here rather
                                                     than left to look broken. -->
                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="320"
                                                           Foreground="{StaticResource AlkAlertAmberBrush}"
                                                           Text="{x:Bind UnreachableNote, Mode=OneWay}"
                                                           Visibility="{x:Bind HasUnreachableNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- A disabled Button shows no tooltip of its own, so the tooltip lives on this
                                     wrapper. Clearing the keys is not an undo: it stops the menu claiming an
                                     order the list may no longer be in, and Undo is what puts the order back.
                                     It sits with the keys it clears rather than beside them in the toolbar. -->
                                <Border Background="Transparent" HorizontalAlignment="Left"
                                        loc:Loc.Tooltip="Environment.ClearSortKeysButton.Tooltip">
                                    <Button loc:Loc.Content="Environment.ClearSortKeysButton" Command="{x:Bind ViewModel.ClearSortCommand}" Style="{StaticResource Action}" />
                                </Border>

                                <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource AlkAlertAmberBrush}"
                                           TextWrapping="Wrap" MaxWidth="320"
                                           Text="{x:Bind ViewModel.SortLimitNote, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasSortLimitNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}"
                                           TextWrapping="Wrap" MaxWidth="320"
                                           loc:Loc.Text="Environment.SortFlyout.Footnote" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- Pins keep holding in Basic - a sort still honors them - only the panel that
                     manages them is Advanced. -->
                <DropDownButton Content="{x:Bind ViewModel.PinsLabel, Mode=OneWay}" Style="{StaticResource Action}" MaxWidth="200"
                                Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                                loc:Loc.Tooltip="Environment.PinsDropDown.Tooltip">
                    <DropDownButton.Flyout>
                        <Flyout>
                            <StackPanel Spacing="10" MinWidth="420" MaxWidth="460">
                                <TextBlock loc:Loc.Text="Environment.PinsFlyout.Heading" Style="{StaticResource SubHeadingText}" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.PinsSummary, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="Transparent"
                                            loc:Loc.Tooltip="Environment.PinEverythingButton.Tooltip">
                                        <Button loc:Loc.Content="Environment.PinEverythingButton" Command="{x:Bind ViewModel.PinEverythingInPlaceCommand}" Style="{StaticResource Action}" />
                                    </Border>
                                    <Border Background="Transparent"
                                            loc:Loc.Tooltip="Environment.RemoveAllPinsButton.Tooltip">
                                        <Button loc:Loc.Content="Environment.RemoveAllPinsButton" Command="{x:Bind ViewModel.ClearPinsCommand}" Style="{StaticResource Action}" />
                                    </Border>
                                </StackPanel>
                                <ListView ItemsSource="{x:Bind ViewModel.PinnedModules}" SelectionMode="None"
                                          MaxHeight="260" Background="Transparent" BorderThickness="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PinRowViewModel">
                                            <Grid ColumnSpacing="8" Padding="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyText}"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    <!-- A pin whose module is missing is kept and shown here rather than
                                                         dropped: the module comes back and so does the pin. -->
                                                    <TextBlock Text="{x:Bind PositionText}" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource AlkWarmGoldShadowBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" loc:Loc.Content="Environment.UnpinButton" Command="{x:Bind UnpinCommand}" Style="{StaticResource Action}"
                                                        loc:Loc.Tooltip="Environment.UnpinButton.Tooltip" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton loc:Loc.Content="Environment.BulkDropDown" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.BulkDropDown.Tooltip">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem loc:Loc.Text="Environment.EnableAllMenuItem" Command="{x:Bind ViewModel.EnableAllCommand}"
                                            loc:Loc.Tooltip="Environment.EnableAllMenuItem.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Environment.DisableAllMenuItem" Command="{x:Bind ViewModel.DisableAllCommand}"
                                            loc:Loc.Tooltip="Environment.DisableAllMenuItem.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Environment.InvertEnabledMenuItem" Command="{x:Bind ViewModel.InvertEnabledCommand}"
                                            loc:Loc.Tooltip="Environment.InvertEnabledMenuItem.Tooltip" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Prune stays out of the overflow: it appears only when there is something to
                     prune, so it is never a button that does nothing. -->
                <Button Command="{x:Bind ViewModel.PruneOrphansCommand}" Style="{StaticResource Action}"
                        loc:Loc.Tooltip="Environment.PruneButton.Tooltip"
                        Visibility="{x:Bind ViewModel.OrphanCount, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="{x:Bind ViewModel.PruneButtonText, Mode=OneWay}" />
                </Button>

                <DropDownButton loc:Loc.Content="Environment.ProfilesDropDown" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.ProfilesDropDown.Tooltip">
                    <DropDownButton.Flyout>
                        <!-- A flyout presenter is capped at 456 by FlyoutThemeMaxWidth, so the 560 the
                             content asked for was clipped and the Restore and Compare buttons sat off
                             the right edge. The floor that holds the widest real row is 820, and it sits
                             on the content rather than on the presenter: a presenter held open at 820 is
                             wider than a narrow window, and a popup is clipped to the window, which put
                             those same buttons past an edge nothing could reach. The presenter takes the
                             width it is given and scrolls the floored content sideways inside it, which
                             is also what carries the rows below whose name column keeps a floor of its
                             own. Sideways only: the scroller inside this flyout owns the other axis. -->
                        <Flyout>
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="960" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <!-- The one vertical scroller in this flyout. The lists inside it were each capped
                                 and each scrolled on its own, which put a second bar alongside this one:
                                 a reader who cannot tell which bar they are moving reads the list as
                                 broken and scrolls the wrong thing, and where the two bars overlapped
                                 they ran into each other. The lists size to their content now and this
                                 is what moves. -->
                            <ScrollViewer MaxHeight="560" HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="10" MinWidth="820">
                                    <TextBlock loc:Loc.Text="Environment.ProfilesFlyout.Heading" Style="{StaticResource SubHeadingText}" />
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               loc:Loc.Text="Environment.ProfilesFlyout.Blurb" Foreground="{StaticResource AlkSteelGrayBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Capped at the length a shared profile file can carry, so a
                                             name typed here is always one an import can read back. -->
                                        <TextBox Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 loc:Loc.Placeholder="Environment.NewProfileNameBox.Placeholder" MinWidth="220"
                                                 MaxLength="{x:Bind ViewModel.MaxProfileNameLength}"
                                                 loc:Loc.Tooltip="Environment.NewProfileNameBox.Tooltip" />
                                        <Button loc:Loc.Content="Environment.SaveProfileButton" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.SaveProfileButton.Tooltip" />
                                        <Border Background="Transparent"
                                                loc:Loc.Tooltip="Environment.KnownGoodButton.Tooltip">
                                            <!-- The label carries a profile name, so it is capped rather
                                                 than allowed to push the row past the flyout edge. -->
                                            <Button Content="{x:Bind ViewModel.KnownGoodLabel, Mode=OneWay}" MaxWidth="280"
                                                    Command="{x:Bind ViewModel.ReturnToKnownGoodCommand}" Style="{StaticResource Action}" />
                                        </Border>
                                        <Button loc:Loc.Content="Environment.ImportProfileButton" Command="{x:Bind ViewModel.ImportProfileCommand}" Style="{StaticResource Action}"
                                                loc:Loc.Tooltip="Environment.ImportProfileButton.Tooltip" />
                                    </StackPanel>

                                    <ListView ItemsSource="{x:Bind ViewModel.Profiles}" SelectionMode="None"
                                              Background="Transparent" BorderThickness="0"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProfileRowViewModel">
                                                <!-- Every variable-length field trims rather than growing.
                                                     A horizontal StackPanel hands its children unbounded
                                                     width, so trimming inside one never fires and a long
                                                     name pushed the buttons off the edge. -->
                                                <Grid ColumnSpacing="8" Padding="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="260" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind KnownGoodText}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind SavedText}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ContentText}" Style="{StaticResource BodyText}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button loc:Loc.Content="Environment.ProfileRow.RestoreButton" Command="{x:Bind RestoreCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.ProfileRow.RestoreButton.Tooltip" />
                                                        <Button loc:Loc.Content="Environment.ProfileRow.CompareButton" Command="{x:Bind CompareCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.ProfileRow.CompareButton.Tooltip" />
                                                        <Button loc:Loc.Content="Environment.ProfileRow.ExportButton" Command="{x:Bind ExportCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.ProfileRow.ExportButton.Tooltip" />
                                                        <Button loc:Loc.Content="Environment.ProfileRow.MarkKnownGoodButton" Command="{x:Bind MarkKnownGoodCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.ProfileRow.MarkKnownGoodButton.Tooltip" />
                                                        <Button loc:Loc.Content="Environment.ProfileRow.RemoveButton" Command="{x:Bind DeleteCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.ProfileRow.RemoveButton.Tooltip" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock loc:Loc.Text="Environment.DeletedProfilesHeading" Style="{StaticResource SubHeadingText}"
                                               Visibility="{x:Bind ViewModel.DeletedProfiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               Visibility="{x:Bind ViewModel.DeletedProfiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}"
                                               loc:Loc.Text="Environment.DeletedProfilesBlurb" Foreground="{StaticResource AlkSteelGrayBrush}" />
                                    <ListView ItemsSource="{x:Bind ViewModel.DeletedProfiles}" SelectionMode="None"
                                              Background="Transparent" BorderThickness="0"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              Visibility="{x:Bind ViewModel.DeletedProfiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeletedProfileRowViewModel">
                                                <Grid ColumnSpacing="8" Padding="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="260" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind RemovedText}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ContentText}" Style="{StaticResource BodyText}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button loc:Loc.Content="Environment.DeletedProfileRow.RestoreButton" Command="{x:Bind RestoreCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.DeletedProfileRow.RestoreButton.Tooltip" />
                                                        <Button loc:Loc.Content="Environment.DeletedProfileRow.DeleteButton" Command="{x:Bind DiscardCommand}" Style="{StaticResource DangerAction}"
                                                                loc:Loc.Tooltip="Environment.DeletedProfileRow.DeleteButton.Tooltip" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock loc:Loc.Text="Environment.BackupsHeading" Style="{StaticResource SubHeadingText}" />
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               loc:Loc.Text="Environment.BackupsBlurb" Foreground="{StaticResource AlkSteelGrayBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.BackupRootPath}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" Foreground="{StaticResource AlkMutedTextBrush}" />

                                    <ListView ItemsSource="{x:Bind ViewModel.Backups}" SelectionMode="None"
                                              Background="Transparent" BorderThickness="0"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BackupRowViewModel">
                                                <Grid ColumnSpacing="8" Padding="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="260" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind TakenText}" Style="{StaticResource BodyText}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind LabelText}" Style="{StaticResource BodyText}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind ContentText}" Style="{StaticResource BodyText}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AlkMutedTextBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button loc:Loc.Content="Environment.BackupRow.RestoreButton" Command="{x:Bind RestoreCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.BackupRow.RestoreButton.Tooltip" />
                                                        <Button loc:Loc.Content="Environment.BackupRow.CompareButton" Command="{x:Bind CompareCommand}" Style="{StaticResource Action}"
                                                                loc:Loc.Tooltip="Environment.BackupRow.CompareButton.Tooltip" />
                                                        <Button loc:Loc.Content="Environment.BackupRow.DeleteButton" Command="{x:Bind DiscardCommand}" Style="{StaticResource DangerAction}"
                                                                loc:Loc.Tooltip="Environment.BackupRow.DeleteButton.Tooltip" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock Text="{x:Bind ViewModel.ComparisonTitle, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               Visibility="{x:Bind ViewModel.ComparisonLines.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}" />
                                    <ListView ItemsSource="{x:Bind ViewModel.ComparisonLines}" SelectionMode="None"
                                              Background="Transparent" BorderThickness="0"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              Visibility="{x:Bind ViewModel.ComparisonLines.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- Everything reached rarely, behind one press. Eleven buttons across two bands is
                     eleven things to read past to get at the list, which is the point of the tab. -->
                <DropDownButton loc:Loc.Content="Environment.MoreDropDown" Style="{StaticResource Action}"
                                loc:Loc.Tooltip="Environment.MoreDropDown.Tooltip">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem loc:Loc.Text="Environment.ValidateMenuItem" Command="{x:Bind ViewModel.ValidateCommand}"
                                            loc:Loc.Tooltip="Environment.ValidateMenuItem.Tooltip" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Environment.ImportLoadOrderMenuItem" Command="{x:Bind ViewModel.ImportLoadOrderCommand}"
                                            loc:Loc.Tooltip="Environment.ImportLoadOrderMenuItem.Tooltip" />
                            <MenuFlyoutItem loc:Loc.Text="Environment.ExportLoadOrderMenuItem" Command="{x:Bind ViewModel.ExportLoadOrderCommand}"
                                            loc:Loc.Tooltip="Environment.ExportLoadOrderMenuItem.Tooltip" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Loc.Text="Environment.RereadFromDiskMenuItem" Click="OnRefreshClicked"
                                            loc:Loc.Tooltip="Environment.RereadFromDiskMenuItem.Tooltip" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- The update controls live inside the count they change, rather than in a boxed band
                     of their own between the filters and the list. The button reads the answer; opening
                     it is what costs anything. -->
                <DropDownButton Content="{x:Bind ViewModel.UpdateCheckStatus, Mode=OneWay}" Style="{StaticResource Action}" MaxWidth="320"
                                ToolTipService.ToolTip="{x:Bind ViewModel.UpdateCheckDetail, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowNexusUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <DropDownButton.Flyout>
                        <Flyout>
                            <!-- Two workflows, not one list: Fetch Fresh belongs to the update check
                                 and Rebuild Every Mod ID belongs to the Nexus query, but the flat
                                 stack interleaved checkboxes and buttons until neither read as
                                 owning the other. Each checkbox now sits directly under its own
                                 heading with the buttons it modifies, and a hairline splits the two
                                 groups the way the row's other flyouts use separators. -->
                            <StackPanel Spacing="10" MinWidth="330">
                                <TextBlock loc:Loc.Text="Environment.UpdatesFlyout.Heading" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{x:Bind ViewModel.UpdateCheckDetail, Mode=OneWay}" Style="{StaticResource MetaText}"
                                           TextWrapping="Wrap" MaxWidth="330"
                                           Visibility="{x:Bind ViewModel.UpdateCheckDetail, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                                <CheckBox loc:Loc.Content="Environment.FetchFreshCheckBox" IsChecked="{x:Bind ViewModel.FetchFreshFromNexus, Mode=TwoWay}"
                                          loc:Loc.Tooltip="Environment.FetchFreshCheckBox.Tooltip" />
                                <Button loc:Loc.Content="Environment.CheckForUpdatesButton" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" Style="{StaticResource Action}"
                                        loc:Loc.Tooltip="Environment.CheckForUpdatesButton.Tooltip" />
                                <Button Content="{x:Bind ViewModel.AvailableUpdatesLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.InstallAvailableUpdatesCommand}"
                                        Style="{StaticResource PrimaryAction}"
                                        loc:Loc.Tooltip="Environment.InstallUpdatesButton.Tooltip" />
                                <!-- Mod-id repair is Advanced; update checking and installing above it
                                     are the everyday half of this flyout. -->
                                <StackPanel Spacing="10" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
                                    <Border Height="1" Background="{StaticResource AlkHairlineBrush}" Margin="0,2" />
                                    <TextBlock loc:Loc.Text="Environment.ModIdsSection.Heading" Style="{StaticResource SectionText}" />
                                    <CheckBox loc:Loc.Content="Environment.RebuildModIdsCheckBox" IsChecked="{x:Bind ViewModel.RebuildEveryModId, Mode=TwoWay}"
                                              loc:Loc.Tooltip="Environment.RebuildModIdsCheckBox.Tooltip" />
                                    <Button loc:Loc.Content="Environment.QueryNexusButton" Command="{x:Bind ViewModel.QueryNexusCommand}" Style="{StaticResource Action}"
                                            loc:Loc.Tooltip="Environment.QueryNexusButton.Tooltip" />
                                    <Button loc:Loc.Content="Environment.UndoRebuildButton" Command="{x:Bind ViewModel.UndoModIdRebuildCommand}" Style="{StaticResource Action}"
                                            loc:Loc.Tooltip="Environment.UndoRebuildButton.Tooltip"
                                            Visibility="{x:Bind ViewModel.CanUndoModIdRebuild, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.UpdateCheckRanAt, Mode=OneWay}" Style="{StaticResource MonoText}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="330"
                                           loc:Loc.Tooltip="Environment.UpdateCheckRanAtText.Tooltip" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button loc:Loc.Content="Environment.CancelUpdateCheckButton" Command="{x:Bind ViewModel.CancelUpdateCheckCommand}" Style="{StaticResource Action}"
                        Visibility="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        loc:Loc.Tooltip="Environment.CancelUpdateCheckButton.Tooltip" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <StackPanel x:Name="NoticeBand" Grid.Row="2" Spacing="10" SizeChanged="OnLayoutBandSizeChanged">
        <!-- A safety net has to be reachable from where the danger is. A guided search that BEM did
             not live through leaves an experiment's load order on disk, and nothing else on this
             page says which of the ten backups is the one from before it started. -->
        <!-- Fixed height, and the action beside the message rather than under it, for the reason the
             download box carries: this appears after the page is up, and a banner that sized itself to
             a message of unknown length took its height out of the load order below it. Two lines,
             then the ellipsis, and the whole message on the hover. -->
        <Border Height="96" Background="{StaticResource AlkSurfaceRaisedBrush}" Padding="14,12" CornerRadius="0"
                BorderBrush="{StaticResource AlkAlertAmberBrush}" BorderThickness="2,0,0,0"
                Visibility="{x:Bind ViewModel.HasInterruptedBisection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock loc:Loc.Text="Environment.InterruptedBisectionHeading" Style="{StaticResource SubHeadingText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.InterruptedBisectionNotice, Mode=OneWay}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.InterruptedBisectionNotice, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button loc:Loc.Content="Environment.RestoreInterruptedOrderButton" Command="{x:Bind ViewModel.RestoreInterruptedBisectionOrderCommand}" Style="{StaticResource PrimaryAction}" MinWidth="200"
                            loc:Loc.Tooltip="Environment.RestoreInterruptedOrderButton.Tooltip" />
                    <Button loc:Loc.Content="Environment.DismissInterruptedBisectionButton" Command="{x:Bind ViewModel.DismissInterruptedBisectionCommand}" Style="{StaticResource Action}" MinWidth="150"
                            loc:Loc.Tooltip="Environment.DismissInterruptedBisectionButton.Tooltip" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Reversal for the one folder BEM ever writes into the game, and for BEM's own id if it ever
             reached the saved load order. This reads the disk and the file, not a report, so it stays
             up across restarts until both are actually clear. Fixed height for the same reason as the
             banner above it. -->
        <Border Height="96" Background="{StaticResource AlkSurfaceRaisedBrush}" Padding="14,12" CornerRadius="0"
                BorderBrush="{StaticResource AlkAlertAmberBrush}" BorderThickness="2,0,0,0"
                Visibility="{x:Bind ViewModel.HasCompanionLeftBehind, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.CompanionLeftBehindTitle, Mode=OneWay}" Style="{StaticResource SubHeadingText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.CompanionLeftBehindNotice, Mode=OneWay}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                               ToolTipService.ToolTip="{x:Bind ViewModel.CompanionLeftBehindNotice, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" loc:Loc.Content="Environment.RemoveCompanionLeftBehindButton" Command="{x:Bind ViewModel.RemoveCompanionLeftBehindCommand}" Style="{StaticResource PrimaryAction}" MinWidth="200"
                        VerticalAlignment="Center"
                        loc:Loc.Tooltip="Environment.RemoveCompanionLeftBehindButton.Tooltip" />
            </Grid>
        </Border>

        <!-- Everything that narrows what the list shows, in one band: the search box, the chips and the
             notes toggle all answer "what am I looking at" and none of them touch the load order. The
             box stays put while the chips scroll, so it is never the thing that scrolled out of reach. -->
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         loc:Loc.Placeholder="Environment.SearchBox.Placeholder" MinWidth="260"
                         loc:Loc.Tooltip="Environment.SearchBox.Tooltip" />
                <CheckBox loc:Loc.Content="Environment.ShowNotesCheckBox" IsChecked="{x:Bind ViewModel.ShowNotes, Mode=TwoWay}"
                          Style="{StaticResource AlkCheckBox}" VerticalAlignment="Center"
                          loc:Loc.Tooltip="Environment.ShowNotesCheckBox.Tooltip" />
            </StackPanel>

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <!-- One button per question, each holding its own answers, several at a time. A flat
                     row of chips could only ask one thing at once, so "the Workshop mods that are out
                     of date" was not a question this tab could be asked at all. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilterGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleFilterGroupViewModel">
                                <DropDownButton Content="{x:Bind Label, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                Visibility="{x:Bind HasAny, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="8" MinWidth="260">
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodyText}"
                                                           TextWrapping="Wrap" Foreground="{StaticResource AlkSteelGrayBrush}" />
                                                <ItemsControl ItemsSource="{x:Bind Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ModuleFilterViewModel">
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      Content="{x:Bind Label, Mode=OneWay}"
                                                                      ToolTipService.ToolTip="{x:Bind Description}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button loc:Loc.Content="Environment.ClearFilterGroupButton" Command="{x:Bind ClearCommand}"
                                                        Style="{StaticResource Action}" HorizontalAlignment="Left"
                                                        loc:Loc.Tooltip="Environment.ClearFilterGroupButton.Tooltip"
                                                        Visibility="{x:Bind IsNarrowing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button loc:Loc.Content="Environment.ClearFiltersButton" Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            Style="{StaticResource Action}" VerticalAlignment="Center"
                            loc:Loc.Tooltip="Environment.ClearFiltersButton.Tooltip"
                            Visibility="{x:Bind ViewModel.IsFiltering, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!-- A button reading "Nexus: 2 selected" says a number and not which two, and why a
                         row is missing has to be readable without opening three menus to find out. -->
                    <!-- Fixed width and height, as the download box is. The summary grows with every
                         filter picked, and a label that wrapped freely grew this whole band downward
                         out of the load order's height while the user was picking filters to read the
                         list with. Two lines, then the ellipsis, and the rest on the hover. -->
                    <Grid Width="520" Height="40" VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.FilterSummary, Mode=OneWay, Converter={StaticResource TextToVisibility}}">
                        <TextBlock Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.FilterSummary, Mode=OneWay}"
                                   Foreground="{StaticResource AlkSteelGrayBrush}" IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource AlkSurfaceBrush}" Padding="8" CornerRadius="0"
                BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- A grayed-out drag target explains nothing on its own, so the reason it is off is
                     written out here, the same way narrowing the list already turns it off. -->
                <!-- Two lines at most, and the rest on the hover: this line sits inside the load order's
                     own panel, so a long reason wrapping freely takes its height off the list it is
                     explaining. -->
                <TextBlock Text="{x:Bind ViewModel.ReorderBlockedReason, Mode=OneWay}"
                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="4,2"
                           MaxLines="2" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.ReorderBlockedReason, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasReorderBlockedReason, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource AlkSteelGrayBrush}" />

                <!-- SelectedItem stays OneWay (VM to view only): DisplayRows is heterogeneous since
                     it carries dividers, and a TwoWay x:Bind here compiles to an unguarded cast down to
                     ModuleRowViewModel that throws the moment a DividerRowViewModel is selected. The
                     view-to-VM direction is written by hand in OnModuleSelectionChanged instead, with
                     a safe cast. -->
                <ListView x:Name="ModuleList" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.DisplayRows}"
                          ItemTemplateSelector="{StaticResource ModuleRowTemplates}"
                          SelectionMode="Single"
                          SelectedItem="{x:Bind ViewModel.SelectedModule, Mode=OneWay}"
                          CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          CanDragItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionChanged="OnModuleSelectionChanged"
                          ContextRequested="OnModuleContextRequested"
                          DragItemsStarting="OnDragItemsStarting"
                          DragItemsCompleted="OnDragItemsCompleted">
                    <!-- Empty on purpose: the default AddDeleteThemeTransition/ContentThemeTransition
                         play a delete-then-add animation on every drag-reorder, since WinUI's own
                         reorder always arrives as a genuine Remove followed by a genuine Add
                         (microsoft-ui-xaml #9685), never a Move. Removing them stops a real reorder
                         from visually looking like the row vanished and a new one appeared. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <!-- The default panel, declared only so ItemsUpdatingScrollMode can be stated
                         rather than assumed. The fix for the list losing its place leans on it: rows
                         are inserted and removed in place now instead of the collection being cleared
                         and refilled, and this is what holds the first visible row where it was while
                         that happens. ItemsUpdatingScrollMode belongs to the panel, not to ListView. -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <!-- The flyout lives on the list, not in the item template, so its items can x:Bind
                         the page view model. Which row it applies to is recorded by the handler on the
                         row itself, and re-read here as the menu opens. -->
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="ModuleRowMenu" x:FieldModifier="internal" Opening="OnModuleContextMenuOpening">
                            <!-- Two menus off one list, the way Windows Explorer does it. A plain
                                 right-click carries what the user came to do, frequency-ordered, with
                                 anything that has nothing to act on hidden rather than grayed; a
                                 Shift+right-click reveals the maintenance and the rarities in place.
                                 Declaration order here IS menu order, because RebuildModuleContextMenu
                                 only ever sets Visibility, and it matches ModuleContextMenu.Groups in
                                 Core, which decides what a row shows. An item that is merely blocked
                                 keeps appearing, disabled, carrying its reason in its tooltip. -->
                            <MenuFlyoutItem x:Name="ModuleToggleItem" Text="{x:Bind ViewModel.ContextToggleLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.ToggleModuleMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleEnableWithDependenciesItem" loc:Loc.Text="Environment.EnableWithDependenciesMenuItem"
                                            Command="{x:Bind ViewModel.EnableWithDependenciesCommand}"
                                            loc:Loc.Tooltip="Environment.EnableWithDependenciesMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleDisableWithDependentsItem" loc:Loc.Text="Environment.DisableWithDependentsMenuItem"
                                            Command="{x:Bind ViewModel.DisableWithDependentsCommand}"
                                            loc:Loc.Tooltip="Environment.DisableWithDependentsMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleUninstallItem" loc:Loc.Text="Environment.UninstallModuleMenuItem"
                                            Command="{x:Bind ViewModel.UninstallContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.UninstallModuleMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModulePruneItem" loc:Loc.Text="Environment.PruneEntryMenuItem"
                                            Command="{x:Bind ViewModel.PruneContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.PruneEntryMenuItem.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleOrderSeparator" />
                            <MenuFlyoutItem x:Name="ModuleMoveToTopItem" loc:Loc.Text="Environment.MoveToTopMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleToTopCommand}"
                                            loc:Loc.Tooltip="Environment.MoveToTopMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleMoveToBottomItem" loc:Loc.Text="Environment.MoveToBottomMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleToBottomCommand}"
                                            loc:Loc.Tooltip="Environment.MoveToBottomMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleMoveUpItem" loc:Loc.Text="Environment.MoveUpMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleUpCommand}"
                                            loc:Loc.Tooltip="Environment.MoveUpMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleMoveDownItem" loc:Loc.Text="Environment.MoveDownMenuItem"
                                            Command="{x:Bind ViewModel.MoveContextModuleDownCommand}"
                                            loc:Loc.Tooltip="Environment.MoveDownMenuItem.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleModSeparator" />
                            <MenuFlyoutItem x:Name="ModuleUpdateItem" loc:Loc.Text="Environment.UpdateModMenuItem"
                                            Command="{x:Bind ViewModel.UpdateContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.UpdateModMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleOpenModPageItem" loc:Loc.Text="Environment.OpenModPageMenuItem"
                                            Command="{x:Bind ViewModel.OpenContextModulePageCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.ContextOpenModPageTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem x:Name="ModulePinItem" Text="{x:Bind ViewModel.ContextPinLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleContextPinCommand}"
                                            loc:Loc.Tooltip="Environment.TogglePinMenuItem.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleToolsSeparator" />
                            <!-- Open Module Folder stays in every build: a player has real reasons to
                                 reach the folder. Open SubModule.xml used to sit directly below it and
                                 is in the outer ring now (DevRing\DeveloperSurfaces.cs), which puts it
                                 back in the same place: reading another author's raw manifest is the
                                 author's move, not a player's. -->
                            <MenuFlyoutItem x:Name="ModuleOpenFolderItem" x:FieldModifier="internal"
                                            loc:Loc.Text="Environment.OpenModuleFolderMenuItem"
                                            Command="{x:Bind ViewModel.OpenContextModuleFolderCommand}"
                                            loc:Loc.Tooltip="Environment.OpenModuleFolderMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleCopyIdItem" loc:Loc.Text="Environment.CopyModuleIdMenuItem"
                                            Command="{x:Bind ViewModel.CopyContextModuleIdCommand}"
                                            loc:Loc.Tooltip="Environment.CopyModuleIdMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleInsertDividerAboveItem" loc:Loc.Text="Environment.InsertDividerAboveMenuItem"
                                            Command="{x:Bind ViewModel.InsertDividerAboveContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.InsertDividerAboveMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleInsertDividerBelowItem" loc:Loc.Text="Environment.InsertDividerBelowMenuItem"
                                            Command="{x:Bind ViewModel.InsertDividerBelowContextModuleCommand}"
                                            loc:Loc.Tooltip="Environment.InsertDividerBelowMenuItem.Tooltip" />
                            <MenuFlyoutSeparator x:Name="ModuleIdentitySeparator" />
                            <MenuFlyoutItem x:Name="ModuleSetNexusIdItem" loc:Loc.Text="Environment.SetNexusModIdMenuItem"
                                            Command="{x:Bind ViewModel.SetContextModuleNexusIdCommand}"
                                            loc:Loc.Tooltip="Environment.SetNexusModIdMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleForgetModIdItem" loc:Loc.Text="Environment.ForgetModIdMenuItem"
                                            Command="{x:Bind ViewModel.ForgetContextModuleNexusIdCommand}"
                                            loc:Loc.Tooltip="Environment.ForgetModIdMenuItem.Tooltip" />
                            <!-- Not on Nexus stays in every build on purpose: a mod can come from
                                 Discord or a friend, and the population BEM cannot identify includes
                                 hand-extracted downloads. Built on This Machine, which the outer ring
                                 (DevRing\DeveloperSurfaces.cs) inserts directly below it, lands here. -->
                            <MenuFlyoutItem x:Name="NotOnNexusMenuItem" x:FieldModifier="internal"
                                            Text="{x:Bind ViewModel.ContextNotOnNexusLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleContextNotOnNexusCommand}"
                                            loc:Loc.Tooltip="Environment.ToggleNotOnNexusMenuItem.Tooltip" />
                            <!-- Everything above this line acts on modules; everything below it chooses
                                 which modules a later action will act on. Ctrl+A, Shift+click and
                                 Ctrl+click all build a selection now, so Select All and Clear are
                                 rarities held behind Shift, except on a right-click below the last
                                 row, where choosing is the only thing the click can mean. Taking one
                                 row back out of a set is not a rarity and stays in the plain menu. -->
                            <MenuFlyoutSeparator x:Name="ModuleSelectionSeparator" />
                            <MenuFlyoutItem x:Name="ModuleDeselectItem" loc:Loc.Text="Environment.Multi.DeselectMenuItem"
                                            Command="{x:Bind ViewModel.DeselectContextModuleCommand}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.DeselectContextModuleTooltip, Mode=OneWay}" />
                            <MenuFlyoutItem x:Name="ModuleSelectAllItem" Text="{x:Bind ViewModel.SelectAllLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.SelectAllShownCommand}"
                                            loc:Loc.Tooltip="Environment.SelectAllMenuItem.Tooltip" />
                            <MenuFlyoutItem x:Name="ModuleClearSelectionItem" loc:Loc.Text="Environment.ClearSelectionMenuItem"
                                            Command="{x:Bind ViewModel.ClearModuleSelectionCommand}"
                                            loc:Loc.Tooltip="Environment.ClearSelectionMenuItem.Tooltip" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
            </Grid>
        </Border>

        <!-- The detail pane sits beside the list rather than over it: the load order is the job of this
             page, and a pane that replaced the list would take it away to show one row of it. It only
             appears once a row is selected, and Close puts the width back. -->
        <Border Grid.Column="1" Width="360" Background="{StaticResource AlkSurfaceBrush}" Padding="10" CornerRadius="0"
                BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1"
                Visibility="{x:Bind ViewModel.HasSelectedModule, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.SelectedModuleTitle, Mode=OneWay}" Style="{StaticResource SubHeadingText}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedModuleTitle, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedModuleId, Mode=OneWay}" Style="{StaticResource BodyText}"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" loc:Loc.Content="Environment.CloseDetailsButton" Command="{x:Bind ViewModel.CloseDetailsCommand}" Style="{StaticResource Action}"
                            VerticalAlignment="Top"
                            loc:Loc.Tooltip="Environment.CloseDetailsButton.Tooltip" />
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleFacts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="loadorder:ModuleFact">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource AlkWarmGoldShadowBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource BodyText}"
                                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock loc:Loc.Text="Environment.DeclaresHeading" Style="{StaticResource LabelText}"
                                   loc:Loc.Tooltip="Environment.DeclaresHeading.Tooltip" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleDeclares}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock loc:Loc.Text="Environment.DeclaredByHeading" Style="{StaticResource LabelText}"
                                   loc:Loc.Tooltip="Environment.DeclaredByHeading.Tooltip" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleNeededBy}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock loc:Loc.Text="Environment.UndeclaredHeading" Style="{StaticResource LabelText}"
                                   loc:Loc.Tooltip="Environment.UndeclaredHeading.Tooltip" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleUndeclared}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Two exclusive regions, one per site. A subscribed item is Steam's: Steam
                             publishes it, keeps it at the version its author published and ends it, so
                             nothing Nexus reports is about it and nothing here is worded in Nexus terms.
                             The link is the item's page in the Steam client, which is where Unsubscribe
                             lives and the only way such a module is removed, so replacing the framing
                             never costs the destination. -->
                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.ShowWorkshopFacts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock loc:Loc.Text="Environment.WorkshopFactsHeading" Style="{StaticResource LabelText}"
                                       loc:Loc.Tooltip="Environment.WorkshopFactsHeading.Tooltip" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleWorkshop}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button loc:Loc.Content="Environment.OpenWorkshopPageButton" Command="{x:Bind ViewModel.OpenSelectedModuleWorkshopPageCommand}"
                                    Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Visibility="{x:Bind ViewModel.CanOpenSelectedModuleWorkshopPage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    loc:Loc.Tooltip="Environment.OpenWorkshopPageButton.Tooltip" />
                        </StackPanel>

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.ShowNexusModuleFacts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock loc:Loc.Text="Environment.NexusFactsHeading" Style="{StaticResource LabelText}"
                                       loc:Loc.Tooltip="Environment.NexusFactsHeading.Tooltip" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleNexus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button loc:Loc.Content="Environment.OpenModulePageButton" Command="{x:Bind ViewModel.OpenSelectedModuleOnNexusCommand}"
                                    Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Visibility="{x:Bind ViewModel.CanOpenSelectedModuleOnNexus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    loc:Loc.Tooltip="Environment.OpenModulePageButton.Tooltip" />
                        </StackPanel>

                        <TextBlock loc:Loc.Text="Environment.DiagnosesHeading" Style="{StaticResource LabelText}"
                                   loc:Loc.Tooltip="Environment.DiagnosesHeading.Tooltip" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedModuleDiagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>

        <Border x:Name="IssuePanel" Grid.Row="4" Background="{StaticResource AlkSurfaceBrush}" Padding="10" CornerRadius="0"
                BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1"
                SizeChanged="OnLayoutBandSizeChanged"
                Visibility="{x:Bind ViewModel.PanelIssues.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource SubHeadingText}"
                               Text="{x:Bind ViewModel.IssueCountText, Mode=OneWay}"
                               loc:Loc.Tooltip="Environment.IssueCountText.Tooltip" />
                    <!-- A disabled Button swallows no pointer input but shows no tooltip of its own,
                         so the tooltip lives on this wrapper to stay readable while it is grayed out. -->
                    <Border Background="Transparent"
                            loc:Loc.Tooltip="Environment.FixAllButton.Tooltip">
                        <Button loc:Loc.Content="Environment.FixAllButton" Command="{x:Bind ViewModel.FixAllCommand}" Style="{StaticResource Action}" />
                    </Border>
                </StackPanel>

                <!-- MaxHeight is set from the code-behind, not here: this panel and the disclosures
                     below share one budget of what the load order does not need, and a cap written in
                     one place cannot know what the other is taking. -->
                <ListView x:Name="IssueList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.PanelIssues}" SelectionMode="Single"
                          SelectionChanged="OnIssueSelected"
                          Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueRowViewModel">
                            <Grid ColumnSpacing="12" Padding="4" Opacity="{x:Bind IsProminent, Converter={StaticResource BoolToOpacity}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Selecting the row is how an issue is opened, so its text opts out. -->
                                <TextBlock Text="{x:Bind SeverityText}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                           IsTextSelectionEnabled="False" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="False" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button loc:Loc.Content="Environment.IssueRow.FixButton" Style="{StaticResource Action}"
                                            Click="OnFixClicked" Tag="{x:Bind Issue}"
                                            loc:Loc.Tooltip="Environment.IssueRow.FixButton.Tooltip"
                                            Visibility="{x:Bind IsFixable, Converter={StaticResource BoolToVisibility}}" />
                                    <Button loc:Loc.Content="Environment.IssueRow.RemoveFolderButton" Style="{StaticResource Action}"
                                            Click="OnRemoveFolderClicked" Tag="{x:Bind Folder}"
                                            loc:Loc.Tooltip="Environment.IssueRow.RemoveFolderButton.Tooltip"
                                            Visibility="{x:Bind CanRemoveFolder, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel x:Name="StatusBand" Grid.Row="5" Spacing="6" SizeChanged="OnLayoutBandSizeChanged">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- Fixed width and height on purpose, exactly as the download box above. A status that
                     wrapped freely moved every row under it, and one that did not wrap at all was cut
                     off mid-sentence with no way to read the rest. Two lines, then the ellipsis, and
                     the whole message on the hover. -->
                <Grid Width="620" Height="40" VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top" IsTextSelectionEnabled="True"
                               ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.LastWrittenText, Mode=OneWay}" Style="{StaticResource BodyText}"
                           Foreground="{StaticResource AlkSuccessOliveGoldBrush}" IsTextSelectionEnabled="True"
                           loc:Loc.Tooltip="Environment.LastWrittenText.Tooltip"
                           Visibility="{x:Bind ViewModel.LastWrittenText, Mode=OneWay, Converter={StaticResource TextToVisibility}}" />
                <TextBlock loc:Loc.Text="Environment.HeldChangesNote" Style="{StaticResource BodyText}"
                           Foreground="{StaticResource AlkAlertAmberBrush}" IsTextSelectionEnabled="False"
                           loc:Loc.Tooltip="Environment.HeldChangesNote.Tooltip"
                           Visibility="{x:Bind ViewModel.HasHeldChanges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{x:Bind ViewModel.LeftoverSummary, Mode=OneWay}" Style="{StaticResource BodyText}"
                           Foreground="{StaticResource AlkAlertAmberBrush}" IsTextSelectionEnabled="True"
                           Visibility="{x:Bind ViewModel.HasLeftovers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button loc:Loc.Content="Environment.ClearLeftoversButton" Command="{x:Bind ViewModel.ClearLeftoversCommand}"
                        loc:Loc.Tooltip="Environment.ClearLeftoversButton.Tooltip"
                        Visibility="{x:Bind ViewModel.HasLeftovers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- One line, only while a dry run is going, naming the module currently loading. -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsDryRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsDryRunning, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.DryRunProgressText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button loc:Loc.Content="Environment.CancelDryRunButton" Command="{x:Bind ViewModel.CancelDryRunCommand}" Style="{StaticResource Action}" MinWidth="90"
                        loc:Loc.Tooltip="Environment.CancelDryRunButton.Tooltip" />
            </StackPanel>
        </StackPanel>

        <!-- The three disclosures are one region, not three. Each was capped on its own and the caps
             were individually reasonable, but nothing stopped all three from being open together, and
             three of them plus the issue panel came to more than a nine hundred pixel window has after
             the bands above it: the load order, which is what the page is for, was squeezed out of
             existence by panels that were each behaving. They are an accordion now, so at most one is
             open, and what that one may take is handed to it by UpdateRegionBudget out of what the load
             order does not need. -->
        <StackPanel x:Name="DisclosureBand" Grid.Row="6" Spacing="8" SizeChanged="OnLayoutBandSizeChanged">

            <!-- Everything the preflight found, behind a disclosure. Anything that stops a mod working
                 has already been put in front of the user in a dialog before the game started; this is
                 where it stays readable afterwards, together with the advisories that never earn a
                 dialog and the checks that could not run at all. -->
            <Expander x:Name="PreflightDisclosure" HorizontalAlignment="Stretch" IsExpanded="False" Padding="12,4,12,8"
                      AutomationProperties.Name="{x:Bind ViewModel.PreflightHeader, Mode=OneWay}"
                      Expanding="OnDisclosureExpanding" Collapsed="OnDisclosureCollapsed"
                      loc:Loc.Tooltip="Environment.PreflightExpander.Tooltip"
                      Visibility="{x:Bind ViewModel.HasPreflight, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Expander.Header>
                    <!-- The header is the toggle, so its text opts out; the rows inside stay selectable. -->
                    <TextBlock Text="{x:Bind ViewModel.PreflightHeader, Mode=OneWay}" Style="{StaticResource BodyText}"
                               IsTextSelectionEnabled="False" />
                </Expander.Header>
                <!-- The one scroller between this content and the window. MaxHeight comes from the
                     code-behind budget, and the band this sits in never scrolls, so there is never a
                     second bar beside this one for the reader to mistake it for. -->
                <ScrollViewer x:Name="PreflightScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PreflightFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PreflightRowViewModel">
                                <Grid ColumnSpacing="12" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind GradeText}" Style="{StaticResource BodyText}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource AlkMutedTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{x:Bind FixLabel}" Style="{StaticResource Action}"
                                            Click="OnPreflightFixClicked" Tag="{x:Bind}" VerticalAlignment="Top"
                                            loc:Loc.Tooltip="Environment.PreflightRow.FixButton.Tooltip"
                                            Visibility="{x:Bind IsFixable, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="3" loc:Loc.Content="Environment.PreflightRow.AcceptRiskButton"
                                            Click="OnAcceptRiskClicked" Tag="{x:Bind}" VerticalAlignment="Top"
                                            loc:Loc.Tooltip="Environment.PreflightRow.AcceptRiskButton.Tooltip"
                                            Visibility="{x:Bind CanAcceptRisk, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>

            <!-- Every risk on record, independent of what the current load order triggers. This is the
                 undo for Accept the Risk: without it, accepting is a one-way door. -->
            <Expander x:Name="AcceptedRisksDisclosure" HorizontalAlignment="Stretch" IsExpanded="False" Padding="12,4,12,8"
                      Expanding="OnDisclosureExpanding" Collapsed="OnDisclosureCollapsed"
                      loc:Loc.AutomationName="Environment.AcceptedRisksExpander.Header"
                      loc:Loc.Tooltip="Environment.AcceptedRisksExpander.Tooltip"
                      Visibility="{x:Bind ViewModel.HasAcceptedRisks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Expander.Header>
                    <TextBlock loc:Loc.Text="Environment.AcceptedRisksExpander.Header" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" />
                </Expander.Header>
                <ScrollViewer x:Name="AcceptedRisksScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AcceptedRiskRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AcceptedRiskRowViewModel">
                                <Grid ColumnSpacing="12" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind CheckText}" Style="{StaticResource BodyText}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind RecordedText}" Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkMutedTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" loc:Loc.Content="Environment.AcceptedRiskRow.ForgetButton"
                                            Click="OnForgetAcceptedRiskClicked" Tag="{x:Bind}" VerticalAlignment="Top"
                                            loc:Loc.Tooltip="Environment.AcceptedRiskRow.ForgetButton.Tooltip" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>

            <!-- The summary is the status line above; this is the per-module detail behind a disclosure,
                 biggest move first. It clears the moment anything else replaces the list, so it never
                 explains an order that is no longer on screen. -->
            <Expander x:Name="SortExplanationDisclosure" HorizontalAlignment="Left" IsExpanded="False" Padding="12,4,12,8"
                      AutomationProperties.Name="{x:Bind ViewModel.SortExplanationHeader, Mode=OneWay}"
                      Expanding="OnDisclosureExpanding" Collapsed="OnDisclosureCollapsed"
                      Visibility="{x:Bind ViewModel.HasSortExplanation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Expander.Header>
                    <!-- The header is the toggle, so its text opts out; the lines inside stay selectable. -->
                    <TextBlock Text="{x:Bind ViewModel.SortExplanationHeader, Mode=OneWay}" Style="{StaticResource BodyText}"
                               IsTextSelectionEnabled="False"
                               loc:Loc.Tooltip="Environment.SortExplanationExpander.Tooltip" />
                </Expander.Header>
                <ScrollViewer x:Name="SortExplanationScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SortExplanationLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
