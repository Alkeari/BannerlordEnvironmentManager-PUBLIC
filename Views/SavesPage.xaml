<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.SavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:views="using:BannerlordEnvironmentManager.Views"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />

        <Style x:Key="SaveColumn" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A secondary cell: Steel Gray, so the name leads the row. -->
        <Style x:Key="SaveCell" TargetType="TextBlock" BasedOn="{StaticResource SaveColumn}">
            <Setter Property="Foreground" Value="{StaticResource AlkSteelGrayBrush}" />
        </Style>

        <!-- Table headers: Steel Gray, 12 px bold, as the mockups' table header row. -->
        <Style x:Key="SaveColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="IsTextSelectionEnabled" Value="False" />
        </Style>

        <DataTemplate x:Key="DifferenceRow" x:DataType="vm:SaveDifferenceRowViewModel">
            <StackPanel Spacing="2" Padding="0,8" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{x:Bind Heading}" Style="{StaticResource LabelText}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Heading}" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </StackPanel>
        </DataTemplate>

        <!-- One mod's line in a setup restore's result. An ItemsControl selects nothing, so the
             message stays selectable for copying into a report. -->
        <DataTemplate x:Key="SetupResultRow" x:DataType="vm:SaveSetupResultRowViewModel">
            <StackPanel Spacing="2" Padding="0,8" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{x:Bind Heading}" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                           ToolTipService.ToolTip="{x:Bind Heading}" />
                <TextBlock Text="{x:Bind Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <HyperlinkButton loc:Loc.Content="Saves.Setup.OpenOnNexusButton" NavigateUri="{x:Bind LinkUri}" Padding="0,2"
                                 Visibility="{x:Bind LinkVisibility}"
                                 loc:Loc.Tooltip="Saves.Setup.OpenOnNexusButton.Tooltip" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- Saves (redesign step 5): the saves table is the primary card; the selected save's card beside it
         says what changed in the load order since it was written, one difference list at a time, with
         Launch and Restore in its footer. The page never scrolls; each card scrolls inside its share. -->
    <Grid x:Name="PageRoot" Padding="8" RowSpacing="8" ColumnSpacing="{StaticResource AlkCardGap}" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TableRow" Height="*" />
            <RowDefinition x:Name="FoldedRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition x:Name="SideColumn" Width="2*" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader Grid.ColumnSpan="2" TitleKey="Saves.Title" BlurbKey="Saves.Blurb"
                             Status="{x:Bind SavesViewModel.StatusMessage, Mode=OneWay}">
            <Button loc:Loc.Content="Saves.RefreshButton" Command="{x:Bind SavesViewModel.RefreshCommand}"
                    Style="{StaticResource RowAction}"
                    loc:Loc.Tooltip="Saves.RefreshButton.Tooltip" />
        </controls:PageHeader>

        <!-- An empty list on Game Pass without BLSE means BEM could not look, which is the opposite of
             having no saves, so the reason sits on the card the reader is looking at. -->
        <controls:CardShell x:Name="SavesCard" Grid.Row="1" TitleKey="Saves.Card.Title" IsPrimary="True"
                            Banner="{x:Bind SavesViewModel.LocationNote, Mode=OneWay}"
                            BodyScrolls="False" BodyPadded="False">
            <controls:CardShell.Toolbar>
                <Grid ColumnSpacing="12" Padding="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(Navigation.IsAdvancedMode, 0.3), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(Navigation.IsAdvancedMode, 0.3), Mode=OneWay}" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock loc:Loc.Text="Saves.NameColumnHeader" Style="{StaticResource SaveColumnHeader}" />
                    <TextBlock Grid.Column="1" loc:Loc.Text="Saves.VersionColumnHeader" Style="{StaticResource SaveColumnHeader}" />
                    <TextBlock Grid.Column="2" loc:Loc.Text="Saves.CharacterColumnHeader" Style="{StaticResource SaveColumnHeader}" />
                    <TextBlock Grid.Column="3" loc:Loc.Text="Saves.LevelColumnHeader" Style="{StaticResource SaveColumnHeader}" />
                    <TextBlock Grid.Column="4" loc:Loc.Text="Saves.DaysColumnHeader" Style="{StaticResource SaveColumnHeader}" />
                    <TextBlock Grid.Column="5" loc:Loc.Text="Saves.CreatedColumnHeader" Style="{StaticResource SaveColumnHeader}" />
                </Grid>
            </controls:CardShell.Toolbar>

            <ListView x:Name="SaveList" ItemsSource="{x:Bind SavesViewModel.Saves}"
                      SelectedItem="{x:Bind SavesViewModel.SelectedSave, Mode=TwoWay}"
                      SelectionMode="Single" Background="Transparent" BorderThickness="0"
                      Padding="4,0,4,8"
                      ContextRequested="OnSaveContextRequested">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem loc:Loc.Text="Saves.ShowInFolderMenuItem" Command="{x:Bind SavesViewModel.ShowContextSaveInFolderCommand}"
                                        loc:Loc.Tooltip="Saves.ShowInFolderMenuItem.Tooltip" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="Saves.CopyNameMenuItem" Command="{x:Bind SavesViewModel.CopyContextSaveNameCommand}"
                                        loc:Loc.Tooltip="Saves.CopyNameMenuItem.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Saves.CopyPathMenuItem" Command="{x:Bind SavesViewModel.CopyContextSavePathCommand}"
                                        Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                                        loc:Loc.Tooltip="Saves.CopyPathMenuItem.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Saves.CopyModuleListMenuItem" Command="{x:Bind SavesViewModel.CopyContextSaveModulesCommand}"
                                        loc:Loc.Tooltip="Saves.CopyModuleListMenuItem.Tooltip" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="Saves.RestoreLoadOrderMenuItem" Command="{x:Bind SavesViewModel.RestoreContextSaveLoadOrderCommand}"
                                        loc:Loc.Tooltip="Saves.RestoreLoadOrderMenuItem.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Saves.RestoreSetupMenuItem" Command="{x:Bind SavesViewModel.RestoreContextSaveSetupCommand}"
                                        loc:Loc.Tooltip="Saves.RestoreSetupMenuItem.Tooltip" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="Saves.LaunchFromSaveMenuItem" Command="{x:Bind SavesViewModel.LaunchIntoContextSaveCommand}"
                                        loc:Loc.Tooltip="Saves.LaunchFromSave.Tooltip" />
                        <MenuFlyoutItem loc:Loc.Text="Saves.LaunchCurrentOrderMenuItem" Command="{x:Bind SavesViewModel.LaunchIntoContextSaveCurrentOrderCommand}"
                                        loc:Loc.Tooltip="Saves.LaunchCurrentOrder.Tooltip" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="Saves.RecycleMenuItem" Command="{x:Bind SavesViewModel.RecycleContextSaveCommand}"
                                        loc:Loc.Tooltip="Saves.RecycleMenuItem.Tooltip" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveRowViewModel">
                        <!-- The row records itself, the half of the context menu that cannot be skipped. -->
                        <StackPanel Spacing="2" Background="Transparent"
                                    ContextRequested="OnSaveRowContextRequested">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, 0.3), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind views:PageDensity.AdvancedColumn(views:ShellViewModels.Instance.NavigationSettings.IsAdvancedMode, 0.3), Mode=OneWay}" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <!-- Selecting a row is how a save is picked, so its text opts out of
                                     selection. The row's context menu copies the name and the path. -->
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource SaveColumn}" IsTextSelectionEnabled="False" ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Version}" Style="{StaticResource SaveCell}" IsTextSelectionEnabled="False" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Character}" Style="{StaticResource SaveCell}" IsTextSelectionEnabled="False" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Level}" Style="{StaticResource SaveCell}" IsTextSelectionEnabled="False" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Days}" Style="{StaticResource SaveCell}" IsTextSelectionEnabled="False" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Created}" Style="{StaticResource SaveCell}" IsTextSelectionEnabled="False" />
                            </Grid>
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="False" ToolTipService.ToolTip="{x:Bind Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- The folder these saves were read from, once for the whole table. -->
            <controls:CardShell.Footer>
                <TextBlock TextWrapping="Wrap" Text="{x:Bind SavesViewModel.SavesFolder, Mode=OneWay}" Style="{StaticResource MonoText}" IsTextSelectionEnabled="True" VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind SavesViewModel.SavesFolder, Mode=OneWay}" />
            </controls:CardShell.Footer>
        </controls:CardShell>

        <!-- The diff is what this page is for: whether the selected save will still load the way it did.
             One list at a time, because three of the four are empty on a healthy setup. -->
        <controls:CardShell x:Name="DiffCard" Grid.Row="1" Grid.Column="1" TitleKey="Saves.DiffHeading" BodyScrolls="False">
            <controls:CardShell.Toolbar>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind SavesViewModel.DiffSummary, Mode=OneWay}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               ToolTipService.ToolTip="{x:Bind SavesViewModel.DiffSummary, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind SavesViewModel.ComparedAgainst, Mode=OneWay}" Style="{StaticResource MetaText}"
                               TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind SavesViewModel.ComparedAgainst, Mode=OneWay}"
                               Visibility="{x:Bind SavesViewModel.ComparedAgainst, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" Foreground="{StaticResource AlkMutedTextBrush}" />
                    <!-- Chips that wrap onto a second line in a narrow card, so every label reads whole. -->
                    <controls:WrapPanel x:Name="DiffSegments" Spacing="8" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}">
                        <ToggleButton x:Name="DiffAddedSegment" Style="{StaticResource SegmentChip}" Click="OnDiffSegmentChosen" IsChecked="True"
                                      loc:Loc.Tooltip="Saves.AddedSegment" />
                        <ToggleButton x:Name="DiffRemovedSegment" Style="{StaticResource SegmentChip}" Click="OnDiffSegmentChosen"
                                      loc:Loc.Tooltip="Saves.RemovedSegment" />
                        <ToggleButton x:Name="DiffVersionSegment" Style="{StaticResource SegmentChip}" Click="OnDiffSegmentChosen"
                                      loc:Loc.Tooltip="Saves.VersionChangedSegment" />
                        <ToggleButton x:Name="DiffNotRecordedSegment" Style="{StaticResource SegmentChip}" Click="OnDiffSegmentChosen"
                                      loc:Loc.Tooltip="Saves.NotRecordedSegment.Tooltip" />
                    </controls:WrapPanel>
                </StackPanel>
            </controls:CardShell.Toolbar>

            <!-- Basic keeps the one-line verdict above and Launch below; the lists of what changed are
                 Advanced's, except while a setup restore is on the card. -->
            <Grid Visibility="{x:Bind views:PageDensity.Show(Navigation.IsAdvancedMode, SavesViewModel.IsSetupPanelVisible), Mode=OneWay}">
                <ScrollViewer x:Name="DiffAddedPanel" VerticalScrollBarVisibility="Auto" Padding="20,4,20,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind SavesViewModel.Added}" ItemTemplate="{StaticResource DifferenceRow}" />
                        <TextBlock Text="{x:Bind SavesViewModel.AddedEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind SavesViewModel.AddedEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DiffRemovedPanel" VerticalScrollBarVisibility="Auto" Padding="20,4,20,16" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind SavesViewModel.Removed}" ItemTemplate="{StaticResource DifferenceRow}" />
                        <TextBlock Text="{x:Bind SavesViewModel.RemovedEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind SavesViewModel.RemovedEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DiffVersionPanel" VerticalScrollBarVisibility="Auto" Padding="20,4,20,16" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind SavesViewModel.VersionChanged}" ItemTemplate="{StaticResource DifferenceRow}" />
                        <TextBlock Text="{x:Bind SavesViewModel.VersionChangedEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind SavesViewModel.VersionChangedEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DiffNotRecordedPanel" VerticalScrollBarVisibility="Auto" Padding="20,4,20,16" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind SavesViewModel.NotRecorded}" ItemTemplate="{StaticResource DifferenceRow}" />
                        <TextBlock Text="{x:Bind SavesViewModel.NotRecordedEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Visibility="{x:Bind SavesViewModel.NotRecordedEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- A setup restore takes the card over while it runs and until it is closed: its
                     progress, then what became of each mod. It sits over the difference lists on the
                     card's own surface, so nothing beneath shows through. -->
                <Grid x:Name="SetupPanel" Background="{StaticResource AlkSurfaceBrush}" Padding="20,4,20,16" RowSpacing="8"
                      Visibility="{x:Bind SavesViewModel.IsSetupPanelVisible, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind SavesViewModel.SetupHeading, Mode=OneWay}" Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                    <ProgressBar Grid.Row="1" Maximum="100" Value="{x:Bind SavesViewModel.SetupProgress, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind SavesViewModel.IsSetupProgressIndeterminate, Mode=OneWay}"
                                 Visibility="{x:Bind SavesViewModel.IsSetupRunning, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Text="{x:Bind SavesViewModel.SetupStatus, Mode=OneWay}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               ToolTipService.ToolTip="{x:Bind SavesViewModel.SetupStatus, Mode=OneWay}" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind SavesViewModel.SetupResults}" ItemTemplate="{StaticResource SetupResultRow}" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                        <Button loc:Loc.Content="Saves.Setup.StopButton" Command="{x:Bind SavesViewModel.StopSetupCommand}"
                                Style="{StaticResource RowAction}"
                                Visibility="{x:Bind SavesViewModel.IsSetupRunning, Mode=OneWay}"
                                loc:Loc.Tooltip="Saves.Setup.StopButton.Tooltip" />
                        <Button loc:Loc.Content="Saves.Setup.CloseButton" Command="{x:Bind SavesViewModel.CloseSetupCommand}"
                                Style="{StaticResource RowAction}"
                                loc:Loc.Tooltip="Saves.Setup.CloseButton.Tooltip" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Two rows: the three actions do not fit one line of the side card at 1920 wide, and a
                 footer that scrolls sideways hides the third. -->
            <controls:CardShell.Footer>
                <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button loc:Loc.Content="Saves.LaunchButton"
                            Style="{StaticResource RowPrimaryAction}"
                            loc:Loc.Tooltip="Saves.LaunchButton.Tooltip">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem loc:Loc.Text="Saves.LaunchFromSave" Command="{x:Bind SavesViewModel.LaunchIntoSelectedSaveCommand}"
                                                loc:Loc.Tooltip="Saves.LaunchFromSave.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Saves.LaunchCurrentOrder" Command="{x:Bind SavesViewModel.LaunchIntoSelectedSaveCurrentOrderCommand}"
                                                loc:Loc.Tooltip="Saves.LaunchCurrentOrder.Tooltip" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- One button for the two ways to put a save back: its load order, or its whole setup. -->
                    <Button x:Name="RestoreMenuButton" loc:Loc.Content="Saves.RestoreMenuButton"
                            Style="{StaticResource RowAction}" Visibility="{x:Bind views:PageDensity.Advanced(Navigation.IsAdvancedMode), Mode=OneWay}"
                            loc:Loc.Tooltip="Saves.RestoreMenuButton.Tooltip">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem loc:Loc.Text="Saves.RestoreButton" Command="{x:Bind SavesViewModel.RestoreLoadOrderCommand}"
                                                loc:Loc.Tooltip="Saves.RestoreButton.Tooltip" />
                                <MenuFlyoutItem loc:Loc.Text="Saves.RestoreSetupButton" Command="{x:Bind SavesViewModel.RestoreSetupCommand}"
                                                loc:Loc.Tooltip="Saves.RestoreSetupButton.Tooltip" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                </StackPanel>
            </controls:CardShell.Footer>
        </controls:CardShell>

        <controls:PanelSplitter x:Name="SideSplitter" Grid.Row="1" Grid.Column="1" SectionKey="SavesSideWidth" />
    </Grid>
</Page>
