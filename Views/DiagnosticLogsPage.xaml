<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="BannerlordEnvironmentManager.Views.DiagnosticLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:converters="using:BannerlordEnvironmentManager.Converters"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />

        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="{StaticResource AlkPillCornerRadius}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource AlkDeepGraphiteBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AlkWarmGoldShadowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- A log line is as wide as it is. Nothing in here wraps, truncates or scrolls sideways on its
             own: the one scroller around the whole column carries the width, so the wheel is always
             vertical no matter which pixel the pointer is over. -->
        <DataTemplate x:Key="LogFindingRow" x:DataType="vm:LogFindingRowViewModel">
            <Border Background="{StaticResource AlkSurfaceRaisedBrush}" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1" Padding="10" CornerRadius="0" Margin="0,0,0,8">
                <StackPanel Spacing="4" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" />
                    <TextBlock Text="{x:Bind HeadlineAndExcerpt}" Style="{StaticResource BodyText}" FontFamily="Consolas" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20,14,20,16">
        <Grid RowSpacing="12">
            <!-- The log list and the findings beside it are what this page exists for. What used to
                 take their height was the footer, which is written by the scan that fills them; it
                 declares a fixed share now, so this row is simply what is left and shrinks smoothly
                 with the window. That is the order these regions give up size in: the footer keeps its
                 height, the lists absorb the difference. A minimum here instead would add to the fixed
                 total, and below it the grid runs off the bottom edge and puts the footer where no
                 scrollbar reaches. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader TitleKey="Logs.Title" BlurbKey="Logs.Blurb">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button loc:Loc.Content="Logs.ScanButton" Command="{x:Bind DiagnosticsViewModel.ScanLogsAndCrashReportsCommand}" Style="{StaticResource PrimaryAction}" MinWidth="240"
                            loc:Loc.Tooltip="Logs.ScanButton.Tooltip" />
                    <ProgressRing IsActive="{x:Bind DiagnosticsViewModel.IsBusy, Mode=OneWay}" Width="28" Height="28" />

                    <ToggleButton Style="{StaticResource FilterChip}" VerticalAlignment="Center"
                                  loc:Loc.Content="Logs.OnlyFindingsToggle"
                                  IsChecked="{x:Bind DiagnosticsViewModel.ShowOnlyLogsWithFindings, Mode=TwoWay}"
                                  loc:Loc.AutomationName="Logs.OnlyFindingsToggle.AutomationName"
                                  loc:Loc.Tooltip="Logs.OnlyFindingsToggle.Tooltip" />
                </StackPanel>
            </controls:PageHeader>


            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <!-- The same defect one level in: the status and the folder list under this
                             column are written by the scan that fills the list above them, so sized to
                             their own text they took their height out of it. Both rows around the list
                             are bounded now, the heading to two lines and the status block to a fixed
                             share, so the list is what is left and gives up size last. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock loc:Loc.Text="Logs.ListHeading" Style="{StaticResource SubHeadingText}"
                                       loc:Loc.Tooltip="Logs.ListHeading.Tooltip" />
                            <!-- Held to two lines. It is written by the scan and by the filter toggle,
                                 so it appears and changes length while the list under it is at its
                                 fullest. The whole line is on the hover. -->
                            <TextBlock Text="{x:Bind DiagnosticsViewModel.LogFilterSummary, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}"
                                       ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.LogFilterSummary, Mode=OneWay}"
                                       Visibility="{x:Bind DiagnosticsViewModel.LogFilterSummary, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind DiagnosticsViewModel.Logs}" SelectedItem="{x:Bind DiagnosticsViewModel.SelectedLog, Mode=TwoWay}" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                  ContextRequested="OnLogContextRequested">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem loc:Loc.Text="Logs.OpenMenuItem" Command="{x:Bind DiagnosticsViewModel.OpenLogCommand}"
                                                    loc:Loc.Tooltip="Logs.OpenMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Logs.ShowInFolderMenuItem" Command="{x:Bind DiagnosticsViewModel.ShowLogInFolderCommand}"
                                                    loc:Loc.Tooltip="Logs.ShowInFolderMenuItem.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Logs.CopyPathMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyLogPathCommand}"
                                                    loc:Loc.Tooltip="Logs.CopyPathMenuItem.Tooltip" />
                                    <MenuFlyoutItem loc:Loc.Text="Logs.CopyPassagesMenuItem" Command="{x:Bind DiagnosticsViewModel.CopyLogPassagesCommand}"
                                                    loc:Loc.Tooltip="Logs.CopyPassagesMenuItem.Tooltip" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem loc:Loc.Text="Logs.ClearMenuItem" Command="{x:Bind DiagnosticsViewModel.ClearLogCommand}"
                                                    loc:Loc.Tooltip="Logs.ClearMenuItem.Tooltip" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogRowViewModel">
                                    <!-- The row records itself, and this is the reliable half. ContextRequested
                                         bubbles, so a handler on the list only runs if nothing between the click
                                         and the list marked the event handled, while the framework shows the
                                         flyout either way: that is how a right-click on a log opened a menu with
                                         every item grayed out. A handler on the row is first in the chain and
                                         cannot be skipped. -->
                                    <StackPanel Spacing="4" Padding="8" Background="Transparent"
                                                ContextRequested="OnLogRowContextRequested">
                                        <!-- Selecting a row is how a log is opened, so its text opts out of
                                             selection. The row's context menu is what copies it. -->
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubHeadingText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="False" ToolTipService.ToolTip="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Owner}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind Written}" Style="{StaticResource BodyText}" Foreground="{StaticResource AlkSteelGrayBrush}" IsTextSelectionEnabled="False" />
                                        <TextBlock Text="{x:Bind Findings}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="False" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Fixed height on purpose, and it keeps that height whether or not the scan
                             has run: two lines for the outcome and two for the folders it read, each
                             trimmed with the whole of it on the hover. Sized to its own text, a folder
                             list several paths long took every one of those lines out of the list. -->
                        <Grid Grid.Row="2" Height="84" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind DiagnosticsViewModel.LogsStatus, Mode=OneWay}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                                       IsTextSelectionEnabled="True"
                                       ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.LogsStatus, Mode=OneWay}"
                                       Visibility="{x:Bind DiagnosticsViewModel.LogsStatus, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                            <TextBlock Grid.Row="1" Text="{x:Bind DiagnosticsViewModel.LogFolders, Mode=OneWay}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                                       IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}"
                                       ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.LogFolders, Mode=OneWay}"
                                       Visibility="{x:Bind DiagnosticsViewModel.LogFolders, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource AlkSurfaceBrush}" Padding="12" CornerRadius="0" BorderBrush="{StaticResource AlkHairlineBrush}" BorderThickness="1">
                    <!-- The only scroller in this column, and the only one on either axis. Anything inside
                         it that scrolled sideways would steal the wheel from it. -->
                    <ScrollViewer x:Name="DetailScroller"
                                  HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Scrolling sideways measures the content against an unbounded width, which stops
                                 every wrapping paragraph from wrapping. Only the log passages want that width,
                                 so the prose is held to the viewport and the passages are not. -->
                            <StackPanel Spacing="10" HorizontalAlignment="Left"
                                        MaxWidth="{x:Bind DetailScroller.ViewportWidth, Mode=OneWay}">
                                <TextBlock loc:Loc.Text="Logs.SelectedLogHeading" Style="{StaticResource SubHeadingText}"
                                           loc:Loc.Tooltip="Logs.SelectedLogHeading.Tooltip" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource AlkSteelGrayBrush}"
                                           loc:Loc.Text="Logs.SelectedLogHeading.Description" />
                                <TextBlock Text="{x:Bind DiagnosticsViewModel.LogFindingsEmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind DiagnosticsViewModel.LogFindingsEmptyText, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind DiagnosticsViewModel.LogFindings}"
                                          ItemTemplate="{StaticResource LogFindingRow}"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- The log folders are named beside the log list, so the line here is the scan's own, not
                 the crash report search's: naming the crash folders under a list of logs reads as a
                 statement about the logs. -->
            <!-- Fixed height on purpose, for the reason the column's own status block is: it is
                 written when the lists above it are fullest. Two lines, then the ellipsis, and the
                 whole message on the hover. -->
            <Grid Grid.Row="2" Height="40">
                <TextBlock Text="{x:Bind DiagnosticsViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                           IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{x:Bind DiagnosticsViewModel.StatusMessage, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
