<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="BannerlordEnvironmentManager.Controls.ContextBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    xmlns:vm="using:BannerlordEnvironmentManager.ViewModels"
    xmlns:launcher="using:BannerlordEnvironmentManager.Core.Launcher"
    mc:Ignorable="d">

    <!-- The persistent context bar (proposal 1.1): the game version every page is about, what Launch
         starts, and Launch Game. On every page, so the version is never hidden on Play and launching
         never needs a trip back to it. Launch is the primary action only on Play; elsewhere it is a
         secondary button and the page's own action is the one primary of its region. -->
    <Grid ColumnSpacing="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="VersionLabel" Style="{StaticResource FieldLabelText}" loc:Loc.Text="Controls.ContextBar.VersionLabel" />

        <!-- Only versions already on this machine, so picking one switches and can never begin a
             download; getting a version onto the machine is the Versions page. -->
        <ComboBox x:Name="VersionPicker" Grid.Column="1"
                  ItemsSource="{x:Bind ViewModel.VersionSwitcher.InstalledVersions, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.VersionSwitcher.SelectedVersion, Mode=TwoWay}"
                  IsEnabled="{x:Bind ViewModel.VersionSwitcher.IsIdle, Mode=OneWay}"
                  MinWidth="200" MaxWidth="360" VerticalAlignment="Center"
                  loc:Loc.Tooltip="Environment.VersionComboBox.Tooltip">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GameVersionRowViewModel">
                    <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayLabel}" Style="{StaticResource LabelText}" IsTextSelectionEnabled="False"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{x:Bind StateText}" Style="{StaticResource MetaText}"
                                   HorizontalAlignment="Right" IsTextSelectionEnabled="False" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- With nothing installed there is nothing to pick, so the picker gives way to the one action
             that fixes that. -->
        <Button x:Name="NoVersionsButton" Grid.Column="1" Style="{StaticResource RowAction}" Visibility="Collapsed"
                Click="OnOpenVersions"
                loc:Loc.Content="Environment.NoVersionsButton" loc:Loc.Tooltip="Environment.NoVersionsButton.Tooltip" />

        <TextBlock x:Name="TargetLabel" Grid.Column="2" Style="{StaticResource FieldLabelText}" loc:Loc.Text="Controls.ContextBar.TargetLabel" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="TargetPicker" ItemsSource="{x:Bind ViewModel.AvailableTargets}"
                      SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                      MinWidth="180" MaxWidth="280" VerticalAlignment="Center"
                      loc:Loc.Tooltip="Environment.LaunchTargetComboBox.Tooltip">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="launcher:LaunchTarget">
                        <TextBlock Text="{x:Bind DisplayName}" IsTextSelectionEnabled="False"
                                   TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{x:Bind launcher:LaunchTargetResolver.DescribeTooltip(Kind)}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Why the target list is short, whole: it wraps onto a second line rather than trimming. -->
            <TextBlock x:Name="TargetNote" Text="{x:Bind ViewModel.LaunchTargetNote, Mode=OneWay}"
                       Style="{StaticResource CardMetaText}" MaxWidth="260" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                       ToolTipService.ToolTip="{x:Bind ViewModel.LaunchTargetNote, Mode=OneWay}" />
        </StackPanel>

        <!-- A gold segment while a launch or a read is under way, beside the button it belongs to. -->
        <ProgressBar Grid.Column="4" IsIndeterminate="True" Width="80" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Visibility="{x:Bind BusyVisibility(ViewModel.IsBusy), Mode=OneWay}"
                     loc:Loc.Tooltip="Controls.ContextBar.Busy.Tooltip" />

        <!-- A disabled Button shows no tooltip of its own, so the tooltip lives on this wrapper. -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <!-- Whether a launch records mod patches is a choice made beside the button that launches. -->
            <CheckBox x:Name="RecordPatchesCheckBox" IsChecked="{x:Bind ViewModel.IsWatchArmed, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsLaunchIdle, Mode=OneWay}"
                      VerticalAlignment="Center" MinWidth="0"
                      loc:Loc.Content="Environment.WatchLaunchesCheckBox"
                      loc:Loc.Tooltip="Environment.WatchLaunchesCheckBox.Tooltip" />
            <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.LaunchTooltip, Mode=OneWay}">
                <Button x:Name="LaunchButton" Content="{x:Bind ViewModel.LaunchButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.LaunchCommand}" Style="{StaticResource RowAction}" MinWidth="140" />
            </Border>
        </StackPanel>

        <!-- While the game runs: a warning the player can still act on, on whatever page is open. -->
        <Grid Grid.Row="1" Grid.ColumnSpan="6" ColumnSpacing="12"
              Visibility="{x:Bind WarningVisibility(ViewModel.LiveRunWarning), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.LiveRunWarning, Mode=OneWay}"
                   Style="{StaticResource BodyText}" Foreground="{StaticResource AlkAlertAmberBrush}"
                   TextWrapping="Wrap"
                   ToolTipService.ToolTip="{x:Bind ViewModel.LiveRunWarning, Mode=OneWay}"
                   VerticalAlignment="Center" />
            <Button Grid.Column="1" loc:Loc.Content="Controls.FindingRow.Accept" Command="{x:Bind ViewModel.AcceptLiveRunWarningCommand}"
                    Style="{StaticResource RowAction}" VerticalAlignment="Center"
                    loc:Loc.Tooltip="Controls.FindingRow.Accept.Tooltip" />
        </Grid>
    </Grid>
</UserControl>
