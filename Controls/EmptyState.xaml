<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="BannerlordEnvironmentManager.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The three designed empty states, told apart by color and wording so "found nothing",
         "nothing yet", and "could not look" are never mistaken for each other. Centered in the space
         the list would occupy; the action is the control that would fill it. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="24">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <FontIcon x:Name="KindIcon" FontSize="20" Glyph="&#xE930;" />
            <TextBlock x:Name="TitleText" Style="{StaticResource RowTitleText}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       IsTextSelectionEnabled="True" />
        </StackPanel>
        <TextBlock x:Name="ReasonText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                   TextAlignment="Center" MaxWidth="440" IsTextSelectionEnabled="True" />
        <ContentPresenter x:Name="ActionHost" Content="{x:Bind Action, Mode=OneWay}"
                          HorizontalAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
