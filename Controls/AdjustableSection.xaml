<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="BannerlordEnvironmentManager.Controls.AdjustableSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BannerlordEnvironmentManager.Controls"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization">

    <!-- A section across its parent's whole width that collapses to one line and is dragged to any
         height, remembered between sessions under its SectionKey. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:SectionResizeGrip x:Name="Grip" Height="8" Visibility="Collapsed" />
        <Button x:Name="Toggle" Grid.Row="1" Style="{StaticResource SectionToggle}" Click="OnToggle"
                loc:Loc.Tooltip="Controls.AdjustableSection.Toggle.Tooltip">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="Chevron" Glyph="&#xE76C;" FontSize="12" />
                <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource LabelText}" IsTextSelectionEnabled="False" />
                <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource MetaText}" IsTextSelectionEnabled="False"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <ContentPresenter x:Name="BodyHost" Grid.Row="2" Content="{x:Bind Body, Mode=OneWay}" Visibility="Collapsed"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
