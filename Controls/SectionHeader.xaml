<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="BannerlordEnvironmentManager.Controls.SectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    mc:Ignorable="d">

    <!-- What PageHeader does for a page, for a section inside one. The paragraphs explaining how the
         game's XML merge works, or what a first-chance exception is, are worth having and are not
         worth four lines every time the section is on screen. -->
    <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionText}" VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
        <Button x:Name="WhyButton" loc:Loc.Content="Controls.SectionHeader.Why" Style="{StaticResource Quiet}" VerticalAlignment="Center"
                loc:Loc.Tooltip="Controls.SectionHeader.Why.Tooltip">
            <Button.Flyout>
                <Flyout>
                    <TextBlock x:Name="BlurbText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               MaxWidth="460" IsTextSelectionEnabled="True" />
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
