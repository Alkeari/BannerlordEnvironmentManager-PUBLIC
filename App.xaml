<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="BannerlordEnvironmentManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BannerlordEnvironmentManager"
    xmlns:loc="using:BannerlordEnvironmentManager.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Alkeari Labs LLC brand palette -->
            <Color x:Key="AlkBackground">#000000</Color>
            <Color x:Key="AlkPrimary">#FFDA00</Color>
            <Color x:Key="AlkWarmGoldShadow">#C9A800</Color>
            <Color x:Key="AlkSoftChampagne">#FFF1B3</Color>
            <Color x:Key="AlkSteelGray">#A6A6A6</Color>
            <Color x:Key="AlkDeepGraphite">#1A1A1A</Color>
            <Color x:Key="AlkAlertAmber">#FFB000</Color>
            <Color x:Key="AlkSuccessOliveGold">#8F8B2E</Color>
            <!-- The five hueless neutrals: structural only, never accents. -->
            <Color x:Key="AlkHairline">#333333</Color>
            <Color x:Key="AlkRaised">#2E2E2E</Color>
            <Color x:Key="AlkRaisedHover">#3D3D3D</Color>
            <Color x:Key="AlkDisabledText">#6E6E6E</Color>
            <Color x:Key="AlkMutedText">#8A8A8A</Color>

            <SolidColorBrush x:Key="AlkBackgroundBrush" Color="{StaticResource AlkBackground}" />
            <SolidColorBrush x:Key="AlkPrimaryBrush" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="AlkWarmGoldShadowBrush" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="AlkSoftChampagneBrush" Color="{StaticResource AlkSoftChampagne}" />
            <SolidColorBrush x:Key="AlkSteelGrayBrush" Color="{StaticResource AlkSteelGray}" />
            <SolidColorBrush x:Key="AlkDeepGraphiteBrush" Color="{StaticResource AlkDeepGraphite}" />
            <SolidColorBrush x:Key="AlkAlertAmberBrush" Color="{StaticResource AlkAlertAmber}" />
            <SolidColorBrush x:Key="AlkSuccessOliveGoldBrush" Color="{StaticResource AlkSuccessOliveGold}" />
            <SolidColorBrush x:Key="AlkHairlineColorBrush" Color="{StaticResource AlkHairline}" />
            <SolidColorBrush x:Key="AlkRaisedBrush" Color="{StaticResource AlkRaised}" />
            <SolidColorBrush x:Key="AlkRaisedHoverBrush" Color="{StaticResource AlkRaisedHover}" />
            <SolidColorBrush x:Key="AlkDisabledTextBrush" Color="{StaticResource AlkDisabledText}" />
            <SolidColorBrush x:Key="AlkMutedTextBrush" Color="{StaticResource AlkMutedText}" />

            <!-- CheckBox theme overrides -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource AlkBackground}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource AlkBackground}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource AlkBackground}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AlkWarmGoldShadow}" />

            <!-- The surface ladder. Depth reads from the fill, not from an outline: a gold border on
                 every container is a border color rather than an accent, and on Install Checks there
                 were eleven gold rectangles on one screen.

                 Every value here is an alpha variant of a color already in the palette above, because
                 the palette is fixed and may not be extended. Deep Graphite over Obsidian gives the
                 whole ladder, and Steel Gray at low alpha gives the hairline that replaces the gold. -->
            <SolidColorBrush x:Key="AlkSurfaceBrush" Color="{StaticResource AlkDeepGraphite}" />
            <SolidColorBrush x:Key="AlkSurfaceRaisedBrush" Color="{StaticResource AlkRaised}" />
            <SolidColorBrush x:Key="AlkHairlineBrush" Color="{StaticResource AlkHairline}" />
            <SolidColorBrush x:Key="AlkSelectionBrush" Color="{StaticResource AlkSteelGray}" Opacity="0.10" />

            <!-- Not a palette color and not an accent. A QR code is read by contrast, so the quiet
                 zone behind one has to be white or the code will not scan. It is declared here so no
                 surface writes a literal of its own, and it is used on exactly one Border. -->
            <SolidColorBrush x:Key="AlkQrQuietZoneBrush" Color="#FFFFFF" />

            <!-- Tool UI runs on JetBrains Mono. The stack falls back without apology on a machine
                 that does not have it. ContentControlThemeFontFamily is the key every WinUI control
                 template reads, so overriding it here reaches the controls no page styled. -->
            <FontFamily x:Key="AlkUiFontFamily">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

            <!-- Geometry. Radius 0 everywhere; a pill, a badge or a count chip may use 4. Control
                 height 32 on a 4 px spacing grid. The four vendor keys below carry the radius into
                 every control template BEM never styled, flyouts and list items included. -->
            <CornerRadius x:Key="AlkCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="AlkPillCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="GridViewItemCornerRadius">0</CornerRadius>
            <x:Double x:Key="AlkControlHeight">32</x:Double>

            <!-- Focus is 2 px Forged Gold on every interactive element. FocusVisualPrimaryBrush and
                 FocusVisualSecondaryBrush default from these two keys, so setting them here reaches
                 every control rather than the ones a page remembered. -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource AlkBackground}" />

            <!-- Vendor control brushes, overridden to the palette. Every one of these renders from
                 the Windows theme otherwise, which is how a control nobody styled ends up blue on a
                 gold and black screen. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource AlkBackground}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource AlkBackground}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource AlkRaised}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource AlkHairline}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource AlkSteelGray}" />

            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource AlkHairline}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AlkSoftChampagne}" />

            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource AlkHairline}" />
            <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="ProgressRingBackgroundThemeBrush" Color="{StaticResource AlkHairline}" />

            <!-- Measured, not assumed: a Foreground setter in a Button style never reaches the text.
                 Both buttons in the 2026-09-04 Versions page screenshot painted their labels #FFFFFF
                 while their styles asked for Soft Champagne and Obsidian Black, and Background and
                 CornerRadius from the same styles did apply. The template reads these keys, so these
                 are what a button's text obeys. -->
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AlkSoftChampagne}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AlkSoftChampagne}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource AlkSoftChampagne}" />

            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{StaticResource AlkPrimary}" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{StaticResource AlkWarmGoldShadow}" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{StaticResource AlkWarmGoldShadow}" />

            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource AlkSteelGray}" Opacity="0.10" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource AlkSteelGray}" Opacity="0.22" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource AlkRaisedHover}" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource AlkSoftChampagne}" />

            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource AlkHairline}" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource AlkRaisedHover}" />

            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource AlkDeepGraphite}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AlkPrimary}" />
            <Color x:Key="TextControlSelectionHighlightColor">#FFDA00</Color>
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource AlkDeepGraphite}" />

            <x:Double x:Key="AppFontSize">14</x:Double>
            <x:Double x:Key="HeadingFontSize">20</x:Double>
            <x:Double x:Key="SubHeadingFontSize">16</x:Double>

            <!-- The scale. Five steps and nothing between them: today a heading differs from body text
                 by a little weight and a little color, which establishes no rank at all. -->
            <x:Double x:Key="PageTitleFontSize">24</x:Double>
            <x:Double x:Key="SectionFontSize">16</x:Double>
            <x:Double x:Key="RowTitleFontSize">14</x:Double>
            <x:Double x:Key="MetaFontSize">12</x:Double>
            <x:Double x:Key="MarkFontSize">12</x:Double>

            <Style TargetType="Page">
                <Setter Property="Background" Value="{StaticResource AlkBackgroundBrush}" />
            </Style>

            <!-- Selectable by default, everywhere, because opt-in demonstrably does not work: it left
                 131 of 449 TextBlocks selectable and four whole pages, Settings among them, at zero.
                 Paths, ids, quota figures and error messages exist to be pasted somewhere else, so the
                 default is now selectable and the exception is opting out. Inside a clickable row a
                 selectable TextBlock swallows the pointer, so item templates set it back to False. -->
            <Style x:Key="HeadingText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource AlkPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="SubHeadingText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="FontSize" Value="{StaticResource SubHeadingFontSize}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSteelGrayBrush}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <!-- The rest of the scale. HeadingText stays gold because it is the page's one gold
                 heading; everything below it is Champagne, so gold ranks rather than decorates. -->
            <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource HeadingText}">
                <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}" />
            </Style>

            <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource SubHeadingText}">
                <Setter Property="FontSize" Value="{StaticResource SectionFontSize}" />
            </Style>

            <Style x:Key="RowTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="FontSize" Value="{StaticResource RowTitleFontSize}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="MetaText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="FontSize" Value="{StaticResource MetaFontSize}" />
            </Style>

            <!-- Paths, module ids and counts. They exist to be read against each other and pasted
                 somewhere else, so they get tabular figures and a face that does not re-space them. -->
            <Style x:Key="MonoText" TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, monospace" />
            </Style>

            <!-- A hairline, not gold. Every secondary button on every page carried a gold outline, so a
                 screen with nine buttons had nine gold rectangles and the one action that mattered had
                 no way to stand out. Gold now belongs to PrimaryAction alone. -->
            <Style x:Key="Action" TargetType="Button">
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinHeight" Value="{StaticResource AlkControlHeight}" />
                <Setter Property="CornerRadius" Value="{StaticResource AlkCornerRadius}" />
                <Setter Property="Background" Value="{StaticResource AlkSurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- Forged Gold fill, so the label is Obsidian Black and never white. The ContentTemplate
                 paints it: a Foreground setter on the button is dropped by the template, and light text
                 on a gold fill is the exact defect the workspace contrast rule names. -->
            <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Background" Value="{StaticResource AlkPrimaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkWarmGoldShadowBrush}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="{ThemeResource AlkUiFontFamily}"
                                       FontSize="{StaticResource AppFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AlkBackgroundBrush}"
                                       IsTextSelectionEnabled="False" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource Action}">
                <Setter Property="Background" Value="{StaticResource AlkAlertAmberBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkBackgroundBrush}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="{ThemeResource AlkUiFontFamily}"
                                       FontSize="{StaticResource AppFontSize}"
                                       Foreground="{StaticResource AlkBackgroundBrush}"
                                       IsTextSelectionEnabled="False" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- For a control that must be reachable and must not compete: the Why? beside a page
                 title, an overflow affordance. No fill and no outline, so it reads as a link rather
                 than as one more button in a row of them. -->
            <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Action}">
                <Setter Property="FontSize" Value="{StaticResource MetaFontSize}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource AlkSteelGrayBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- Implicit, so it reaches the controls nobody remembered to style. A CheckBox left to the
                 Windows default sat beside branded buttons at a different height, a different text
                 color and 120 px of dead minimum width, which is what made Fetch Fresh and Rebuild
                 Every Mod ID read as bolted on. Opting in demonstrably does not work: the keyed style
                 below has existed for months and most call sites never referenced it. -->
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="{StaticResource AlkControlHeight}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,0,0,0" />
            </Style>

            <Style x:Key="AlkCheckBox" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />

            <!-- One styled control set, keyed so a page can name what it means. The implicit styles
                 below wrap the same keys so nothing ever renders from the Windows default. -->
            <Style x:Key="AlkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource AlkSurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AlkCornerRadius}" />
                <Setter Property="MinHeight" Value="{StaticResource AlkControlHeight}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource AlkTextBox}" />

            <Style x:Key="AlkComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource AlkSurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AlkCornerRadius}" />
                <Setter Property="MinHeight" Value="{StaticResource AlkControlHeight}" />
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource AlkComboBox}" />

            <Style x:Key="AlkDropDownButton" TargetType="DropDownButton">
                <Setter Property="Background" Value="{StaticResource AlkSurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AlkCornerRadius}" />
                <Setter Property="MinHeight" Value="{StaticResource AlkControlHeight}" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            </Style>

            <Style TargetType="DropDownButton" BasedOn="{StaticResource AlkDropDownButton}" />

            <Style x:Key="AlkNumberBox" TargetType="NumberBox">
                <Setter Property="Background" Value="{StaticResource AlkSurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AlkCornerRadius}" />
                <Setter Property="MinHeight" Value="{StaticResource AlkControlHeight}" />
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
            </Style>

            <Style TargetType="NumberBox" BasedOn="{StaticResource AlkNumberBox}" />

            <Style x:Key="AlkToggle" TargetType="ToggleSwitch">
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource AlkToggle}" />

            <Style x:Key="AlkExpander" TargetType="Expander">
                <Setter Property="Background" Value="{StaticResource AlkSurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSoftChampagneBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AlkCornerRadius}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style TargetType="Expander" BasedOn="{StaticResource AlkExpander}" />

            <!-- A mark on a row. Three kinds and no more: amber is something to do, olive-gold is
                 checked and clear, steel gray is identity and never competes for the eye. A row with
                 no amber on it needs no reading, which is the whole point of having them. -->
            <Style x:Key="Mark" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AlkSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlkHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AlkPillCornerRadius}" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MarkText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AlkUiFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource AlkSteelGrayBrush}" />
                <Setter Property="FontSize" Value="{StaticResource MarkFontSize}" />
                <Setter Property="IsTextSelectionEnabled" Value="False" />
            </Style>

            <Style x:Key="MarkActionText" TargetType="TextBlock" BasedOn="{StaticResource MarkText}">
                <Setter Property="Foreground" Value="{StaticResource AlkAlertAmberBrush}" />
            </Style>

            <Style x:Key="MarkClearText" TargetType="TextBlock" BasedOn="{StaticResource MarkText}">
                <Setter Property="Foreground" Value="{StaticResource AlkSuccessOliveGoldBrush}" />
            </Style>
            <!-- One candidate mod page for one module, with the sentence it was proposed on. Lives here
                 rather than on a page because two tabs now ask the same question: Install asks it about
                 an archive, Environment asks it about a module with no mod page. -->
            <!-- Classic Binding rather than x:Bind: a resource dictionary on Application has no code
                 behind for a compiled binding to connect to, and x:Bind here fails the markup compiler
                 with no message at all. -->
            <DataTemplate x:Key="NexusIdProposalRow">
                <StackPanel Spacing="2" Margin="0,4,0,4">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Headline}"
                              loc:Loc.Tooltip="Environment.NexusIdProposalRow.MatchCheckBox.Tooltip" />
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Margin="30,0,0,0" IsTextSelectionEnabled="True" />
                    <CheckBox IsChecked="{Binding IsRejected, Mode=TwoWay}" loc:Loc.Content="Environment.NexusIdProposalRow.RejectCheckBox" Margin="26,0,0,0"
                              loc:Loc.Tooltip="Environment.NexusIdProposalRow.RejectCheckBox.Tooltip" />
                    <HyperlinkButton Content="{Binding ModPageUrl}" NavigateUri="{Binding ModPageUrl}" Margin="26,0,0,0"
                                     loc:Loc.Tooltip="Environment.NexusIdProposalRow.ModPageLink.Tooltip" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
